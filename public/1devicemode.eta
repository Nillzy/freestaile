<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreestAIle - Multiplayer Mode</title>
    <!-- Dark mode initialization script - must be at the top to prevent flicker -->
    <script src="darkmode-init.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Ubuntu:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles/landing-page.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Basis-Styles für alle Buttons */
        .auth-button {
            position: relative;
            margin: auto;
            padding: 12px 18px;
            transition: all 0.2s ease;
            border: none;
            background: none;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

        .auth-button:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            display: block;
            border-radius: 50px;
            width: 45px;
            height: 45px;
            transition: all 0.3s ease;
        }

        .auth-button span {
            position: relative;
            font-family: "Ubuntu", sans-serif;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: #234567;
        }

        .auth-button svg {
            position: relative;
            top: 0;
            margin-left: 10px;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke: #234567;
            stroke-width: 2;
            transform: translateX(-5px);
            transition: all 0.3s ease;
        }

        .auth-button:hover:before {
            width: 100%;
        }

        .auth-button:hover svg {
            transform: translateX(0);
        }

        .auth-button:active {
            transform: scale(0.95);
        }

        /* Spezifische Styles für Login (blau) */
        .auth-button-login:before {
            background: #b1dae7;
        }
        .auth-button-login:hover:before {
            background: #b1dae7;
        }

        /* Spezifische Styles für Register (grün) */
        .auth-button-register:before {
            background: #b1e7c8;
        }
        .auth-button-register:hover:before {
            background: #b1e7c8;
        }

        /* Spezifische Styles für Logout (rot) */
        .auth-button-logout {
            position: relative;
            margin: auto;
            padding: 12px 18px;
            transition: all 0.2s ease;
            border: none;
            background: none;
            cursor: pointer;
        }

        .auth-button-logout:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            display: block;
            border-radius: 50px;
            background: #e7b1b1;
            width: 45px;
            height: 45px;
            transition: all 0.3s ease;
        }

        .auth-button-logout span {
            position: relative;
            font-family: "Ubuntu", sans-serif;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: #234567;
        }

        .auth-button-logout svg {
            position: relative;
            top: 0;
            margin-left: 10px;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke: #234567;
            stroke-width: 2;
            transform: translateX(-5px);
            transition: all 0.3s ease;
        }

        .auth-button-logout:hover:before {
            width: 100%;
            background: #e7b1b1;
        }

        .auth-button-logout:hover svg {
            transform: translateX(0);
        }

        .auth-button-logout:active {
            transform: scale(0.95);
        }

        .profile-container {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-right: 1rem;
        }

        .profile-circle {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: #b1dae7;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Ubuntu", sans-serif;
            font-size: 20px;
            font-weight: 700;
            color: #234567;
            transition: all 0.3s ease;
            flex-shrink: 0;
        }

        /* Apply dark mode styles to profile circle immediately with class on html element */
        html.darkmode .profile-circle {
            background: #3d3d3d;
            color: #ffffff;
        }

        .profile-email {
            font-family: "Ubuntu", sans-serif;
            font-size: 16px;
            color: #234567;
            white-space: nowrap;
        }

        html.darkmode .profile-email {
            color: #ffffff;
        }

        .profile-circle:hover {
            background: #9bc8d7;
            transform: scale(1.05);
        }

        body.darkmode .profile-circle {
            background: #3d3d3d;
            color: #ffffff;
        }

        body.darkmode .profile-email {
            color: #ffffff;
        }

        .auth-buttons {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        /* Multiplayer-spezifische Styles */
        .player-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .player-card {
            background: #ffffff;
            border-radius: 10px;
            padding: 1.5rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
        }

        .player-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }

        .player-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .player-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #b1dae7;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Ubuntu", sans-serif;
            font-size: 24px;
            font-weight: 700;
            color: #234567;
        }

        .player-info {
            flex: 1;
        }

        .player-name {
            font-family: "Ubuntu", sans-serif;
            font-size: 18px;
            font-weight: 700;
            color: #234567;
            margin: 0;
        }

        .player-topic {
            font-family: "Inter", sans-serif;
            font-size: 14px;
            color: #666;
            margin-top: 0.25rem;
        }

        .player-input {
            margin-top: 1rem;
        }

        .player-input input {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #e2e8f0;
            border-radius: 5px;
            font-family: "Inter", sans-serif;
            font-size: 16px;
            transition: border-color 0.3s ease;
        }

        .player-input input:focus {
            outline: none;
            border-color: #b1dae7;
        }

        .player-actions {
            display: flex;
            gap: 0.5rem;
            margin-top: 1rem;
        }

        .player-actions button {
            padding: 0.4rem 0.6rem;
            border: none;
            border-radius: 4px;
            font-family: "Ubuntu", sans-serif;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.3rem;
            min-width: 40px;
            height: 32px;
        }

        .ready-button {
            position: relative;
            margin: auto;
            padding: 8px 16px;
            transition: all 0.2s ease;
            border: none;
            background: none;
            cursor: pointer;
            min-width: 60px;
            height: 32px;
        }

        .ready-button:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            display: block;
            border-radius: 50px;
            background: #b1e7c8;
            width: 45px;
            height: 32px;
            transition: all 0.3s ease;
        }

        .ready-button span {
            position: relative;
            font-family: "Ubuntu", sans-serif;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: #234567;
        }

        .ready-button svg {
            position: relative;
            top: 0;
            margin-left: 10px;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke: #234567;
            stroke-width: 2;
            transform: translateX(-5px);
            transition: all 0.3s ease;
        }

        .ready-button:hover:before {
            width: 100%;
            background: #b1e7c8;
        }

        .ready-button:hover svg {
            transform: translateX(0);
        }

        .ready-button:active {
            transform: scale(0.95);
        }

        .ready-button.ready {
            cursor: default;
        }

        .ready-button.ready:before {
            width: 100%;
            background: #b1e7c8;
        }

        .ready-button.ready svg {
            transform: translateX(0);
        }

        /* Darkmode Styles */
        body.darkmode .ready-button span {
            color: #ffffff;
        }

        body.darkmode .ready-button:before {
            background: #2d5a3f;
        }

        body.darkmode .ready-button.ready:before {
            background: #2d5a3f;
        }

        body.darkmode .ready-button svg {
            stroke: #ffffff;
        }

        /* Neuer Löschen-Button Style */
        .delete-button {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background-color: #e2e8f0;
            border: none;
            font-weight: 600;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
            cursor: pointer;
            transition-duration: 0.3s;
            overflow: hidden;
            position: relative;
            gap: 1px;
            padding: 0;
        }

        .delete-button .svgIcon {
            width: 12px;
            transition-duration: 0.3s;
        }

        .delete-button .svgIcon path {
            fill: #234567;
        }

        .delete-button:hover {
            background-color: #e7b1b1;
        }

        .delete-button:hover .bin-bottom {
            width: 12px;
            transition-duration: 0.3s;
            transform: translateY(60%);
        }

        .delete-button .bin-top {
            transform-origin: bottom right;
        }

        .delete-button:hover .bin-top {
            width: 12px;
            transition-duration: 0.3s;
            transform: translateY(60%) rotate(160deg);
        }

        /* Darkmode Styles */
        body.darkmode .delete-button {
            background: #4d4d4d;
        }

        body.darkmode .delete-button .svgIcon path {
            fill: #ffffff;
        }

        body.darkmode .delete-button:hover {
            background: #e7b1b1;
        }

        .start-game-button {
            width: 100%;
            padding: 1rem;
            margin-top: 2rem;
            background: #b1dae7;
            color: #234567;
            border: none;
            border-radius: 5px;
            font-family: "Ubuntu", sans-serif;
            font-size: 18px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .start-game-button:hover {
            background: #9bc8d7;
        }

        .start-game-button:disabled {
            background: #f0f0f0;
            color: #999;
            cursor: not-allowed;
        }

        /* Darkmode Styles */
        body.darkmode .player-card {
            background: #2d2d2d;
        }

        body.darkmode .player-name {
            color: #ffffff;
        }

        body.darkmode .player-topic {
            color: #a0aec0;
        }

        body.darkmode .player-input input {
            background: #3d3d3d;
            border-color: #4d4d4d;
            color: #ffffff;
        }

        body.darkmode .player-input input:focus {
            border-color: #b1dae7;
        }

        body.darkmode .status-waiting {
            background: #3d3d3d;
            color: #a0aec0;
        }

        body.darkmode .start-game-button:disabled {
            background: #3d3d3d;
            color: #666;
        }

        /* Modal Styles */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(5px);
            z-index: 1000;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .modal-overlay.active {
            display: flex;
            opacity: 1;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background: #ffffff;
            border-radius: 15px;
            padding: 2rem;
            width: 90%;
            max-width: 400px;
            position: relative;
            transform: translateY(-20px);
            transition: transform 0.3s ease;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        }

        .modal-overlay.active .modal-content {
            transform: translateY(0);
        }

        .modal-close {
            position: absolute;
            top: 0;
            right: 0.5rem;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: #666;
            cursor: pointer;
            padding: 0.5rem;
            line-height: 1;
            transition: color 0.2s ease;
        }

        .modal-close:hover {
            color: #234567;
        }

        .modal-tabs {
            display: flex;
            gap: 1rem;
            margin-bottom: 1.5rem;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 0.5rem;
        }

        .modal-tab {
            padding: 0.5rem 1rem;
            font-family: "Ubuntu", sans-serif;
            font-size: 16px;
            font-weight: 600;
            color: #666;
            cursor: pointer;
            transition: all 0.2s ease;
            border: none;
            background: none;
            position: relative;
        }

        .modal-tab.active {
            color: #234567;
        }

        .modal-tab.active::after {
            content: '';
            position: absolute;
            bottom: -0.5rem;
            left: 0;
            width: 100%;
            height: 2px;
            background: #234567;
        }

        .modal-form {
            display: none;
        }

        .modal-form.active {
            display: block;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            font-family: "Inter", sans-serif;
            font-size: 14px;
            font-weight: 500;
            color: #234567;
            margin-bottom: 0.5rem;
        }

        .form-group input {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-family: "Inter", sans-serif;
            font-size: 16px;
            transition: all 0.2s ease;
            background: #f8fafc;
        }

        .form-group input:focus {
            outline: none;
            border-color: #b1dae7;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(177, 218, 231, 0.2);
        }

        .modal-submit {
            width: 100%;
            padding: 0.75rem;
            background: #b1dae7;
            color: #234567;
            border: none;
            border-radius: 8px;
            font-family: "Ubuntu", sans-serif;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-top: 1rem;
        }

        .modal-submit:hover {
            background: #9bc8d7;
            transform: translateY(-1px);
        }

        .modal-submit:active {
            transform: translateY(0);
        }

        .error-message {
            color: #e53e3e;
            font-family: "Inter", sans-serif;
            font-size: 14px;
            margin-top: 0.5rem;
            display: none;
        }

        .error-message.active {
            display: block;
        }

        /* Dark Mode Styles für Modal */
        body.darkmode .modal-content {
            background: #2d2d2d;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
        }

        body.darkmode .modal-close {
            color: #a0aec0;
        }

        body.darkmode .modal-close:hover {
            color: #ffffff;
        }

        body.darkmode .modal-tab {
            color: #a0aec0;
        }

        body.darkmode .modal-tab.active {
            color: #ffffff;
        }

        body.darkmode .modal-tab.active::after {
            background: #b1dae7;
        }

        body.darkmode .modal-tabs {
            border-bottom-color: #4d4d4d;
        }

        body.darkmode .form-group label {
            color: #ffffff;
        }

        body.darkmode .form-group input {
            background: #3d3d3d;
            border-color: #4d4d4d;
            color: #ffffff;
        }

        body.darkmode .form-group input:focus {
            border-color: #b1dae7;
            background: #2d2d2d;
        }

        body.darkmode .modal-submit {
            background: #b1dae7;
            color: #234567;
        }

        body.darkmode .modal-submit:hover {
            background: #9bc8d7;
        }

        body.darkmode .error-message {
            color: #fc8181;
        }

        .add-player-card {
            background: #ffffff;
            border-radius: 10px;
            padding: 1.5rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            height: 100%;
            min-height: 150px;
            grid-column: auto;
        }

        .add-player-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }

        .add-player-card .plus-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #b1e7c8;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: #234567;
            transition: all 0.3s ease;
            position: relative;
        }

        .add-player-card .plus-icon i {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            margin: 0;
            padding: 0;
            line-height: 1;
        }

        .add-player-card:hover .plus-icon {
            transform: scale(1.1);
            background: #9bd7b8;
        }

        /* Darkmode Styles */
        body.darkmode .add-player-card {
            background: #2d2d2d;
        }

        body.darkmode .add-player-card .plus-icon {
            background: #2d5a3f;
            color: #ffffff;
        }

        body.darkmode .add-player-card:hover .plus-icon {
            background: #3d6a4f;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }

        .player-input input.error {
            border-color: #e53e3e;
            /* animation: shake 0.5s ease-in-out; entfernt */
        }

        body.darkmode .player-input input.error {
            border-color: #fc8181;
        }

        @keyframes duplicate-shake {
            0%, 100% { transform: translateX(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
            20%, 40%, 60%, 80% { transform: translateX(5px); }
        }

        .player-input input.duplicate-error {
            border-color: #e53e3e;
            /* animation: duplicate-shake 0.8s ease-in-out; entfernt */
        }

        body.darkmode .player-input input.duplicate-error {
            border-color: #fc8181;
        }

        /* Füge die shake-Animation für .shake hinzu */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }
        .player-input input.shake {
            animation: shake 0.5s ease-in-out;
        }

        /* CSS für den Switch */
        .random-switch-label {
            user-select: none;
        }
        .random-switch {
            width: 32px;
            height: 18px;
            appearance: none;
            background: #b1dae7;
            outline: none;
            border-radius: 18px;
            position: relative;
            transition: background 0.3s;
            cursor: pointer;
        }
        .random-switch:checked {
            background: #b1e7c8;
        }
        .random-switch::before {
            content: '';
            position: absolute;
            left: 2px;
            top: 2px;
            width: 14px;
            height: 14px;
            background: #fff;
            border-radius: 50%;
            transition: transform 0.3s;
            box-shadow: 0 1px 4px rgba(0,0,0,0.15);
        }
        .random-switch:checked::before {
            transform: translateX(14px);
        }
    </style>
</head>

<header class="main-header">
    <div class="header-content">
        <a href="/" style="text-decoration: none; color: inherit;">
            <span class="header-logo">Freest<b>AI</b>le</span>
        </a>
        <div class="flex items-center space-x-4">
            <% if (it.user) { %>
            <!-- Eingeloggter Benutzer -->
            <div class="profile-container">
                <a href="/user" style="text-decoration: none;">
                    <div class="profile-circle">
                        <%= it.user.email.charAt(0).toUpperCase() %>
                    </div>
                </a>
                <div class="profile-email"><%= it.user.email %></div>
                <a href="#" class="auth-button auth-button-logout" onclick="(async function(e) { e.preventDefault(); try { const response = await fetch('/api/auth/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' } }); if (response.ok) window.location.reload(); } catch (error) { console.error('Logout-Fehler:', error); } })(event)">
                    <span>Abmelden</span>
                    <svg width="15px" height="10px" viewBox="0 0 13 10">
                        <path d="M1,5 L11,5"></path>
                        <polyline points="8 1 12 5 8 9"></polyline>
                    </svg>
                </a>
            </div>
            <% } else { %>
            <!-- Nicht eingeloggter Benutzer -->
            <div class="auth-buttons">
                <a href="#" class="auth-button auth-button-login" onclick="openAuthModal('login'); return false;">
                    <span>Anmelden</span>
                    <svg width="15px" height="10px" viewBox="0 0 13 10">
                        <path d="M1,5 L11,5"></path>
                        <polyline points="8 1 12 5 8 9"></polyline>
                    </svg>
                </a>
                <a href="#" class="auth-button auth-button-register" onclick="openAuthModal('register'); return false;">
                    <span>Registrieren</span>
                    <svg width="15px" height="10px" viewBox="0 0 13 10">
                        <path d="M1,5 L11,5"></path>
                        <polyline points="8 1 12 5 8 9"></polyline>
                    </svg>
                </a>
            </div>
            <% } %>
            <label class="switch">
                <input id="darkmode-toggle" type="checkbox" />
                <span class="slider">
                    <div class="star star_1"></div>
                    <div class="star star_2"></div>
                    <div class="star star_3"></div>
                    <svg viewBox="0 0 16 16" class="cloud_1 cloud">
                        <path
                                transform="matrix(.77976 0 0 .78395-299.99-418.63)"
                                fill="#fff"
                                d="m391.84 540.91c-.421-.329-.949-.524-1.523-.524-1.351 0-2.451 1.084-2.485 2.435-1.395.526-2.388 1.88-2.388 3.466 0 1.874 1.385 3.423 3.182 3.667v.034h12.73v-.006c1.775-.104 3.182-1.584 3.182-3.395 0-1.747-1.309-3.186-2.994-3.379.007-.106.011-.214.011-.322 0-2.707-2.271-4.901-5.072-4.901-2.073 0-3.856 1.202-4.643 2.925"
                        ></path>
                    </svg>
                </span>
            </label>
        </div>
    </div>
</header>

<body>
<div class="container-wrapper">
    <div class="container">
        <div class="header">
            <h1 class="logo"><b>1-DEVICE</b>-Mode</h1>
            <p class="tagline">Spielt PowerPoint-Karaoke im Multiplayer mit nur einem Gerät!</p>
        </div>

        <div class="player-grid" id="playerGrid">
            <!-- Spieler-Karten werden hier dynamisch eingefügt -->
            <div id="addPlayerCard" class="add-player-card" onclick="addPlayer()" style="display: none;">
                <div class="plus-icon">
                    <i class="fas fa-plus"></i>
                </div>
            </div>
        </div>

        <button id="startGameButton" class="start-game-button" disabled>
            Spiel starten
        </button>
    </div>
</div>

<!-- Modal HTML nach dem container-wrapper div -->
<div class="modal-overlay" id="authModal">
    <div class="modal-content">
        <button class="modal-close" onclick="closeAuthModal()">&times;</button>
        <div class="modal-tabs">
            <button class="modal-tab active" onclick="switchTab('login')">Anmelden</button>
            <button class="modal-tab" onclick="switchTab('register')">Registrieren</button>
        </div>
        <form id="loginForm" class="modal-form active" onsubmit="handleModalLogin(event)">
            <div class="form-group">
                <label for="loginEmail">E-Mail</label>
                <input type="email" id="loginEmail" name="email" required>
            </div>
            <div class="form-group">
                <label for="loginPassword">Passwort</label>
                <input type="password" id="loginPassword" name="password" required>
            </div>
            <div class="error-message" id="loginError"></div>
            <button type="submit" class="modal-submit">Anmelden</button>
        </form>
        <form id="registerForm" class="modal-form" onsubmit="handleModalRegister(event)">
            <div class="form-group">
                <label for="registerEmail">E-Mail</label>
                <input type="email" id="registerEmail" name="email" required>
            </div>
            <div class="form-group">
                <label for="registerPassword">Passwort</label>
                <input type="password" id="registerPassword" name="password" required>
            </div>
            <div class="form-group">
                <label for="confirmPassword">Passwort bestätigen</label>
                <input type="password" id="confirmPassword" name="confirmPassword" required>
            </div>
            <div class="error-message" id="registerError"></div>
            <button type="submit" class="modal-submit">Registrieren</button>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const toggle = document.getElementById('darkmode-toggle');

        // Get current dark mode status (already set by darkmode-init.js)
        const isDark = document.documentElement.classList.contains('darkmode');

        // Set toggle position based on current dark mode status
        toggle.checked = !isDark;

        // Ensure body also has the class for backward compatibility
        document.body.classList.toggle('darkmode', isDark);

        toggle.addEventListener('change', function() {
            const dark = !toggle.checked;
            document.documentElement.classList.toggle('darkmode', dark);
            document.body.classList.toggle('darkmode', dark);
            localStorage.setItem('darkmode', dark.toString());
        });

        // Initial einen Spieler hinzufügen (den Host)
        addPlayer(true);
    });

    let playerCount = 0;
    const maxPlayers = 7;
    const minPlayers = 1;

    function addPlayer(isHost = false) {
        if (playerCount >= maxPlayers) {
            return;
        }

        const playerGrid = document.getElementById('playerGrid');
        const playerCard = document.createElement('div');
        playerCard.className = 'player-card';
        playerCard.innerHTML = `
            <div class="player-header">
                <div class="player-avatar">
                    ?
                </div>
                <div class="player-info">
                    <div class="player-input" style="margin-top: 0;">
                        <input type="text" placeholder="Nutzername" required class="player-name-input" oninput="updateAvatar(this)">
                    </div>
                </div>
            </div>
            <div class="player-input player-topic-row" style="display: flex; align-items: center; gap: 0.5rem;">
                <input type="text" placeholder="Präsentationsthema eingeben" required class="topic-input" maxlength="50">
                <label class="random-switch-label" style="display: flex; align-items: center; gap: 0.3rem; cursor: pointer;">
                    <input type="checkbox" class="random-switch" onchange="toggleRandomTopic(this)">
                    <span style="font-size: 13px; font-family: Ubuntu, sans-serif;">Random Topic</span>
                </label>
            </div>
            <div class="error-message topic-error" style="display:none;"></div>
            <div class="player-actions">
                <button class="delete-button" onclick="removePlayer(this)">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 69 14" class="svgIcon bin-top">
                        <g clip-path="url(#clip0_35_24)">
                            <path fill="currentColor" d="M20.8232 2.62734L19.9948 4.21304C19.8224 4.54309 19.4808 4.75 19.1085 4.75H4.92857C2.20246 4.75 0 6.87266 0 9.5C0 12.1273 2.20246 14.25 4.92857 14.25H64.0714C66.7975 14.25 69 12.1273 69 9.5C69 6.87266 66.7975 4.75 64.0714 4.75H49.8915C49.5192 4.75 49.1776 4.54309 49.0052 4.21305L48.1768 2.62734C47.3451 1.00938 45.6355 0 43.7719 0H25.2281C23.3645 0 21.6549 1.00938 20.8232 2.62734ZM64.0023 20.0648C64.0397 19.4882 63.5822 19 63.0044 19H5.99556C5.4178 19 4.96025 19.4882 4.99766 20.0648L8.19375 69.3203C8.44018 73.0758 11.6746 76 15.5712 76H53.4288C57.3254 76 60.5598 73.0758 60.8062 69.3203L64.0023 20.0648Z"></path>
                        </g>
                        <defs>
                            <clipPath id="clip0_35_24">
                                <rect fill="white" height="14" width="69"></rect>
                            </clipPath>
                        </defs>
                    </svg>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 69 57" class="svgIcon bin-bottom">
                        <g clip-path="url(#clip0_35_22)">
                            <path fill="currentColor" d="M20.8232 -16.3727L19.9948 -14.787C19.8224 -14.4569 19.4808 -14.25 19.1085 -14.25H4.92857C2.20246 -14.25 0 -12.1273 0 -9.5C0 -6.8727 2.20246 -4.75 4.92857 -4.75H64.0714C66.7975 -4.75 69 -6.8727 69 -9.5C69 -12.1273 66.7975 -14.25 64.0714 -14.25H49.8915C49.5192 -14.25 49.1776 -14.4569 49.0052 -14.787L48.1768 -16.3727C47.3451 -17.9906 45.6355 -19 43.7719 -19H25.2281C23.3645 -19 21.6549 -17.9906 20.8232 -16.3727ZM64.0023 1.0648C64.0397 0.4882 63.5822 0 63.0044 0H5.99556C5.4178 0 4.96025 0.4882 4.99766 1.0648L8.19375 50.3203C8.44018 54.0758 11.6746 57 15.5712 57H53.4288C57.3254 57 60.5598 54.0758 60.8062 50.3203L64.0023 1.0648Z"></path>
                        </g>
                        <defs>
                            <clipPath id="clip0_35_22">
                                <rect fill="white" height="57" width="69"></rect>
                            </clipPath>
                        </defs>
                    </svg>
                </button>
            </div>
        `;

        playerGrid.appendChild(playerCard);
        playerCount++;
        updateStartButton();
        updateAddPlayerCard();
    }

    function updateAvatar(input) {
        const playerCard = input.closest('.player-card');
        const avatar = playerCard.querySelector('.player-avatar');
        const name = input.value.trim();
        avatar.textContent = name ? name.charAt(0).toUpperCase() : '?';
    }

    function removePlayer(button) {
        const playerCard = button.closest('.player-card');
        playerCard.remove();
        playerCount--;
        updateStartButton();
        updateAddPlayerCard();
    }

    function updateStartButton() {
        const startButton = document.getElementById('startGameButton');
        // Button ist nur deaktiviert, wenn keine Spieler vorhanden sind
        startButton.disabled = playerCount < minPlayers;
    }

    function updateAddPlayerCard() {
        const addPlayerCard = document.getElementById('addPlayerCard');
        if (playerCount < maxPlayers) {
            addPlayerCard.style.display = 'flex';
        } else {
            addPlayerCard.style.display = 'none';
        }
    }

    // Event Listener für den Start-Button
    document.getElementById('startGameButton').addEventListener('click', async function() {
        let hasError = false;
        const allNameInputs = document.querySelectorAll('.player-name-input');
        const allTopicRows = document.querySelectorAll('.player-topic-row');
        let names = [];
        let topics = [];

        allNameInputs.forEach(input => {
            const value = input.value.trim();
            if (!value) {
                input.classList.remove('shake');
                void input.offsetWidth;
                input.classList.add('error', 'shake');
                hasError = true;
            } else {
                input.classList.remove('error');
            }
            names.push(value);
        });
        allTopicRows.forEach(row => {
            const topicInput = row.querySelector('.topic-input');
            const randomSwitch = row.querySelector('.random-switch');
            const errorDiv = row.parentElement.querySelector('.topic-error');
            if (!randomSwitch.checked) {
                const value = topicInput.value.trim();
                if (value.length < 3 || value.length > 50) {
                    topicInput.classList.remove('shake');
                    void topicInput.offsetWidth;
                    topicInput.classList.add('error', 'shake');
                    errorDiv.textContent = 'Topic must be between 3 and 50 characters.';
                    errorDiv.style.display = 'block';
                    hasError = true;
                } else {
                    topicInput.classList.remove('error');
                    errorDiv.style.display = 'none';
                }
                topics.push(value);
            } else {
                topicInput.classList.remove('error');
                if (errorDiv) errorDiv.style.display = 'none';
                topics.push('//RANDOM//');
            }
        });
        // Prüfe auf doppelte Namen
        const nameCount = {};
        names.forEach(name => {
            if (name) {
                nameCount[name] = (nameCount[name] || 0) + 1;
            }
        });
        names.forEach((name, idx) => {
            if (name && nameCount[name] > 1) {
                allNameInputs[idx].classList.remove('shake');
                void allNameInputs[idx].offsetWidth;
                allNameInputs[idx].classList.add('duplicate-error', 'shake');
                hasError = true;
            } else {
                allNameInputs[idx].classList.remove('duplicate-error');
            }
        });
        setTimeout(() => {
            document.querySelectorAll('.shake').forEach(el => el.classList.remove('shake'));
        }, 600);
        if (hasError) {
            return;
        }
        // Präsentationen zusammenstellen:
        const presentations = Array.from(document.querySelectorAll('.player-card')).map(card => {
            const nameInput = card.querySelector('.player-name-input');
            const topicRow = card.querySelector('.player-topic-row');
            const topicInput = topicRow.querySelector('.topic-input');
            const randomSwitch = topicRow.querySelector('.random-switch');
            return {
                player: nameInput.value,
                topic: randomSwitch.checked ? '//RANDOM//' : topicInput.value
            };
        });
        try {
            const response = await fetch('/initiateGeneration', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    presentations,
                    user: { id: '<%= it.user.id %>' },
                    gameMode: 1 // Game-Mode 1 => 1-Device-Mode
                })
            });
            const data = await response.json();
            if (response.ok && data && data.url) {
                window.location.href = data.url;
            } else {
                console.error('Fehler bei der Generierung:', data.error || 'Unbekannter Fehler');
            }
        } catch (error) {
            console.error('Fehler beim Senden der Anfrage:', error);
        }
    });

    // Modal Funktionen
    function openAuthModal(tab) {
        const modal = document.getElementById('authModal');
        modal.classList.add('active');
        switchTab(tab);
        document.body.style.overflow = 'hidden';
    }

    function closeAuthModal() {
        const modal = document.getElementById('authModal');
        modal.classList.remove('active');
        document.body.style.overflow = '';
        // Formulare zurücksetzen
        document.getElementById('loginForm').reset();
        document.getElementById('registerForm').reset();
        document.getElementById('loginError').classList.remove('active');
        document.getElementById('registerError').classList.remove('active');
    }

    function switchTab(tab) {
        const tabs = document.querySelectorAll('.modal-tab');
        const forms = document.querySelectorAll('.modal-form');

        tabs.forEach(t => t.classList.remove('active'));
        forms.forEach(f => f.classList.remove('active'));

        document.querySelector(`.modal-tab[onclick="switchTab('${tab}')"]`).classList.add('active');
        document.getElementById(`${tab}Form`).classList.add('active');
    }

    async function handleModalLogin(event) {
        event.preventDefault();
        const email = document.getElementById('loginEmail').value;
        const password = document.getElementById('loginPassword').value;
        const errorElement = document.getElementById('loginError');

        try {
            const response = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            });

            if (response.ok) {
                window.location.reload();
            } else {
                const data = await response.json();
                errorElement.textContent = data.message || 'Anmeldung fehlgeschlagen';
                errorElement.classList.add('active');
            }
        } catch (error) {
            errorElement.textContent = 'Ein Fehler ist aufgetreten';
            errorElement.classList.add('active');
        }
    }

    async function handleModalRegister(event) {
        event.preventDefault();
        const email = document.getElementById('registerEmail').value;
        const password = document.getElementById('registerPassword').value;
        const confirmPassword = document.getElementById('confirmPassword').value;
        const errorElement = document.getElementById('registerError');

        if (password !== confirmPassword) {
            errorElement.textContent = 'Die Passwörter stimmen nicht überein';
            errorElement.classList.add('active');
            return;
        }

        try {
            const response = await fetch('/api/auth/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            });

            if (response.ok) {
                // Nach erfolgreicher Registrierung zum Login-Tab wechseln
                switchTab('login');
                document.getElementById('loginEmail').value = email;
                errorElement.classList.remove('active');
            } else {
                const data = await response.json();
                errorElement.textContent = data.message || 'Registrierung fehlgeschlagen';
                errorElement.classList.add('active');
            }
        } catch (error) {
            errorElement.textContent = 'Ein Fehler ist aufgetreten';
            errorElement.classList.add('active');
        }
    }

    // Schließen des Modals bei Klick außerhalb oder Escape-Taste
    document.addEventListener('click', function(event) {
        const modal = document.getElementById('authModal');
        if (event.target === modal) {
            closeAuthModal();
        }
    });

    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeAuthModal();
        }
    });

    // Event Listener für Input-Felder, um Fehler-Status zu entfernen
    document.addEventListener('input', function(e) {
        if (e.target.classList.contains('player-name-input') || (e.target.closest('.player-input') && e.target.placeholder === 'Präsentationsthema eingeben')) {
            updateStartButton();
        }
        if (e.target.classList.contains('topic-input')) {
            const row = e.target.closest('.player-topic-row');
            const randomSwitch = row.querySelector('.random-switch');
            const errorDiv = row.parentElement.querySelector('.topic-error');
            if (!randomSwitch.checked) {
                const value = e.target.value.trim();
                if (value.length >= 3 && value.length <= 50) {
                    errorDiv.style.display = 'none';
                    e.target.classList.remove('error');
                }
            } else {
                errorDiv.style.display = 'none';
                e.target.classList.remove('error');
            }
        }
        if (e.target.classList.contains('error') || e.target.classList.contains('duplicate-error')) {
            e.target.classList.remove('error', 'duplicate-error');
            // Entferne auch die duplicate-error Klasse von anderen Feldern
            const allInputs = document.querySelectorAll('.player-input input');
            allInputs.forEach(input => {
                if (input !== e.target) {
                    input.classList.remove('duplicate-error');
                }
            });
        }
    });

    function toggleRandomTopic(checkbox) {
        const playerInputRow = checkbox.closest('.player-topic-row');
        const topicInput = playerInputRow.querySelector('.topic-input');
        if (checkbox.checked) {
            topicInput.disabled = true;
            topicInput.value = '';
            topicInput.placeholder = 'Random Topic';
            topicInput.classList.remove('error', 'shake');
        } else {
            topicInput.disabled = false;
            topicInput.placeholder = 'Präsentationsthema eingeben';
        }
        updateStartButton();
    }
</script>
</body>
</html>