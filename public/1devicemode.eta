<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreestAIle - Multiplayer Mode</title>
    <!-- Dark mode initialization script - must be at the top to prevent flicker -->
    <script src="darkmode-init.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Ubuntu:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles/landing-page.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="styles/1devicemode.css">
</head>

<header class="main-header">
    <div class="header-content">
        <a href="/" style="text-decoration: none; color: inherit;">
            <span class="header-logo">Freest<b>AI</b>le</span>
        </a>
        <div class="flex items-center space-x-4">
            <% if (it.user) { %>
                <!-- Eingeloggter Benutzer -->
                <div class="profile-container">
                    <a href="/user" style="text-decoration: none;">
                        <div class="profile-circle">
                            <%= it.user.email.charAt(0).toUpperCase() %>
                        </div>
                    </a>
                    <div class="profile-email"><%= it.user.email %></div>
                    <a href="#" class="auth-button auth-button-logout" onclick="(async function(e) { e.preventDefault(); try { const response = await fetch('/api/auth/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' } }); if (response.ok) window.location.reload(); } catch (error) { console.error('Logout-Fehler:', error); } })(event)">
                        <span>Abmelden</span>
                        <svg width="15px" height="10px" viewBox="0 0 13 10">
                            <path d="M1,5 L11,5"></path>
                            <polyline points="8 1 12 5 8 9"></polyline>
                        </svg>
                    </a>
                </div>
            <% } else { %>
                <!-- Nicht eingeloggter Benutzer -->
                <div class="auth-buttons">
                    <a href="#" class="auth-button auth-button-login" onclick="openAuthModal('login'); return false;">
                        <span>Anmelden</span>
                        <svg width="15px" height="10px" viewBox="0 0 13 10">
                            <path d="M1,5 L11,5"></path>
                            <polyline points="8 1 12 5 8 9"></polyline>
                        </svg>
                    </a>
                    <a href="#" class="auth-button auth-button-register" onclick="openAuthModal('register'); return false;">
                        <span>Registrieren</span>
                        <svg width="15px" height="10px" viewBox="0 0 13 10">
                            <path d="M1,5 L11,5"></path>
                            <polyline points="8 1 12 5 8 9"></polyline>
                        </svg>
                    </a>
                </div>
            <% } %>
            <label class="switch">
                <input id="darkmode-toggle" type="checkbox" />
                <span class="slider">
                    <div class="star star_1"></div>
                    <div class="star star_2"></div>
                    <div class="star star_3"></div>
                    <svg viewBox="0 0 16 16" class="cloud_1 cloud">
                        <path
                            transform="matrix(.77976 0 0 .78395-299.99-418.63)"
                            fill="#fff"
                            d="m391.84 540.91c-.421-.329-.949-.524-1.523-.524-1.351 0-2.451 1.084-2.485 2.435-1.395.526-2.388 1.88-2.388 3.466 0 1.874 1.385 3.423 3.182 3.667v.034h12.73v-.006c1.775-.104 3.182-1.584 3.182-3.395 0-1.747-1.309-3.186-2.994-3.379.007-.106.011-.214.011-.322 0-2.707-2.271-4.901-5.072-4.901-2.073 0-3.856 1.202-4.643 2.925"
                        ></path>
                    </svg>
                </span>
            </label>
        </div>
    </div>
</header>

<body>
<div class="container-wrapper">
    <div class="container">
        <div class="header">
            <h1 class="logo"><b>1-DEVICE</b>-Mode</h1>
            <p class="tagline">Spielt PowerPoint-Karaoke im Multiplayer mit nur einem Gerät!</p>
        </div>

        <div class="player-grid" id="playerGrid">
            <!-- Spieler-Karten werden hier dynamisch eingefügt -->
            <div id="addPlayerCard" class="add-player-card" onclick="addPlayer()" style="display: none;">
                <div class="plus-icon">
                    <i class="fas fa-plus"></i>
                </div>
            </div>
        </div>

        <button id="startGameButton" class="start-game-button" disabled>
            Spiel starten
        </button>
    </div>
</div>

<!-- Modal HTML nach dem container-wrapper div -->
<div class="modal-overlay" id="authModal">
    <div class="modal-content">
        <button class="modal-close" onclick="closeAuthModal()">&times;</button>
        <div class="modal-tabs">
            <button class="modal-tab active" onclick="switchTab('login')">Anmelden</button>
            <button class="modal-tab" onclick="switchTab('register')">Registrieren</button>
        </div>
        <form id="loginForm" class="modal-form active" onsubmit="handleModalLogin(event)">
            <div class="form-group">
                <label for="loginEmail">E-Mail</label>
                <input type="email" id="loginEmail" name="email" required>
            </div>
            <div class="form-group">
                <label for="loginPassword">Passwort</label>
                <input type="password" id="loginPassword" name="password" required>
            </div>
            <div class="error-message" id="loginError"></div>
            <button type="submit" class="modal-submit">Anmelden</button>
        </form>
        <form id="registerForm" class="modal-form" onsubmit="handleModalRegister(event)">
            <div class="form-group">
                <label for="registerEmail">E-Mail</label>
                <input type="email" id="registerEmail" name="email" required>
            </div>
            <div class="form-group">
                <label for="registerPassword">Passwort</label>
                <input type="password" id="registerPassword" name="password" required>
            </div>
            <div class="form-group">
                <label for="confirmPassword">Passwort bestätigen</label>
                <input type="password" id="confirmPassword" name="confirmPassword" required>
            </div>
            <div class="error-message" id="registerError"></div>
            <button type="submit" class="modal-submit">Registrieren</button>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const toggle = document.getElementById('darkmode-toggle');
        
        // Get current dark mode status (already set by darkmode-init.js)
        const isDark = document.documentElement.classList.contains('darkmode');
        
        // Set toggle position based on current dark mode status
        toggle.checked = !isDark;
        
        // Ensure body also has the class for backward compatibility
        document.body.classList.toggle('darkmode', isDark);

        toggle.addEventListener('change', function() {
            const dark = !toggle.checked;
            document.documentElement.classList.toggle('darkmode', dark);
            document.body.classList.toggle('darkmode', dark);
            localStorage.setItem('darkmode', dark.toString());
        });

        // Initial einen Spieler hinzufügen (den Host)
        addPlayer(true);
    });

    let playerCount = 0;
    const maxPlayers = 7;
    const minPlayers = 1;

    function addPlayer(isHost = false) {
        if (playerCount >= maxPlayers) {
            return;
        }

        const playerGrid = document.getElementById('playerGrid');
        const playerCard = document.createElement('div');
        playerCard.className = 'player-card';
        playerCard.innerHTML = `
            <div class="player-header">
                <div class="player-avatar">
                    ?
                </div>
                <div class="player-info">
                    <div class="player-input" style="margin-top: 0;">
                        <input type="text" placeholder="Nutzername" required class="player-name-input" oninput="updateAvatar(this)">
                    </div>
                </div>
            </div>
            <div class="player-input">
                <input type="text" placeholder="Präsentationsthema eingeben" required>
            </div>
            <div class="player-actions">
                <button class="ready-button" onclick="toggleReady(this)">
                    <span>OK</span>
                    <svg width="15px" height="10px" viewBox="0 0 13 10">
                        <path d="M1,5 L11,5"></path>
                        <polyline points="8 1 12 5 8 9"></polyline>
                    </svg>
                </button>
                <button class="delete-button" onclick="removePlayer(this)">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 69 14" class="svgIcon bin-top">
                        <g clip-path="url(#clip0_35_24)">
                            <path fill="currentColor" d="M20.8232 2.62734L19.9948 4.21304C19.8224 4.54309 19.4808 4.75 19.1085 4.75H4.92857C2.20246 4.75 0 6.87266 0 9.5C0 12.1273 2.20246 14.25 4.92857 14.25H64.0714C66.7975 14.25 69 12.1273 69 9.5C69 6.87266 66.7975 4.75 64.0714 4.75H49.8915C49.5192 4.75 49.1776 4.54309 49.0052 4.21305L48.1768 2.62734C47.3451 1.00938 45.6355 0 43.7719 0H25.2281C23.3645 0 21.6549 1.00938 20.8232 2.62734ZM64.0023 20.0648C64.0397 19.4882 63.5822 19 63.0044 19H5.99556C5.4178 19 4.96025 19.4882 4.99766 20.0648L8.19375 69.3203C8.44018 73.0758 11.6746 76 15.5712 76H53.4288C57.3254 76 60.5598 73.0758 60.8062 69.3203L64.0023 20.0648Z"></path>
                        </g>
                        <defs>
                            <clipPath id="clip0_35_24">
                                <rect fill="white" height="14" width="69"></rect>
                            </clipPath>
                        </defs>
                    </svg>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 69 57" class="svgIcon bin-bottom">
                        <g clip-path="url(#clip0_35_22)">
                            <path fill="currentColor" d="M20.8232 -16.3727L19.9948 -14.787C19.8224 -14.4569 19.4808 -14.25 19.1085 -14.25H4.92857C2.20246 -14.25 0 -12.1273 0 -9.5C0 -6.8727 2.20246 -4.75 4.92857 -4.75H64.0714C66.7975 -4.75 69 -6.8727 69 -9.5C69 -12.1273 66.7975 -14.25 64.0714 -14.25H49.8915C49.5192 -14.25 49.1776 -14.4569 49.0052 -14.787L48.1768 -16.3727C47.3451 -17.9906 45.6355 -19 43.7719 -19H25.2281C23.3645 -19 21.6549 -17.9906 20.8232 -16.3727ZM64.0023 1.0648C64.0397 0.4882 63.5822 0 63.0044 0H5.99556C5.4178 0 4.96025 0.4882 4.99766 1.0648L8.19375 50.3203C8.44018 54.0758 11.6746 57 15.5712 57H53.4288C57.3254 57 60.5598 54.0758 60.8062 50.3203L64.0023 1.0648Z"></path>
                        </g>
                        <defs>
                            <clipPath id="clip0_35_22">
                                <rect fill="white" height="57" width="69"></rect>
                            </clipPath>
                        </defs>
                    </svg>
                </button>
            </div>
        `;

        playerGrid.appendChild(playerCard);
        playerCount++;
        updateStartButton();
        updateAddPlayerCard();
    }

    function updateAvatar(input) {
        const playerCard = input.closest('.player-card');
        const avatar = playerCard.querySelector('.player-avatar');
        const name = input.value.trim();
        avatar.textContent = name ? name.charAt(0).toUpperCase() : '?';
    }

    function removePlayer(button) {
        const playerCard = button.closest('.player-card');
        playerCard.remove();
        playerCount--;
        updateStartButton();
        updateAddPlayerCard();
    }

    function toggleReady(button) {
        const playerCard = button.closest('.player-card');
        const topicInput = playerCard.querySelector('.player-input input[placeholder="Präsentationsthema eingeben"]');
        const nameInput = playerCard.querySelector('.player-name-input');
        
        if (button.classList.contains('ready')) {
            button.classList.remove('ready');
            topicInput.disabled = false;
            nameInput.disabled = false;
            topicInput.classList.remove('error', 'duplicate-error');
            nameInput.classList.remove('error', 'duplicate-error');
        } else {
            let hasError = false;
            
            // Prüfe auf leere Felder
            if (!topicInput.value.trim()) {
                topicInput.classList.add('error');
                hasError = true;
            } else {
                topicInput.classList.remove('error');
            }
            
            if (!nameInput.value.trim()) {
                nameInput.classList.add('error');
                hasError = true;
            } else {
                nameInput.classList.remove('error');
            }

            // Prüfe auf doppelte Namen
            const allNameInputs = document.querySelectorAll('.player-name-input');
            const currentName = nameInput.value.trim();
            let duplicateNameFound = false;

            allNameInputs.forEach(input => {
                if (input !== nameInput && input.value.trim() === currentName) {
                    duplicateNameFound = true;
                    input.classList.add('duplicate-error');
                }
            });

            if (duplicateNameFound) {
                nameInput.classList.add('duplicate-error');
                hasError = true;
            }

            // Prüfe auf doppelte Themen
            const allTopicInputs = document.querySelectorAll('.player-input input[placeholder="Präsentationsthema eingeben"]');
            const currentTopic = topicInput.value.trim();
            let duplicateTopicFound = false;

            allTopicInputs.forEach(input => {
                if (input !== topicInput && input.value.trim() === currentTopic) {
                    duplicateTopicFound = true;
                    input.classList.add('duplicate-error');
                }
            });

            if (duplicateTopicFound) {
                topicInput.classList.add('duplicate-error');
                hasError = true;
            }
            
            if (hasError) {
                return;
            }
            
            button.classList.add('ready');
            topicInput.disabled = true;
            nameInput.disabled = true;
        }
        
        updateStartButton();
    }

    function updateStartButton() {
        const startButton = document.getElementById('startGameButton');
        const readyPlayers = document.querySelectorAll('.ready-button.ready').length;
        
        // Button aktivieren, wenn mindestens ein Spieler bereit ist und alle Spieler bereit sind
        startButton.disabled = readyPlayers < minPlayers || readyPlayers !== playerCount;
    }

    function updateAddPlayerCard() {
        const addPlayerCard = document.getElementById('addPlayerCard');
        if (playerCount < maxPlayers) {
            addPlayerCard.style.display = 'flex';
        } else {
            addPlayerCard.style.display = 'none';
        }
    }

    // Event Listener für den Start-Button
    document.getElementById('startGameButton').addEventListener('click', async function() {
        const presentations = Array.from(document.querySelectorAll('.player-card')).map(card => {
            const topicInput = card.querySelector('input[placeholder="Präsentationsthema eingeben"]');
            const nameInput = card.querySelector('.player-name-input');
            return {
                player: nameInput.value,
                topic: topicInput.value
            };
        });

        try {
            const response = await fetch('/initiateGeneration', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ 
                    presentations,
                    user: { id: '<%= it.user.id %>' }
                })
            });

            const data = await response.json();

            console.log(data.url);

            if (response.ok && data && data.url) {
                window.location.href = data.url;
            } else {
                console.error('Fehler bei der Generierung:', data.error || 'Unbekannter Fehler');
            }
        } catch (error) {
            console.error('Fehler beim Senden der Anfrage:', error);
        }
    });

    // Modal Funktionen
    function openAuthModal(tab) {
        const modal = document.getElementById('authModal');
        modal.classList.add('active');
        switchTab(tab);
        document.body.style.overflow = 'hidden';
    }

    function closeAuthModal() {
        const modal = document.getElementById('authModal');
        modal.classList.remove('active');
        document.body.style.overflow = '';
        // Formulare zurücksetzen
        document.getElementById('loginForm').reset();
        document.getElementById('registerForm').reset();
        document.getElementById('loginError').classList.remove('active');
        document.getElementById('registerError').classList.remove('active');
    }

    function switchTab(tab) {
        const tabs = document.querySelectorAll('.modal-tab');
        const forms = document.querySelectorAll('.modal-form');
        
        tabs.forEach(t => t.classList.remove('active'));
        forms.forEach(f => f.classList.remove('active'));
        
        document.querySelector(`.modal-tab[onclick="switchTab('${tab}')"]`).classList.add('active');
        document.getElementById(`${tab}Form`).classList.add('active');
    }

    async function handleModalLogin(event) {
        event.preventDefault();
        const email = document.getElementById('loginEmail').value;
        const password = document.getElementById('loginPassword').value;
        const errorElement = document.getElementById('loginError');
        
        try {
            const response = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            });
            
            if (response.ok) {
                window.location.reload();
            } else {
                const data = await response.json();
                errorElement.textContent = data.message || 'Anmeldung fehlgeschlagen';
                errorElement.classList.add('active');
            }
        } catch (error) {
            errorElement.textContent = 'Ein Fehler ist aufgetreten';
            errorElement.classList.add('active');
        }
    }

    async function handleModalRegister(event) {
        event.preventDefault();
        const email = document.getElementById('registerEmail').value;
        const password = document.getElementById('registerPassword').value;
        const confirmPassword = document.getElementById('confirmPassword').value;
        const errorElement = document.getElementById('registerError');
        
        if (password !== confirmPassword) {
            errorElement.textContent = 'Die Passwörter stimmen nicht überein';
            errorElement.classList.add('active');
            return;
        }
        
        try {
            const response = await fetch('/api/auth/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            });
            
            if (response.ok) {
                // Nach erfolgreicher Registrierung zum Login-Tab wechseln
                switchTab('login');
                document.getElementById('loginEmail').value = email;
                errorElement.classList.remove('active');
            } else {
                const data = await response.json();
                errorElement.textContent = data.message || 'Registrierung fehlgeschlagen';
                errorElement.classList.add('active');
            }
        } catch (error) {
            errorElement.textContent = 'Ein Fehler ist aufgetreten';
            errorElement.classList.add('active');
        }
    }

    // Schließen des Modals bei Klick außerhalb oder Escape-Taste
    document.addEventListener('click', function(event) {
        const modal = document.getElementById('authModal');
        if (event.target === modal) {
            closeAuthModal();
        }
    });

    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeAuthModal();
        }
    });

    // Event Listener für Input-Felder, um Fehler-Status zu entfernen
    document.addEventListener('input', function(e) {
        if (e.target.classList.contains('error') || e.target.classList.contains('duplicate-error')) {
            e.target.classList.remove('error', 'duplicate-error');
            
            // Entferne auch die duplicate-error Klasse von anderen Feldern
            const allInputs = document.querySelectorAll('.player-input input');
            allInputs.forEach(input => {
                if (input !== e.target) {
                    input.classList.remove('duplicate-error');
                }
            });
        }
    });
</script>
</body>
</html> 