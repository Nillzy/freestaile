<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreeStaile - PowerPoint Karaoke</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .fade-in {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 1s ease-out, transform 1s ease-out;
        }
        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="min-h-screen bg-gradient-to-b from-white to-gray-100">
    <!-- Header -->
    <header class="fixed w-full bg-white/80 backdrop-blur-sm shadow-sm z-50">
        <div class="container mx-auto px-4 py-4 flex justify-between items-center">
            <div class="text-2xl font-bold text-indigo-600">FreeStaile</div>
            <nav class="hidden md:flex space-x-8">
                <a href="#features" class="text-gray-600 hover:text-indigo-600 transition-colors">Features</a>
                <a href="#demo" class="text-gray-600 hover:text-indigo-600 transition-colors">Demo</a>
                <a href="#contact" class="text-gray-600 hover:text-indigo-600 transition-colors">Kontakt</a>
            </nav>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="pt-32 pb-20 px-4">
        <div class="container mx-auto text-center">
            <h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6 fade-in">
                PowerPoint Karaoke neu definiert
            </h1>
            <p class="text-xl md:text-2xl text-gray-600 mb-12 fade-in">
                Übe spontan! Beeindrucke Dein Publikum!
            </p>
            <div class="flex flex-col md:flex-row gap-4 justify-center items-center">
                <a href="/main" class="inline-block bg-indigo-600 text-white px-8 py-4 rounded-full text-lg font-semibold hover:bg-indigo-700 transform hover:scale-105 transition-all duration-300 shadow-lg fade-in">
                    <i class="fas fa-magic mr-2"></i>Jetzt starten
                </a>
                <a href="/multi" class="inline-block bg-green-600 text-white px-8 py-4 rounded-full text-lg font-semibold hover:bg-green-700 transform hover:scale-105 transition-all duration-300 shadow-lg fade-in">
                    <i class="fas fa-users mr-2"></i>Multiplayer-Modus
                </a>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="py-20 bg-white">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl font-bold text-center mb-16">Unsere Features</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
                <div class="text-center p-6 rounded-xl bg-white shadow-lg hover:shadow-xl transition-shadow duration-300">
                    <div class="text-4xl mb-4"><i class="fas fa-bolt text-indigo-600"></i></div>
                    <h3 class="text-xl font-semibold mb-2">Zufällige Slides</h3>
                    <p class="text-gray-600">Erlebe die Spannung mit unvorhersehbaren Präsentationen</p>
                </div>
                <div class="text-center p-6 rounded-xl bg-white shadow-lg hover:shadow-xl transition-shadow duration-300">
                    <div class="text-4xl mb-4"><i class="fas fa-clock text-indigo-600"></i></div>
                    <h3 class="text-xl font-semibold mb-2">Live-Timer</h3>
                    <p class="text-gray-600">Perfektes Timing für deine Präsentation</p>
                </div>
                <div class="text-center p-6 rounded-xl bg-white shadow-lg hover:shadow-xl transition-shadow duration-300">
                    <div class="text-4xl mb-4"><i class="fas fa-microphone text-indigo-600"></i></div>
                    <h3 class="text-xl font-semibold mb-2">Spracherkennung</h3>
                    <p class="text-gray-600">Verbessere deine Rhetorik in Echtzeit</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Demo Section -->
    <section id="demo" class="py-20 bg-gray-50">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl font-bold text-center mb-16">Demo-Präsentationen</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% for(let i = 0; i < 3; i++) { %>
                    <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
                        <div class="aspect-video bg-gray-200"></div>
                        <div class="p-6">
                            <h3 class="text-xl font-semibold mb-2">Beispiel-Präsentation</h3>
                            <p class="text-gray-600 mb-4">Eine kurze Vorschau unserer PowerPoint Karaoke</p>
                            <button class="text-indigo-600 hover:text-indigo-700 font-semibold">
                                Vorschau ansehen →
                            </button>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white py-12">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div>
                    <h3 class="text-xl font-bold mb-4">FreeStaile</h3>
                    <p class="text-gray-400">PowerPoint Karaoke neu erfinden</p>
                </div>
                <div>
                    <h3 class="text-xl font-bold mb-4">Links</h3>
                    <ul class="space-y-2">
                        <li><a href="#" class="text-gray-400 hover:text-white">Impressum</a></li>
                        <li><a href="#" class="text-gray-400 hover:text-white">Datenschutz</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-xl font-bold mb-4">Social Media</h3>
                    <div class="flex space-x-4">
                        <a href="#" class="text-gray-400 hover:text-white"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="text-gray-400 hover:text-white"><i class="fab fa-linkedin"></i></a>
                        <a href="#" class="text-gray-400 hover:text-white"><i class="fab fa-github"></i></a>
                    </div>
                </div>
            </div>
            <div class="mt-8 pt-8 border-t border-gray-800 text-center text-gray-400">
                © 2024 FreeStaile. Alle Rechte vorbehalten.
            </div>
        </div>
    </footer>

    <script>
        // Fade-in Animation
        document.addEventListener('DOMContentLoaded', function() {
            const fadeElements = document.querySelectorAll('.fade-in');
            fadeElements.forEach(element => {
                element.classList.add('visible');
            });
        });
    </script>
</body>
</html> 