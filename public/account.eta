<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account - FreestAIle</title>
    <!-- Dark mode initialization script - must be at the top to prevent flicker -->
    <script src="darkmode-init.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Ubuntu:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles/landing-page.css">
    <link rel="stylesheet" href="styles/account.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<header class="main-header">
    <div class="header-content">
        <a href="/" style="text-decoration: none; color: inherit;">
            <span class="header-logo">Freest<b>AI</b>le</span>
        </a>
        <div class="flex items-center space-x-4">
            <% if (it.user) { %>
                <div class="profile-container">
                    <div class="profile-circle">
                        <%= it.user.email.charAt(0).toUpperCase() %>
                    </div>
                    <span class="profile-email"><%= it.user.email %></span>
                    <a href="#" class="auth-button auth-button-logout" onclick="(async function(e) { e.preventDefault(); try { const response = await fetch('/api/auth/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' } }); if (response.ok) window.location.reload(); } catch (error) { console.error('Logout-Fehler:', error); } })(event)">
                        <span>Abmelden</span>
                        <svg width="15px" height="10px" viewBox="0 0 13 10">
                            <path d="M1,5 L11,5"></path>
                            <polyline points="8 1 12 5 8 9"></polyline>
                        </svg>
                    </a>
                </div>
            <% } else { %>
                <div class="auth-buttons">
                    <a href="#" class="auth-button auth-button-login" onclick="openAuthModal('login'); return false;">
                        <span>Anmelden</span>
                        <svg width="15px" height="10px" viewBox="0 0 13 10">
                            <path d="M1,5 L11,5"></path>
                            <polyline points="8 1 12 5 8 9"></polyline>
                        </svg>
                    </a>
                    <a href="#" class="auth-button auth-button-register" onclick="openAuthModal('register'); return false;">
                        <span>Registrieren</span>
                        <svg width="15px" height="10px" viewBox="0 0 13 10">
                            <path d="M1,5 L11,5"></path>
                            <polyline points="8 1 12 5 8 9"></polyline>
                        </svg>
                    </a>
                </div>
            <% } %>
            <label class="switch">
                <input id="darkmode-toggle" type="checkbox" />
                <span class="slider">
                    <div class="star star_1"></div>
                    <div class="star star_2"></div>
                    <div class="star star_3"></div>
                    <svg viewBox="0 0 16 16" class="cloud_1 cloud">
                        <path
                            transform="matrix(.77976 0 0 .78395-299.99-418.63)"
                            fill="#fff"
                            d="m391.84 540.91c-.421-.329-.949-.524-1.523-.524-1.351 0-2.451 1.084-2.485 2.435-1.395.526-2.388 1.88-2.388 3.466 0 1.874 1.385 3.423 3.182 3.667v.034h12.73v-.006c1.775-.104 3.182-1.584 3.182-3.395 0-1.747-1.309-3.186-2.994-3.379.007-.106.011-.214.011-.322 0-2.707-2.271-4.901-5.072-4.901-2.073 0-3.856 1.202-4.643 2.925"
                        ></path>
                    </svg>
                </span>
            </label>
        </div>
    </div>
</header>

<body>
    <div class="account-container">
        <div class="account-header">
            <div class="profile-circle-large">
                <%= it.user.email.charAt(0).toUpperCase() %>
            </div>
            <div class="account-info">
                <h1>Mein Account</h1>
                <p>Verwalten Sie Ihre Account-Einstellungen</p>
            </div>
        </div>
        <div class="account-details">
            <div class="detail-group">
                <label>E-Mail-Adresse</label>
                <div class="value"><%= it.user.email %></div>
            </div>
            <div class="detail-group">
                <label>Account-ID</label>
                <div class="value"><%= it.user.id %></div>
            </div>
            <button class="delete-account-button" onclick="confirmDeleteAccount()">
                Account löschen
            </button>
        </div>
    </div>

    <div class="rounds-container">
        <h2 style="margin-bottom: 1.5rem;">Vergangene Runden</h2>
        <% if (it.rounds && it.rounds.length > 0) { %>
            <% it.rounds.forEach(round => { %>
                <div class="round-card">
                    <div class="round-header">
                        <h3>Runde vom <%= new Date(round.createdAt).toLocaleDateString('de-DE', {day: '2-digit', month: '2-digit', year: 'numeric'}) %> um <%= new Date(round.createdAt).toLocaleTimeString('de-DE', {hour: '2-digit', minute: '2-digit'}) %> Uhr</h3>
                    </div>
                    <div class="presentations-list">
                        <% round.presentations.forEach(presentation => { %>
                            <div class="presentation-item">
                                <span class="player-name"><%= presentation.player %> – <%= presentation.topic %></span>
                                <div class="presentation-actions">
                                    <a href="/present2?presentationID=<%= presentation.presentationId %>" class="presentation-link">
                                        Präsentation ansehen
                                    </a>
                                    <button class="share-button" onclick="copyPresentationLink('<%= presentation.presentationId %>')" title="Link teilen">
                                        <i class="fas fa-share-alt"></i>
                                    </button>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <p>Noch keine Runden gespielt.</p>
        <% } %>
    </div>

    <div class="copy-feedback">Link kopiert</div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const toggle = document.getElementById('darkmode-toggle');
            
            // Get current dark mode status (already set by darkmode-init.js)
            const isDark = document.documentElement.classList.contains('darkmode');
            
            // Set toggle position based on current dark mode status
            toggle.checked = !isDark;
            
            // Ensure body also has the class for backward compatibility
            document.body.classList.toggle('darkmode', isDark);

            toggle.addEventListener('change', function() {
                const dark = !toggle.checked;
                document.documentElement.classList.toggle('darkmode', dark);
                document.body.classList.toggle('darkmode', dark);
                localStorage.setItem('darkmode', dark.toString());
            });
        });

        function confirmDeleteAccount() {
            if (confirm('Sind Sie sicher, dass Sie Ihren Account löschen möchten? Diese Aktion kann nicht rückgängig gemacht werden.')) {
                deleteAccount();
            }
        }

        async function deleteAccount() {
            try {
                const response = await fetch('/api/auth/delete-account', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    window.location.href = '/';
                } else {
                    alert('Fehler beim Löschen des Accounts. Bitte versuchen Sie es später erneut.');
                }
            } catch (error) {
                console.error('Fehler beim Löschen des Accounts:', error);
                alert('Ein Fehler ist aufgetreten. Bitte versuchen Sie es später erneut.');
            }
        }

        async function copyPresentationLink(presentationId) {
            const link = `${window.location.origin}/present2?presentationID=${presentationId}`;
            try {
                await navigator.clipboard.writeText(link);
                const feedback = document.querySelector('.copy-feedback');
                feedback.classList.add('show');
                setTimeout(() => {
                    feedback.classList.remove('show');
                }, 2000);
            } catch (err) {
                console.error('Fehler beim Kopieren:', err);
            }
        }
    </script>
</body>
</html> 