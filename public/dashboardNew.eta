<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreestAIle - AI-Powered Presentation Karaoke</title>

    <!-- Google Fonts & Font Awesome Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* --- CSS Variables --- */
        :root, [data-theme="light"] {
            --bg-color: #F4F7FC;
            --text-color: #1a1a2e;
            --text-color-light: #6c757d;
            --card-bg: #FFFFFF;
            --header-bg: rgba(255, 255, 255, 0.7);
            --input-bg: #e9ecef;
            /* NEU: Grauer Hintergrund für Light-Mode */
            --primary-color: #5E60E7;
            --secondary-color: #43E69E;
            --accent-glow: rgba(67, 230, 158, 0.3);
            --shadow-color: rgba(0, 0, 0, 0.1);
            --error-color: #e74c3c;
        }

        [data-theme="dark"] {
            --bg-color: #2A2D3A;
            --text-color: #f0f0f0;
            --text-color-light: #a0aec0;
            --card-bg: #353849;
            --header-bg: rgba(42, 45, 58, 0.7);
            --input-bg: #2A2D3A;
            /* Behält den dunklen Hintergrund im Dark-Mode */
            --primary-color: #5E60E7;
            --secondary-color: #43E69E;
            --accent-glow: rgba(67, 230, 158, 0.3);
            --shadow-color: rgba(0, 0, 0, 0.5);
            --error-color: #ff8a8a;
        }

        /* --- Global Reset & Body --- */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Poppins', 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
            transition: background-color 0.3s ease, color 0.3s ease;
            overflow-x: hidden;
        }

        /* --- Main-Layout --- */
        .page-wrapper {
            max-width: 1200px;
            margin: 0 auto;
            padding: 8rem 2rem 2rem;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .content-wrap {
            flex: 1;
        }

        /* --- Header --- */
        .main-header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 0.5rem 2rem;
            z-index: 1000;
            background: var(--header-bg);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            transition: background 0.3s ease;
        }

        .header-logo {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-color);
            text-decoration: none;
        }

        .header-logo b {
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .header-nav {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .dark-mode-toggle {
            cursor: pointer;
            font-size: 1.5rem;
            color: var(--text-color);
            opacity: 0.8;
            transition: all 0.3s ease;
        }

        .dark-mode-toggle:hover {
            opacity: 1;
            transform: scale(1.1) rotate(15deg);
        }

        .user-profile-link {
            text-decoration: none;
            color: inherit;
            border-radius: 50px;
            padding: 4px;
            transition: background-color 0.3s ease;
            margin-right: 0.5rem;
        }

        .user-profile-link:hover {
            background-color: rgba(255, 255, 255, 0.08);
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .profile-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background-color: #F5A623;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .profile-email {
            opacity: 0.8;
            font-weight: 500;
            max-width: 150px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .cta {
            position: relative;
            margin: auto;
            padding: 12px 18px;
            transition: all 0.2s ease;
            border: none;
            background: none;
            cursor: pointer;
        }

        .cta:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            display: block;
            border-radius: 50px;
            width: 45px;
            height: 45px;
            transition: all 0.3s ease;
        }

        .cta span {
            position: relative;
            font-family: "Poppins", sans-serif;
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 0.05em;
        }

        .cta svg {
            position: relative;
            top: 0;
            margin-left: 10px;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke-width: 2;
            transform: translateX(-5px);
            transition: all 0.3s ease;
        }

        .cta:hover:before {
            width: 100%;
        }

        .cta:hover svg {
            transform: translateX(0);
        }

        .cta:active {
            transform: scale(0.95);
        }

        .cta--login:before {
            background: rgba(34, 197, 94, 0.3);
        }

        .cta--login span {
            color: #22c55e;
        }

        .cta--login svg {
            stroke: #22c55e;
        }

        .cta--login:hover:before {
            background: #22c55e;
        }

        .cta--login:hover span, .cta--login:hover svg {
            color: #fff;
            stroke: #fff;
        }

        .cta--logout:before {
            background: rgba(239, 68, 68, 0.3);
        }

        .cta--logout span {
            color: #ef4444;
        }

        .cta--logout svg {
            stroke: #ef4444;
        }

        .cta--logout:hover:before {
            background: #ef4444;
        }

        .cta--logout:hover span, .cta--logout:hover svg {
            color: #fff;
            stroke: #fff;
        }

        /* --- SEITENLAYOUT --- */
        .main-content-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 2rem;
        }

        .mode-card {
            background: var(--card-bg);
            padding: 2.5rem;
            border-radius: 15px;
            box-shadow: 0 10px 30px var(--shadow-color);
            display: flex;
            flex-direction: column;
        }

        .mode-card h2 {
            font-size: 2.5rem;
            /* GEÄNDERT */
            margin-bottom: 0.5rem;
            font-weight: 700;
        }

        .mode-card h2 b {
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .mode-card .tagline {
            font-size: 1.1rem;
            opacity: 0.8;
            margin-bottom: 2rem;
        }

        /* --- FORMULARSTILE --- */
        .main-form {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .main-form .form-group {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            flex-grow: 1;
        }

        .main-form .form-group label {
            font-weight: 600;
            margin-bottom: -0.75rem;
        }

        .main-form .input-wrapper {
            position: relative;
        }

        .main-form .form-group input[type="text"], .main-form .form-group select {
            width: 100%;
            padding: 0.8rem 1rem;
            background: var(--input-bg);
            border: 1px solid transparent;
            border-radius: 8px;
            color: var(--text-color);
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .main-form .form-group input[type="text"]:focus, .main-form .form-group select:focus {
            outline: none;
            border-color: var(--secondary-color);
            box-shadow: 0 0 10px var(--accent-glow);
        }

        .typing-placeholder {
            position: absolute;
            top: 50%;
            left: 1rem;
            transform: translateY(-50%);
            color: var(--text-color-light);
            pointer-events: none;
            white-space: nowrap;
            overflow: hidden;
        }

        .typing-placeholder .cursor {
            display: inline-block;
            width: 2px;
            height: 1.2em;
            background-color: var(--secondary-color);
            animation: blink 1s infinite;
            vertical-align: middle;
        }

        @keyframes blink { 50% { opacity: 0; } }

        .input-hint {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-color-light);
            font-size: 0.85rem;
            height: 0;
            opacity: 0;
            overflow: hidden;
            transform: translateY(-10px);
            transition: all 0.3s ease-in-out;
        }

        .input-hint.visible {
            height: 21px;
            opacity: 1;
            margin-top: -0.75rem;
            transform: translateY(0);
        }

        .input-hint i {
            color: #f0ad4e;
        }

        .error-text {
            color: var(--error-color);
            font-size: 0.9rem;
            margin-top: -0.75rem;
            font-weight: 500;
        }

        @keyframes shake-horizontal {
            0%,
            100% {
                transform: translateX(0);
            }
            10%, 30%, 50%, 70%,
            90% {
                transform: translateX(-8px);
            }
            20%, 40%, 60%,
            80% {
                transform: translateX(8px);
            }
        }

        .input-error {
            border-color: var(--error-color) !important;
            animation: shake-horizontal 0.8s ease-in-out;
        }

        .generate-button {
            font-size: 1.2rem;
            font-weight: 700;
            color: #fff;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            padding: 1rem 2.5rem;
            border-radius: 50px;
            text-decoration: none;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 10px 20px var(--accent-glow);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            width: 100%;
            margin-top: auto;
        }

        .generate-button:hover {
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 15px 30px var(--accent-glow);
        }

        /* --- MULTIPLAYER CARD --- */
        .multiplayer-card {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            position: relative;
        }

        .multiplayer-card .generate-button {
            margin-top: 0;
        }

        .multiplayer-icon {
            font-size: 6rem;
            flex-grow: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 1.5rem;
        }

        .restricted-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(53, 56, 73, 0.7);
            backdrop-filter: blur(4px);
            border-radius: 15px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2rem;
            gap: 1.5rem;
        }

        .restricted-overlay p {
            font-size: 1.1rem;
            font-weight: 600;
        }

        .restricted-overlay .cta-container {
            display: flex;
            gap: 1rem;
        }

        /* --- LOADING OVERLAY & HAMSTER ANIMATION --- */
        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            display: none;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            background: rgba(42, 45, 58, 0.5);
            backdrop-filter: blur(5px);
        }

        body.loading-active .loading-overlay {
            display: flex;
        }

        body.loading-active .page-wrapper {
            pointer-events: none;
        }

        .loading-text {
            color: #fff;
            font-size: 1.5rem;
            font-weight: 600;
            margin-top: 2rem;
            text-shadow: 0 2px 10px rgba(0,0,0,0.5);
        }

        .wheel-and-hamster {
            --dur: 1s;
            position: relative;
            width: 12em;
            height: 12em;
            font-size: 14px;
        }

        .wheel, .hamster, .hamster div, .spoke {
            position: absolute;
        }

        .wheel, .spoke {
            border-radius: 50%;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

        .wheel {
            background: radial-gradient(100% 100% at center,hsla(0,0%,60%,0) 47.8%,hsl(0,0%,60%) 48%);
            z-index: 2;
        }

        .hamster {
            animation: hamster var(--dur) ease-in-out infinite;
            top: 50%;
            left: calc(50% - 3.5em);
            width: 7em;
            height: 3.75em;
            transform: rotate(4deg) translate(-0.8em,1.85em);
            transform-origin: 50% 0;
            z-index: 1;
        }

        .hamster__head {
            animation: hamsterHead var(--dur) ease-in-out infinite;
            background: hsl(30,90%,55%);
            border-radius: 70% 30% 0 100% / 40% 25% 25% 60%;
            box-shadow: 0 -0.25em 0 hsl(30,90%,80%) inset, 0.75em -1.55em 0 hsl(30,90%,90%) inset;
            top: 0;
            left: -2em;
            width: 2.75em;
            height: 2.5em;
            transform-origin: 100% 50%;
        }

        .hamster__ear {
            animation: hamsterEar var(--dur) ease-in-out infinite;
            background: hsl(0,90%,85%);
            border-radius: 50%;
            box-shadow: -0.25em 0 hsl(30,90%,55%) inset;
            top: -0.25em;
            right: -0.25em;
            width: 0.75em;
            height: 0.75em;
            transform-origin: 50% 75%;
        }

        .hamster__eye {
            animation: hamsterEye var(--dur) linear infinite;
            background-color: hsl(0,0%,0%);
            border-radius: 50%;
            top: 0.375em;
            left: 1.25em;
            width: 0.5em;
            height: 0.5em;
        }

        .hamster__nose {
            background: hsl(0,90%,75%);
            border-radius: 35% 65% 85% 15% / 70% 50% 50% 30%;
            top: 0.75em;
            left: 0;
            width: 0.2em;
            height: 0.25em;
        }

        .hamster__body {
            animation: hamsterBody var(--dur) ease-in-out infinite;
            background: hsl(30,90%,90%);
            border-radius: 50% 30% 50% 30% / 15% 60% 40% 40%;
            box-shadow: 0.1em 0.75em 0 hsl(30,90%,55%) inset, 0.15em -0.5em 0 hsl(30,90%,80%) inset;
            top: 0.25em;
            left: 2em;
            width: 4.5em;
            height: 3em;
            transform-origin: 17% 50%;
            transform-style: preserve-3d;
        }

        .hamster__limb--fr, .hamster__limb--fl {
            clip-path: polygon(0 0,100% 0,70% 80%,60% 100%,0% 100%,40% 80%);
            top: 2em;
            left: 0.5em;
            width: 1em;
            height: 1.5em;
            transform-origin: 50% 0;
        }

        .hamster__limb--fr {
            animation: hamsterFRLimb var(--dur) linear infinite;
            background: linear-gradient(hsl(30,90%,80%) 80%,hsl(0,90%,75%) 80%);
            transform: rotate(15deg) translateZ(-1px);
        }

        .hamster__limb--fl {
            animation: hamsterFLLimb var(--dur) linear infinite;
            background: linear-gradient(hsl(30,90%,90%) 80%,hsl(0,90%,85%) 80%);
            transform: rotate(15deg);
        }

        .hamster__limb--br, .hamster__limb--bl {
            border-radius: 0.75em 0.75em 0 0;
            clip-path: polygon(0 0,100% 0,100% 30%,70% 90%,70% 100%,30% 100%,40% 90%,0% 30%);
            top: 1em;
            left: 2.8em;
            width: 1.5em;
            height: 2.5em;
            transform-origin: 50% 30%;
        }

        .hamster__limb--br {
            animation: hamsterBRLimb var(--dur) linear infinite;
            background: linear-gradient(hsl(30,90%,80%) 90%,hsl(0,90%,75%) 90%);
            transform: rotate(-25deg) translateZ(-1px);
        }

        .hamster__limb--bl {
            animation: hamsterBLLimb var(--dur) linear infinite;
            background: linear-gradient(hsl(30,90%,90%) 90%,hsl(0,90%,85%) 90%);
            transform: rotate(-25deg);
        }

        .hamster__tail {
            animation: hamsterTail var(--dur) linear infinite;
            background: hsl(0,90%,85%);
            border-radius: 0.25em 50% 50% 0.25em;
            box-shadow: 0 -0.2em 0 hsl(0,90%,75%) inset;
            top: 1.5em;
            right: -0.5em;
            width: 1em;
            height: 0.5em;
            transform: rotate(30deg) translateZ(-1px);
            transform-origin: 0.25em 0.25em;
        }

        .spoke {
            animation: spoke var(--dur) linear infinite;
            background: radial-gradient(100% 100% at center,hsl(0,0%,60%) 4.8%,hsla(0,0%,60%,0) 5%), linear-gradient(hsla(0,0%,55%,0) 46.9%,hsl(0,0%,65%) 47% 52.9%,hsla(0,0%,65%,0) 53%) 50% 50% / 99% 99% no-repeat;
        }

        @keyframes hamster {
            from,
            to {
                transform: rotate(4deg) translate(-0.8em,1.85em);
            }
            50% {
                transform: rotate(0) translate(-0.8em,1.85em);
            }
        } @keyframes hamsterHead {
              from, 25%, 50%, 75%,
              to {
                  transform: rotate(0);
              }
              12.5%, 37.5%, 62.5%,
              87.5% {
                  transform: rotate(8deg);
              }
          }
        @keyframes hamsterEye {
            from, 90%,
            to {
                transform: scaleY(1);
            }
            95% {
                transform: scaleY(0);
            }
        }
        @keyframes hamsterEar {
            from, 25%, 50%, 75%,
            to {
                transform: rotate(0);
            }
            12.5%, 37.5%, 62.5%,
            87.5% {
                transform: rotate(12deg);
            }
        }
        @keyframes hamsterBody {
            from, 25%, 50%, 75%,
            to {
                transform: rotate(0);
            }
            12.5%, 37.5%, 62.5%,
            87.5% {
                transform: rotate(-2deg);
            }
        }
        @keyframes hamsterFRLimb {
            from, 25%, 50%, 75%,
            to {
                transform: rotate(50deg) translateZ(-1px);
            }
            12.5%, 37.5%, 62.5%,
            87.5% {
                transform: rotate(-30deg) translateZ(-1px);
            }
        }
        @keyframes hamsterFLLimb {
            from, 25%, 50%, 75%,
            to {
                transform: rotate(-30deg);
            }
            12.5%, 37.5%, 62.5%,
            87.5% {
                transform: rotate(50deg);
            }
        }
        @keyframes hamsterBRLimb {
            from, 25%, 50%, 75%,
            to {
                transform: rotate(-60deg) translateZ(-1px);
            }
            12.5%, 37.5%, 62.5%,
            87.5% {
                transform: rotate(20deg) translateZ(-1px);
            }
        }
        @keyframes hamsterBLLimb {
            from, 25%, 50%, 75%,
            to {
                transform: rotate(20deg);
            }
            12.5%, 37.5%, 62.5%,
            87.5% {
                transform: rotate(-60deg);
            }
        }
        @keyframes hamsterTail {
            from, 25%, 50%, 75%,
            to {
                transform: rotate(30deg) translateZ(-1px);
            }
            12.5%, 37.5%, 62.5%,
            87.5% {
                transform: rotate(10deg) translateZ(-1px);
            }
        }
        @keyframes spoke {
            from {
                transform: rotate(0);
            }
            to {
                transform: rotate(-1turn);
            }
        }

        /* --- Footer --- */
        .main-footer {
            text-align: center;
            padding: 3rem 2rem 2rem;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            font-size: 0.9rem;
            opacity: 0.7;
        }

        .main-footer a {
            color: var(--secondary-color);
            text-decoration: none;
            font-weight: 600;
        }

        .main-footer a:hover {
            text-decoration: underline;
        }

        /* --- Modal for Login/Register --- */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(10, 10, 20, 0.8);
            backdrop-filter: blur(8px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 2000;
            animation: fadeIn 0.3s ease;
        }

        .modal-content {
            background: var(--card-bg);
            padding: 2.5rem;
            border-radius: 15px;
            width: 90%;
            max-width: 450px;
            position: relative;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
            animation: slideIn 0.4s ease-out;
            border: 1px solid rgba(255,255,255,0.1);
        }

        .modal-close {
            position: absolute;
            top: 1rem;
            right: 1.5rem;
            background: none;
            border: none;
            font-size: 2rem;
            color: var(--text-color);
            opacity: 0.6;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .modal-close:hover {
            opacity: 1;
            transform: rotate(90deg);
        }

        .modal-tabs {
            display: flex;
            margin-bottom: 2rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .modal-tab {
            flex: 1;
            text-align: center;
            padding: 1rem;
            cursor: pointer;
            font-weight: 600;
            color: var(--text-color);
            opacity: 0.6;
            transition: all 0.3s ease;
            border-bottom: 3px solid transparent;
        }

        .modal-tab.active {
            opacity: 1;
            border-bottom-color: var(--secondary-color);
        }

        .modal-form {
            display: none;
        }

        .modal-form.active {
            display: block;
        }

        .modal-form .form-group {
            margin-bottom: 1.5rem;
        }

        .modal-form .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            opacity: 0.8;
        }

        .modal-form .form-group input {
            width: 100%;
            padding: 0.8rem 1rem;
            background: var(--input-bg);
            border: 1px solid transparent;
            border-radius: 8px;
            color: var(--text-color);
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .modal-form .form-group input:focus {
            outline: none;
            border-color: var(--secondary-color);
            box-shadow: 0 0 10px var(--accent-glow);
        }

        .modal-form .submit-button {
            width: 100%;
            padding: 1rem;
            border: none;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            color: white;
            opacity: 0.7;
        }

        .modal-form .submit-button.active {
            opacity: 1;
            box-shadow: 0 5px 15px var(--accent-glow);
        }

        .modal-form .submit-button.active:hover {
            transform: translateY(-3px);
        }

        .modal-form .error-message, .modal-form .success-message {
            padding: 0.8rem;
            border-radius: 5px;
            margin-bottom: 1rem;
            text-align: center;
        }

        .modal-form .error-message {
            color: #ff8a8a;
            background: rgba(255, 77, 77, 0.1);
            border: 1px solid rgba(255, 77, 77, 0.3);
        }

        .modal-form .success-message {
            color: #90ee90;
            background: rgba(76, 175, 80, 0.1);
            border: 1px solid rgba(76, 175, 80, 0.3);
        }

        /* Animations */
        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-50px) scale(0.95);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* --- Responsive Design --- */
        @media (max-width: 992px) {
            .main-content-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .page-wrapper, .main-header {
                padding: 0 1rem;
            }

            .header-content {
                padding: 1rem 0;
            }

            .main-header {
                padding: 0.5rem 1rem;
            }

            .page-wrapper {
                padding-top: 6rem;
            }

            .profile-email {
                display: none;
            }
        }

        .header-content {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
    </style>
</head>

<body>

<header class="main-header">
    <div class="header-content">
        <a href="/" style="text-decoration: none;"><span class="header-logo">Freest<b>AI</b>le</span></a>
        <div class="header-nav">
            <% if (it.user) { %>
            <a href="/user" class="user-profile-link"><div class="user-profile"><div class="profile-avatar"><%= it.user.email.charAt(0).toUpperCase() %></div><span class="profile-email"><%= it.user.email %></span></div></a>
            <button class="cta cta--logout" onclick="(async function(e) { e.preventDefault(); try { await fetch('/api/auth/logout', { method: 'POST' }); window.location.reload(); } catch (error) { console.error('Logout error:', error); } })(event)"><span>Logout</span><svg width="15px" height="10px" viewBox="0 0 13 10"><polyline points="8 1 12 5 8 9"></polyline></svg></button>
            <% } else { %>
            <button class="cta cta--login" onclick="openAuthModal('login'); return false;"><span>Login</span><svg width="15px" height="10px" viewBox="0 0 13 10"><polyline points="8 1 12 5 8 9"></polyline></svg></button>
            <% } %>
            <div class="dark-mode-toggle" id="theme-toggle" title="Toggle Theme"><i class="fa-solid fa-moon"></i></div>
        </div>
    </div>
</header>

<div class="loading-overlay" id="loadingOverlay">
    <div aria-label="Orange and tan hamster running in a metal wheel" role="img" class="wheel-and-hamster"><div class="wheel"></div><div class="hamster"><div class="hamster__body"><div class="hamster__head"><div class="hamster__ear"></div><div class="hamster__eye"></div><div class="hamster__nose"></div></div><div class="hamster__limb hamster__limb--fr"></div><div class="hamster__limb hamster__limb--fl"></div><div class="hamster__limb hamster__limb--br"></div><div class="hamster__limb hamster__limb--bl"></div><div class="hamster__tail"></div></div></div><div class="spoke"></div></div>
    <p class="loading-text">Generating your presentation...</p>
</div>

<div class="page-wrapper">
    <div class="content-wrap">
        <div class="main-content-grid">
            <div class="mode-card">
                <h2><b>QUICK</b>mode</h2>
                <p class="tagline">Transform any topic into an AI-powered presentation adventure.</p>
                <form class="main-form" action="/present" method="get" id="quickModeForm">
                    <div class="form-group">
                        <label for="topic">What topic do you want to present?</label>
                        <div class="input-wrapper"><input type="text" name="topic" id="topic" autocomplete="off"><div class="typing-placeholder"></div></div>
                        <div id="topicError" class="error-text" style="display: none;">The topic must be between 3 and 50 characters.</div>
                        <div id="tabHint" class="input-hint"><i class="fas fa-lightbulb"></i><span>Press "Tab" to accept the suggestion</span></div>
                        <label for="languageChooser">Choose the presentation language</label>
                        <div class="input-wrapper"><select name="presentationLanguage" id="languageChooser"><option value="en">🇬🇧 English</option><optgroup label="🇩🇪 German"><option value="Deutsch">Standard German</option><option value="Bayerisch">🥨 Bavarian</option><option value="Schwaebisch">🏰 Swabian</option><option value="Koelsch">🍺 Kölsch</option></optgroup><option value="Franzoesisch">🇫🇷 French</option><option value="Spanisch">🇪🇸 Spanish</option><option value="Italienisch">🇮🇹 Italian</option><option value="Portugiesisch">🇵🇹 Portuguese</option><option value="Russisch">🇷🇺 Russian</option><option value="Chinesisch">🇨🇳 Chinese</option></select></div>
                        <button type="submit" class="generate-button" id="generateButton"><i class="fas fa-magic"></i>Generate Presentation</button>
                    </div>
                </form>
            </div>
            <div class="mode-card multiplayer-card">
                <h2><b>MULTI</b>player Mode</h2>
                <p class="tagline">Challenge your friends or team up for the ultimate showdown!</p>
                <i class="fa-solid fa-users-line multiplayer-icon"></i>
                <button type="submit" class="generate-button" onclick="window.location.href='/multi'" <%= !it.user ? 'disabled' : '' %>><i class="fas fa-users"></i>Play Together!</button>
                <% if (!it.user) { %><div class="restricted-overlay"><p>Multiplayer mode is only available for registered users.</p><div class="cta-container"><button class="cta cta--login" onclick="openAuthModal('login'); return false;"><span>Login</span><svg width="15px" height="10px" viewBox="0 0 13 10"><polyline points="8 1 12 5 8 9"></polyline></svg></button></div></div><% } %>
            </div>
        </div>
    </div>

    <footer class="main-footer">
        © 2025 FreestAIle | The ultimate tool for PowerPoint Karaoke | <a href="/imprint">Imprint</a> | Images by <a href="https://www.pixabay.com" target="_blank" rel="noopener">Pixabay</a>
    </footer>
</div>

<div id="authModal" class="modal-overlay">
    <div class="modal-content">
        <button class="modal-close" onclick="closeAuthModal()">×</button>
        <div class="modal-tabs">
            <div class="modal-tab active" onclick="switchTab('login')">Login</div>
            <div class="modal-tab" onclick="switchTab('register')">Register</div>
        </div>
        <form id="modalLoginForm" class="modal-form active" onsubmit="handleModalLogin(event)">
            <div class="form-group"><label for="modalEmail">Email</label><input type="email" id="modalEmail" name="email" required></div>
            <div class="form-group"><label for="modalPassword">Password</label><input type="password" id="modalPassword" name="password" required></div>
            <div class="error-message" id="modalLoginError" style="display: none;"></div>
            <div class="success-message" id="modalLoginSuccess" style="display: none;"></div>
            <button type="submit" class="submit-button" disabled>Login</button>
        </form>
        <form id="modalRegisterForm" class="modal-form" onsubmit="handleModalRegister(event)">
            <div class="form-group"><label for="modalRegisterEmail">Email</label><input type="email" id="modalRegisterEmail" name="email" required></div>
            <div class="form-group"><label for="modalRegisterPassword">Password</label><input type="password" id="modalRegisterPassword" name="password" required></div>
            <div class="form-group"><label for="modalConfirmPassword">Confirm Password</label><input type="password" id="modalConfirmPassword" name="confirmPassword" required></div>
            <div class="error-message" id="modalRegisterError" style="display: none;"></div>
            <button type="submit" class="submit-button" disabled>Register</button>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Dark Mode Logic
        const themeToggle = document.getElementById('theme-toggle');
        if (themeToggle) {
            const themeToggleIcon = themeToggle.querySelector('i');
            const htmlEl = document.documentElement;
            const setTheme = (theme) => { htmlEl.setAttribute('data-theme', theme); localStorage.setItem('theme', theme); if (themeToggleIcon) themeToggleIcon.className = theme === 'dark' ? 'fa-solid fa-moon' : 'fa-solid fa-sun'; };
            const savedTheme = localStorage.getItem('theme') || 'dark';
            setTheme(savedTheme);
            themeToggle.addEventListener('click', () => { const newTheme = htmlEl.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'; setTheme(newTheme); });
        }
        // Form Submit Handler
        const quickModeForm = document.getElementById('quickModeForm');
        if (quickModeForm) {
            quickModeForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const topicInput = document.getElementById('topic');
                const topicValue = topicInput.value.trim();
                const errorDiv = document.getElementById('topicError');
                if (topicValue.length < 3 || topicValue.length > 50) {
                    topicInput.classList.add('input-error');
                    errorDiv.style.display = 'block';
                    setTimeout(() => { topicInput.classList.remove('input-error'); }, 900);
                } else {
                    errorDiv.style.display = 'none';
                    document.body.classList.add('loading-active');
                    setTimeout(() => { this.submit(); }, 100);
                }
            });
        }
        const topicInputForError = document.getElementById('topic');
        if (topicInputForError) {
            topicInputForError.addEventListener('focus', function() {
                const errorDiv = document.getElementById('topicError');
                if (errorDiv) errorDiv.style.display = 'none';
            });
        }
        window.addEventListener('pageshow', function(event) { if (event.persisted) { document.body.classList.remove('loading-active'); } });
        // Suggestion Logic
        const topicInput = document.getElementById('topic');
        const placeholderEl = document.querySelector('.typing-placeholder');
        const tabHintEl = document.getElementById('tabHint');
        if (topicInput && placeholderEl && tabHintEl) {
            const suggestions = [ "The Socioeconomic Impact of Coca-Cola Zero", "Why Giraffes Don't Exist: A Conspiracy Theory", "Quantum Physics for Toddlers", "The Secret Life of Office Plants", "Time Travel and Its Effect on Retirement Planning", "How to Train Your Housecat to Code in Python", "A Brief History of Cheese-Based Economies", "The Hidden Politics of Umbrella Sharing", "Why Your Toaster Might Be Plotting Against You", "The Rise and Fall of the Nap Empire", "Lunar Real Estate: Investing Beyond Earth", "How Dinosaurs Would Use Social Media Today", "Why Meetings Should Be Held in Bouncy Castles", "The Great Avocado Shortage of 2047", "Teleportation Etiquette for First-Time Users", "The Truth Behind Left-Handed Lightbulbs", "How Aliens Invented the Fidget Spinner", "Sleepwalking Your Way to Corporate Success", "The Secret Linguistics of Dog Barks", "Why Ice Cream Trucks Are the Ultimate Surveillance Vehicles" ];
            let currentText = "", charIndex = 0, suggestionIndex = 0, typingInterval, isPlaceholderActive = true;
            function typePlaceholder() { if (!isPlaceholderActive || charIndex >= suggestions[suggestionIndex].length) { clearInterval(typingInterval); setTimeout(() => { if (isPlaceholderActive) typingInterval = setInterval(erasePlaceholder, 50); }, 1500); return; } currentText += suggestions[suggestionIndex][charIndex++]; placeholderEl.innerHTML = currentText + '<span class="cursor"></span>'; }
            function erasePlaceholder() { if (!isPlaceholderActive || charIndex <= 0) { suggestionIndex = (suggestionIndex + 1) % suggestions.length; clearInterval(typingInterval); if (isPlaceholderActive) typingInterval = setInterval(typePlaceholder, 100); return; } currentText = currentText.slice(0, -1); placeholderEl.innerHTML = currentText + '<span class="cursor"></span>'; charIndex--; }
            function startPlaceholderCycle() { if (!isPlaceholderActive) return; clearInterval(typingInterval); currentText = ""; charIndex = 0; placeholderEl.innerHTML = '<span class="cursor"></span>'; typingInterval = setInterval(typePlaceholder, 100); }
            function stopPlaceholder() { isPlaceholderActive = false; clearInterval(typingInterval); placeholderEl.style.display = 'none'; }
            topicInput.addEventListener('keydown', (e) => { if (e.key === 'Tab') { e.preventDefault(); stopPlaceholder(); topicInput.value = suggestions[suggestionIndex]; suggestionIndex = (suggestionIndex + 1) % suggestions.length; } });
            topicInput.addEventListener("input", () => { if (topicInput.value.length > 0) { stopPlaceholder(); } else if (!isPlaceholderActive) { isPlaceholderActive = true; placeholderEl.style.display = 'block'; startPlaceholderCycle(); } });
            topicInput.addEventListener('focus', () => tabHintEl.classList.add('visible'));
            topicInput.addEventListener('blur', () => tabHintEl.classList.remove('visible'));
            startPlaceholderCycle();
        }
        // Modal Form Validation
        const loginForm = document.getElementById('modalLoginForm');
        const registerForm = document.getElementById('modalRegisterForm');
        function validateModalForm(form) {
            if (!form) return;
            const inputs = form.querySelectorAll('input[required]');
            const submitButton = form.querySelector('.submit-button');
            const isValid = Array.from(inputs).every(input => input.value.trim() !== '');
            submitButton.classList.toggle('active', isValid);
            submitButton.disabled = !isValid;
        }
        [loginForm, registerForm].forEach(form => { if (form) { form.addEventListener('input', () => validateModalForm(form)); validateModalForm(form); } });
    });
    function openAuthModal(tab = 'login') {
        const modal = document.getElementById('authModal');
        if (modal) { modal.style.display = 'flex'; switchTab(tab); }
    }
    function closeAuthModal() {
        const modal = document.getElementById('authModal');
        if (modal) {
            modal.style.display = 'none';
            ['modalLoginForm', 'modalRegisterForm'].forEach(id => { const form = document.getElementById(id); if (form) form.reset(); });
            ['modalLoginError', 'modalRegisterError', 'modalLoginSuccess'].forEach(id => { const el = document.getElementById(id); if (el) el.style.display = 'none'; });
        }
    }
    function switchTab(tab) {
        document.querySelectorAll('.modal-tab').forEach(t => t.classList.remove('active'));
        document.querySelector(`.modal-tab[onclick="switchTab('${tab}')"]`).classList.add('active');
        document.querySelectorAll('.modal-form').forEach(f => f.classList.remove('active'));
        document.getElementById(`modal${tab.charAt(0).toUpperCase() + tab.slice(1)}Form`).classList.add('active');
    }
    async function handleModalLogin(event) {
        event.preventDefault();
        const email = document.getElementById('modalEmail').value;
        const password = document.getElementById('modalPassword').value;
        const errorDiv = document.getElementById('modalLoginError');
        try {
            const response = await fetch('/api/auth/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, password }) });
            if (response.ok) { window.location.reload(); } else { const error = await response.json(); errorDiv.textContent = error.message || 'Login failed.'; errorDiv.style.display = 'block'; }
        } catch (error) { errorDiv.textContent = 'An error occurred.'; errorDiv.style.display = 'block'; }
    }
    async function handleModalRegister(event) {
        event.preventDefault();
        const email = document.getElementById('modalRegisterEmail').value;
        const password = document.getElementById('modalRegisterPassword').value;
        const confirmPassword = document.getElementById('modalConfirmPassword').value;
        const errorDiv = document.getElementById('modalRegisterError');
        if (password !== confirmPassword) { errorDiv.textContent = 'Passwords do not match.'; errorDiv.style.display = 'block'; return; }
        try {
            const response = await fetch('/api/auth/register', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, password }) });
            const data = await response.json();
            if (response.ok) {
                switchTab('login');
                document.getElementById('modalEmail').value = email;
                ['modalLoginError', 'modalRegisterError'].forEach(id => document.getElementById(id).style.display = 'none');
                const successDiv = document.getElementById('modalLoginSuccess');
                successDiv.textContent = 'Registration successful! Please check your email.'; successDiv.style.display = 'block';
            } else { errorDiv.textContent = data.message || 'Registration failed.'; errorDiv.style.display = 'block'; }
        } catch (error) { errorDiv.textContent = 'An error occurred.'; errorDiv.style.display = 'block'; }
    }
    const authModal = document.getElementById('authModal');
    if (authModal) { authModal.addEventListener('click', (e) => { if (e.target === authModal) closeAuthModal(); }); }
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && authModal && authModal.style.display === 'flex') closeAuthModal(); });
</script>
</body>
</html>