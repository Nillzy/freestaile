<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreestAIle - AI-Powered Presentation Karaoke</title>
    <!-- Dark mode initialization script - must be at the top to prevent flicker -->
    <script src="darkmode-init.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Ubuntu:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles/landing-page.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Basis-Styles für alle Buttons */
        .auth-button {
            position: relative;
            margin: auto;
            padding: 12px 18px;
            transition: all 0.2s ease;
            border: none;
            background: none;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

        .auth-button:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            display: block;
            border-radius: 50px;
            width: 45px;
            height: 45px;
            transition: all 0.3s ease;
        }

        .auth-button span {
            position: relative;
            font-family: "Ubuntu", sans-serif;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: #234567;
        }

        .auth-button svg {
            position: relative;
            top: 0;
            margin-left: 10px;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke: #234567;
            stroke-width: 2;
            transform: translateX(-5px);
            transition: all 0.3s ease;
        }

        .auth-button:hover:before {
            width: 100%;
        }

        .auth-button:hover svg {
            transform: translateX(0);
        }

        .auth-button:active {
            transform: scale(0.95);
        }

        /* Spezifische Styles für Login (blau) */
        .auth-button-login:before {
            background: #b1dae7;
        }
        .auth-button-login:hover:before {
            background: #b1dae7;
        }

        /* Spezifische Styles für Register (grün) */
        .auth-button-register:before {
            background: #b1e7c8;
        }
        .auth-button-register:hover:before {
            background: #b1e7c8;
        }

        /* Spezifische Styles für Logout (rot) */
        .auth-button-logout {
            position: relative;
            margin: auto;
            padding: 12px 18px;
            transition: all 0.2s ease;
            border: none;
            background: none;
            cursor: pointer;
        }

        .auth-button-logout:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            display: block;
            border-radius: 50px;
            background: #e7b1b1;
            width: 45px;
            height: 45px;
            transition: all 0.3s ease;
        }

        .auth-button-logout span {
            position: relative;
            font-family: "Ubuntu", sans-serif;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: #234567;
        }

        .auth-button-logout svg {
            position: relative;
            top: 0;
            margin-left: 10px;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke: #234567;
            stroke-width: 2;
            transform: translateX(-5px);
            transition: all 0.3s ease;
        }

        .auth-button-logout:hover:before {
            width: 100%;
            background: #e7b1b1;
        }

        .auth-button-logout:hover svg {
            transform: translateX(0);
        }

        .auth-button-logout:active {
            transform: scale(0.95);
        }

        .cta {
            position: relative;
            margin: auto;
            padding: 12px 18px;
            transition: all 0.2s ease;
            border: none;
            background: none;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            min-width: 140px; /* Feste Mindestbreite für alle Buttons */
            justify-content: center; /* Zentriert den Inhalt */
        }

        .cta:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            display: block;
            border-radius: 50px;
            width: 45px;
            height: 45px;
            transition: all 0.3s ease;
            background: transparent; /* Entfernt mögliche Vererbung */
        }

        /* Login Button (Standard blau) */
        .cta-login:before {
            background: #b1dae7;
        }
        .cta-login:hover:before {
            background: #b1dae7;
        }
        .cta-login span {
            color: #234567;
        }
        .cta-login svg {
            stroke: #234567;
        }

        /* Register Button (Grün) */
        .cta-register:before {
            background: #b1e7c8;
        }
        .cta-register:hover:before {
            background: #b1e7c8;
        }
        .cta-register span {
            color: #234567;
        }
        .cta-register svg {
            stroke: #234567;
        }

        /* Logout Button (Rot) */
        .cta-logout:before {
            background: #e7b1b1;
        }
        .cta-logout:hover:before {
            background: #e7b1b1;
        }
        .cta-logout span {
            color: #234567;
        }
        .cta-logout svg {
            stroke: #234567;
        }

        .cta span {
            position: relative;
            font-family: "Ubuntu", sans-serif;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.05em;
            white-space: nowrap; /* Verhindert Zeilenumbrüche */
        }

        .cta svg {
            position: relative;
            top: 0;
            margin-left: 10px;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke-width: 2;
            transform: translateX(-5px);
            transition: all 0.3s ease;
            flex-shrink: 0; /* Verhindert Schrumpfen des Icons */
        }

        .cta:hover:before {
            width: 100%;
        }

        .cta:hover svg {
            transform: translateX(0);
        }

        .cta:active {
            transform: scale(0.95);
        }

        /* Entfernt alle möglichen vererbten Styles */
        .cta, .cta-login, .cta-register, .cta-logout {
            background: none !important;
            border: none !important;
            box-shadow: none !important;
            text-decoration: none !important;
            outline: none !important;
        }

        .profile-container {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-right: 1rem;
        }

        .profile-circle {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: #b1dae7;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Ubuntu", sans-serif;
            font-size: 20px;
            font-weight: 700;
            color: #234567;
            transition: all 0.3s ease;
            flex-shrink: 0;
        }
        
        /* Apply dark mode styles to profile circle immediately with class on html element */
        html.darkmode .profile-circle {
            background: #3d3d3d;
            color: #ffffff;
        }

        .profile-email {
            font-family: "Ubuntu", sans-serif;
            font-size: 16px;
            color: #234567;
            white-space: nowrap;
        }
        
        html.darkmode .profile-email {
            color: #ffffff;
        }

        .profile-circle:hover {
            background: #9bc8d7;
            transform: scale(1.05);
        }

        .auth-buttons {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        /* Darkmode Styles für restricted container */
        body.darkmode .restricted-container {
            background: #2d2d2d;
        }

        body.darkmode .restricted-container p {
            color: #a0aec0;
        }

        body.darkmode .profile-circle {
            background: #3d3d3d;
            color: #ffffff;
        }

        body.darkmode .profile-email {
            color: #ffffff;
        }

        .multiplayer-section {
            transition: all 0.3s ease;
        }

        .multiplayer-section button:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

        /* Modal Styles */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(5px);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: #ffffff;
            padding: 2rem;
            border-radius: 10px;
            width: 90%;
            max-width: 400px;
            position: relative;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .modal-close {
            position: fixed;
            top: 2rem;
            right: 2rem;
            width: 40px;
            height: 40px;
            min-width: 40px;
            min-height: 40px;
            padding: 0;
            margin: 0;
            background: #fff;
            border: none;
            border-radius: 50%;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            font-size: 1.5rem;
            line-height: 1;
            cursor: pointer;
            color: #234567;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 2000;
            transition: background 0.2s, color 0.2s;
        }
        .modal-close:hover {
            background: #f0f0f0;
            color: #e53e3e;
        }
        body.darkmode .modal-close {
            background: #23272f;
            color: #fff;
        }
        body.darkmode .modal-close:hover {
            background: #3a3a3a;
            color: #e53e3e;
        }
        body.darkmode .modal-content {
            background: #23272f;
            color: #fff;
        }

        .modal-tabs {
            display: flex;
            margin-bottom: 1.5rem;
            border-bottom: 2px solid #e2e8f0;
            padding-top: 0.5rem;
            justify-content: center;
            gap: 2rem;
        }

        .modal-tab {
            padding: 0.5rem 1rem;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            margin-bottom: -2px;
            color: #666;
            min-width: 120px;
            text-align: center;
        }

        .modal-tab.active {
            color: #234567;
            border-bottom-color: #234567;
        }

        body.darkmode .modal-tab {
            color: #a0aec0;
        }

        body.darkmode .modal-tab.active {
            color: #ffffff;
            border-bottom-color: #ffffff;
        }

        .modal-form {
            display: none;
        }

        .modal-form.active {
            display: block;
        }

        /* Animationen für den Input-Hint */
        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeOutUp {
            from {
                opacity: 1;
                transform: translateY(0);
            }
            to {
                opacity: 0;
                transform: translateY(-10px);
            }
        }

        .input-hint {
            opacity: 0;
            transform: translateY(-10px);
            transition: opacity 0.3s ease, transform 0.3s ease;
            margin-top: 8px;
            min-height: 24px;
            display: flex;
            align-items: center;
        }

        .input-hint-content {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #666;
            font-size: 0.9rem;
            line-height: 1.2;
            padding: 4px 0;
        }

        .input-hint-icon {
            position: relative;
            width: 1.2em;
            height: 1.2em;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .input-hint-icon i {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #234567;
            font-size: 1rem;
        }

        .input-hint span {
            line-height: 1.2;
            display: flex;
            align-items: center;
        }

        body.darkmode .input-hint-content {
            color: #a0aec0;
        }

        body.darkmode .input-hint-icon i {
            color: #ffffff;
        }

        .input-hint.fade-in {
            animation: fadeInDown 0.3s ease forwards;
        }

        .input-hint.fade-out {
            animation: fadeOutUp 0.3s ease forwards;
        }

        /* Hamster Wheel Loading Animation */
        .wheel-and-hamster {
            --dur: 1s;
            position: absolute;
            width: 12em;
            height: 12em;
            font-size: 14px;
            display: none;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 1000;
            opacity: 1 !important; /* Verhindert, dass die Animation von der Opacity des Containers betroffen wird */
        }

        .wheel,
        .hamster,
        .hamster div,
        .spoke {
            position: absolute;
        }

        .wheel,
        .spoke {
            border-radius: 50%;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

        .wheel {
            background: radial-gradient(100% 100% at center,hsla(0,0%,60%,0) 47.8%,hsl(0,0%,60%) 48%);
            z-index: 2;
        }

        .hamster {
            animation: hamster var(--dur) ease-in-out infinite;
            top: 50%;
            left: calc(50% - 3.5em);
            width: 7em;
            height: 3.75em;
            transform: rotate(4deg) translate(-0.8em,1.85em);
            transform-origin: 50% 0;
            z-index: 1;
        }

        .hamster__head {
            animation: hamsterHead var(--dur) ease-in-out infinite;
            background: hsl(30,90%,55%);
            border-radius: 70% 30% 0 100% / 40% 25% 25% 60%;
            box-shadow: 0 -0.25em 0 hsl(30,90%,80%) inset,
                    0.75em -1.55em 0 hsl(30,90%,90%) inset;
            top: 0;
            left: -2em;
            width: 2.75em;
            height: 2.5em;
            transform-origin: 100% 50%;
        }

        .hamster__ear {
            animation: hamsterEar var(--dur) ease-in-out infinite;
            background: hsl(0,90%,85%);
            border-radius: 50%;
            box-shadow: -0.25em 0 hsl(30,90%,55%) inset;
            top: -0.25em;
            right: -0.25em;
            width: 0.75em;
            height: 0.75em;
            transform-origin: 50% 75%;
        }

        .hamster__eye {
            animation: hamsterEye var(--dur) linear infinite;
            background-color: hsl(0,0%,0%);
            border-radius: 50%;
            top: 0.375em;
            left: 1.25em;
            width: 0.5em;
            height: 0.5em;
        }

        .hamster__nose {
            background: hsl(0,90%,75%);
            border-radius: 35% 65% 85% 15% / 70% 50% 50% 30%;
            top: 0.75em;
            left: 0;
            width: 0.2em;
            height: 0.25em;
        }

        .hamster__body {
            animation: hamsterBody var(--dur) ease-in-out infinite;
            background: hsl(30,90%,90%);
            border-radius: 50% 30% 50% 30% / 15% 60% 40% 40%;
            box-shadow: 0.1em 0.75em 0 hsl(30,90%,55%) inset,
                    0.15em -0.5em 0 hsl(30,90%,80%) inset;
            top: 0.25em;
            left: 2em;
            width: 4.5em;
            height: 3em;
            transform-origin: 17% 50%;
            transform-style: preserve-3d;
        }

        .hamster__limb--fr,
        .hamster__limb--fl {
            clip-path: polygon(0 0,100% 0,70% 80%,60% 100%,0% 100%,40% 80%);
            top: 2em;
            left: 0.5em;
            width: 1em;
            height: 1.5em;
            transform-origin: 50% 0;
        }

        .hamster__limb--fr {
            animation: hamsterFRLimb var(--dur) linear infinite;
            background: linear-gradient(hsl(30,90%,80%) 80%,hsl(0,90%,75%) 80%);
            transform: rotate(15deg) translateZ(-1px);
        }

        .hamster__limb--fl {
            animation: hamsterFLLimb var(--dur) linear infinite;
            background: linear-gradient(hsl(30,90%,90%) 80%,hsl(0,90%,85%) 80%);
            transform: rotate(15deg);
        }

        .hamster__limb--br,
        .hamster__limb--bl {
            border-radius: 0.75em 0.75em 0 0;
            clip-path: polygon(0 0,100% 0,100% 30%,70% 90%,70% 100%,30% 100%,40% 90%,0% 30%);
            top: 1em;
            left: 2.8em;
            width: 1.5em;
            height: 2.5em;
            transform-origin: 50% 30%;
        }

        .hamster__limb--br {
            animation: hamsterBRLimb var(--dur) linear infinite;
            background: linear-gradient(hsl(30,90%,80%) 90%,hsl(0,90%,75%) 90%);
            transform: rotate(-25deg) translateZ(-1px);
        }

        .hamster__limb--bl {
            animation: hamsterBLLimb var(--dur) linear infinite;
            background: linear-gradient(hsl(30,90%,90%) 90%,hsl(0,90%,85%) 90%);
            transform: rotate(-25deg);
        }

        .hamster__tail {
            animation: hamsterTail var(--dur) linear infinite;
            background: hsl(0,90%,85%);
            border-radius: 0.25em 50% 50% 0.25em;
            box-shadow: 0 -0.2em 0 hsl(0,90%,75%) inset;
            top: 1.5em;
            right: -0.5em;
            width: 1em;
            height: 0.5em;
            transform: rotate(30deg) translateZ(-1px);
            transform-origin: 0.25em 0.25em;
        }

        .spoke {
            animation: spoke var(--dur) linear infinite;
            background: radial-gradient(100% 100% at center,hsl(0,0%,60%) 4.8%,hsla(0,0%,60%,0) 5%),
                    linear-gradient(hsla(0,0%,55%,0) 46.9%,hsl(0,0%,65%) 47% 52.9%,hsla(0,0%,65%,0) 53%) 50% 50% / 99% 99% no-repeat;
        }

        @keyframes hamster {
            from, to {
                transform: rotate(4deg) translate(-0.8em,1.85em);
            }
            50% {
                transform: rotate(0) translate(-0.8em,1.85em);
            }
        }

        @keyframes hamsterHead {
            from, 25%, 50%, 75%, to {
                transform: rotate(0);
            }
            12.5%, 37.5%, 62.5%, 87.5% {
                transform: rotate(8deg);
            }
        }

        @keyframes hamsterEye {
            from, 90%, to {
                transform: scaleY(1);
            }
            95% {
                transform: scaleY(0);
            }
        }

        @keyframes hamsterEar {
            from, 25%, 50%, 75%, to {
                transform: rotate(0);
            }
            12.5%, 37.5%, 62.5%, 87.5% {
                transform: rotate(12deg);
            }
        }

        @keyframes hamsterBody {
            from, 25%, 50%, 75%, to {
                transform: rotate(0);
            }
            12.5%, 37.5%, 62.5%, 87.5% {
                transform: rotate(-2deg);
            }
        }

        @keyframes hamsterFRLimb {
            from, 25%, 50%, 75%, to {
                transform: rotate(50deg) translateZ(-1px);
            }
            12.5%, 37.5%, 62.5%, 87.5% {
                transform: rotate(-30deg) translateZ(-1px);
            }
        }

        @keyframes hamsterFLLimb {
            from, 25%, 50%, 75%, to {
                transform: rotate(-30deg);
            }
            12.5%, 37.5%, 62.5%, 87.5% {
                transform: rotate(50deg);
            }
        }

        @keyframes hamsterBRLimb {
            from, 25%, 50%, 75%, to {
                transform: rotate(-60deg) translateZ(-1px);
            }
            12.5%, 37.5%, 62.5%, 87.5% {
                transform: rotate(20deg) translateZ(-1px);
            }
        }

        @keyframes hamsterBLLimb {
            from, 25%, 50%, 75%, to {
                transform: rotate(20deg);
            }
            12.5%, 37.5%, 62.5%, 87.5% {
                transform: rotate(-60deg);
            }
        }

        @keyframes hamsterTail {
            from, 25%, 50%, 75%, to {
                transform: rotate(30deg) translateZ(-1px);
            }
            12.5%, 37.5%, 62.5%, 87.5% {
                transform: rotate(10deg) translateZ(-1px);
            }
        }

        @keyframes spoke {
            from {
                transform: rotate(0);
            }
            to {
                transform: rotate(-1turn);
            }
        }

        .form-group {
            margin-bottom: 1rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: #234567;
        }

        .form-group input {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #e2e8f0;
            border-radius: 5px;
            font-size: 1rem;
        }

        .error-message {
            color: #e53e3e;
            margin-bottom: 1rem;
            font-size: 0.875rem;
        }

        .submit-button {
            width: 100%;
            padding: 0.75rem;
            border: none;
            border-radius: 5px;
            color: #234567;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 1.5rem;
            background: #e2e8f0;
            opacity: 0.7;
        }

        .submit-button:disabled {
            cursor: not-allowed;
            opacity: 0.7;
            transform: none;
            box-shadow: none;
        }

        .submit-button.active {
            background: #b1dae7;
            opacity: 1;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(177, 218, 231, 0.3);
        }

        .submit-button[style*="background: #b1e7c8"] {
            background: #e2e8f0 !important;
            opacity: 0.7;
        }

        .submit-button[style*="background: #b1e7c8"].active {
            background: #b1e7c8 !important;
            opacity: 1;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(177, 231, 200, 0.3);
        }

        .submit-button[style*="background: #b1e7c8"].active:hover {
            background: #9bd7b8 !important;
            transform: translateY(-3px);
            box-shadow: 0 6px 16px rgba(177, 231, 200, 0.4);
        }

        .container-wrapper {
            position: relative;
        }

        .container-wrapper.loading {
            opacity: 0.5;
            pointer-events: none;
        }
    </style>
</head>

<header class="main-header">
    <div class="header-content">
        <a href="/" style="text-decoration: none; color: inherit;">
            <span class="header-logo">Freest<b>AI</b>le</span>
        </a>
        <div class="flex items-center space-x-4">
            <% if (it.user) { %>
                <!-- Eingeloggter Benutzer -->
                <div class="profile-container">
                    <a href="/user" style="text-decoration: none;">
                        <div class="profile-circle">
                            <%= it.user.email.charAt(0).toUpperCase() %>
                        </div>
                    </a>
                    <div class="profile-email"><%= it.user.email %></div>
                    <a href="#" class="auth-button auth-button-logout" onclick="(async function(e) { e.preventDefault(); try { const response = await fetch('/api/auth/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' } }); if (response.ok) window.location.reload(); } catch (error) { console.error('Logout-Fehler:', error); } })(event)">
                        <span>Abmelden</span>
                        <svg width="15px" height="10px" viewBox="0 0 13 10">
                            <path d="M1,5 L11,5"></path>
                            <polyline points="8 1 12 5 8 9"></polyline>
                        </svg>
                    </a>
                </div>
            <% } else { %>
                <!-- Nicht eingeloggter Benutzer -->
                <div class="auth-buttons">
                    <a href="#" class="auth-button auth-button-login" onclick="openAuthModal('login'); return false;">
                        <span>Anmelden</span>
                        <svg width="15px" height="10px" viewBox="0 0 13 10">
                            <path d="M1,5 L11,5"></path>
                            <polyline points="8 1 12 5 8 9"></polyline>
                        </svg>
                    </a>
                    <a href="#" class="auth-button auth-button-register" onclick="openAuthModal('register'); return false;">
                        <span>Registrieren</span>
                        <svg width="15px" height="10px" viewBox="0 0 13 10">
                            <path d="M1,5 L11,5"></path>
                            <polyline points="8 1 12 5 8 9"></polyline>
                        </svg>
                    </a>
                </div>
            <% } %>
            <label class="switch">
                <input id="darkmode-toggle" type="checkbox" />
                <span class="slider">
                    <div class="star star_1"></div>
                    <div class="star star_2"></div>
                    <div class="star star_3"></div>
                    <svg viewBox="0 0 16 16" class="cloud_1 cloud">
                        <path
                            transform="matrix(.77976 0 0 .78395-299.99-418.63)"
                            fill="#fff"
                            d="m391.84 540.91c-.421-.329-.949-.524-1.523-.524-1.351 0-2.451 1.084-2.485 2.435-1.395.526-2.388 1.88-2.388 3.466 0 1.874 1.385 3.423 3.182 3.667v.034h12.73v-.006c1.775-.104 3.182-1.584 3.182-3.395 0-1.747-1.309-3.186-2.994-3.379.007-.106.011-.214.011-.322 0-2.707-2.271-4.901-5.072-4.901-2.073 0-3.856 1.202-4.643 2.925"
                        ></path>
                    </svg>
                </span>
            </label>
        </div>
    </div>
</header>

<body>
<div class="container-wrapper">
    <div class="container">
        <div class="header">
            <h1 class="logo"><b>QUICK</b>mode</h1>
            <p class="tagline">Transform any topic into an AI-powered presentation adventure</p>
        </div>

        <form class="main-form" action="/present" method="get" id="quickModeForm">
            <div class="input-group">
                <label for="topic">What should your presentation be about?</label>
                <div class="input-wrapper">
                    <input type="text" name="topic" id="topic" autocomplete="off" maxlength="50">
                    <div class="typing-placeholder"></div>
                </div>
                <div class="error-message" id="topicError" style="display:none;"></div>
                <div class="input-hint" style="display: none;">
                    <div class="input-hint-content">
                        <div class="input-hint-icon">
                            <i class="fas fa-lightbulb"></i>
                        </div>
                        <span>Tab to use recommendation</span>
                    </div>
                </div>
                <label for="presentationLanguage">Select presentation language</label>
                <div class="input-wrapper">
                    <select name="presentationLanguage" id="presentationLanguage">
                        <option value="en">🇬🇧 English</option>
                        <option value="de">🇩🇪 Deutsch</option>
                        <option value="fr">🇫🇷 Français</option>
                        <option value="es">🇪🇸 Español</option>
                        <option value="it">🇮🇹 Italiano</option>
                        <option value="pt">🇵🇹 Português</option>
                        <option value="ru">🇷🇺 Русский</option>
                        <option value="zh">🇨🇳 中文</option>
                    </select>
                </div>
                <button type="submit" id="generateButton">
                    <i class="fas fa-magic"></i>
                    Generate Presentation
                </button>
                <div class="wheel-and-hamster" id="loadingAnimation" role="img" aria-label="Orange and tan hamster running in a metal wheel">
                    <div class="wheel"></div>
                    <div class="hamster">
                        <div class="hamster__body">
                            <div class="hamster__head">
                                <div class="hamster__ear"></div>
                                <div class="hamster__eye"></div>
                                <div class="hamster__nose"></div>
                            </div>
                            <div class="hamster__limb hamster__limb--fr"></div>
                            <div class="hamster__limb hamster__limb--fl"></div>
                            <div class="hamster__limb hamster__limb--br"></div>
                            <div class="hamster__limb hamster__limb--bl"></div>
                            <div class="hamster__tail"></div>
                        </div>
                    </div>
                    <div class="spoke"></div>
                </div>
            </div>
        </form>
    </div>

    <div class="container">
        <div class="header">
            <div class="multiplayer-section" style="position: relative; <%= !it.user ? 'opacity: 0.5; filter: grayscale(100%);' : '' %>">
                <h1 class="logo"><b>MULTI</b>player-Mode</h1>
                <p class="tagline">Enjoy quality time with your buddies playing PowerPoint-Karaoke <b>TOGETHER!</b></p>
                <p class="tagline">Play with <b>RANDOM</b> topics, so no one knows what awaits you...</p>
                <% if (it.user) { %>
                    <form class="main-form" action="/multi" method="get">
                        <div class="input-group">
                            <button type="submit">Play together!</button>
                        </div>
                    </form>
                <% } else { %>
                    <form class="main-form" style="pointer-events: none;">
                        <div class="input-group">
                            <button type="button" disabled style="cursor: not-allowed;">Play together!</button>
                        </div>
                    </form>
                <% } %>
            </div>
            <% if (!it.user) { %>
                <div class="restricted-container" style="text-align: center; padding: 2rem; background: #f8f9fa; border-radius: 10px; margin-top: 2rem;">
                    <p style="color: #666; font-size: 1.1rem; margin-bottom: 1.5rem;">MULTIplayer-Mode ist only available for registered users</p>
                    <div style="display: flex; gap: 1rem; justify-content: center;">
                        <a href="#" class="auth-button auth-button-login" onclick="openAuthModal('login'); return false;">
                            <span>Anmelden</span>
                            <svg width="15px" height="10px" viewBox="0 0 13 10">
                                <path d="M1,5 L11,5"></path>
                                <polyline points="8 1 12 5 8 9"></polyline>
                            </svg>
                        </a>
                        <a href="#" class="auth-button auth-button-register" onclick="openAuthModal('register'); return false;">
                            <span>Registrieren</span>
                            <svg width="15px" height="10px" viewBox="0 0 13 10">
                                <path d="M1,5 L11,5"></path>
                                <polyline points="8 1 12 5 8 9"></polyline>
                            </svg>
                        </a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<div class="container features-container">
    <div class="header">
        <h1 class="logo">Features</h1>
        <p class="tagline">Discover what makes FreestAIle special</p>
    </div>
    <div class="features">
        <div class="feature">
            <i class="fas fa-bolt"></i>
            <h3>Instant Creation</h3>
            <p>Get a full presentation in seconds, no preparation needed</p>
        </div>
        <div class="feature">
            <i class="fa-solid fa-face-laugh-squint"></i>
            <h3>Unpredictable Fun</h3>
            <p>Challenge yourself with surprising slides and content</p>
        </div>
        <div class="feature">
            <i class="fas fa-users"></i>
            <h3>Perfect for Groups</h3>
            <p>Ideal for team building and improv exercises</p>
        </div>
    </div>
    <footer>
        © 2025 FreestAIle | The ultimate AI-powered presentation karaoke
    </footer>
</div>

<!-- Modal für Login/Register -->
<div id="authModal" class="modal-overlay">
    <div class="modal-content">
        <button class="modal-close" onclick="closeAuthModal()">&times;</button>
        <div class="modal-tabs">
            <div class="modal-tab active" onclick="switchTab('login')">Anmelden</div>
            <div class="modal-tab" onclick="switchTab('register')">Registrieren</div>
        </div>
        
        <!-- Login Form -->
        <form id="modalLoginForm" class="modal-form active" onsubmit="handleModalLogin(event)">
            <div class="form-group">
                <label for="modalEmail">E-Mail</label>
                <input type="email" id="modalEmail" name="email" required>
            </div>
            <div class="form-group">
                <label for="modalPassword">Passwort</label>
                <input type="password" id="modalPassword" name="password" required>
            </div>
            <div class="error-message" id="modalLoginError" style="display: none;"></div>
            <div class="success-message" id="modalLoginSuccess" style="display: none; color: #4CAF50; margin-bottom: 1rem;"></div>
            <button type="submit" class="submit-button" style="background: #b1dae7;" disabled>Anmelden</button>
        </form>

        <!-- Register Form -->
        <form id="modalRegisterForm" class="modal-form" onsubmit="handleModalRegister(event)">
            <div class="form-group">
                <label for="modalRegisterEmail">E-Mail</label>
                <input type="email" id="modalRegisterEmail" name="email" required>
            </div>
            <div class="form-group">
                <label for="modalRegisterPassword">Passwort</label>
                <input type="password" id="modalRegisterPassword" name="password" required>
            </div>
            <div class="form-group">
                <label for="modalConfirmPassword">Passwort bestätigen</label>
                <input type="password" id="modalConfirmPassword" name="confirmPassword" required>
            </div>
            <div class="error-message" id="modalRegisterError" style="display: none;"></div>
            <button type="submit" class="submit-button" style="background: #b1e7c8;" disabled>Registrieren</button>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.getElementById('darkmode-toggle');
    
    // Get current dark mode status (already set by darkmode-init.js)
    const isDark = document.documentElement.classList.contains('darkmode');
    
    // Set toggle position based on current dark mode status
    toggle.checked = !isDark;
    
    // Ensure body also has the class for backward compatibility
    document.body.classList.toggle('darkmode', isDark);

    toggle.addEventListener('change', function() {
      const dark = !toggle.checked;
      document.documentElement.classList.toggle('darkmode', dark);
      document.body.classList.toggle('darkmode', dark);
      localStorage.setItem('darkmode', dark.toString());
    });
  });

    // Dynamic typing placeholder effect
    const topicInput = document.getElementById('topic');
    const placeholderElement = document.querySelector('.typing-placeholder');

    // List of placeholder suggestions
    const suggestions = [
        "The Socioeconomic Impact of Coco-Cola Zero",
        "Why Giraffes Don't Exist: A Conspiracy Theory",
        "Quantum Physics for Toddlers",
        "The Secret Life of Office Plants",
        "Time Travel and Its Effect on Retirement Planning"
    ];

    let currentText = "";
    let charIndex = 0;
    let suggestionIndex = 0;
    let typingInterval;
    let typing = true;
    let isPlaceholderActive = true;

    function typePlaceholder() {
        if (!isPlaceholderActive) return;
        
        if (charIndex < suggestions[suggestionIndex].length) {
            currentText += suggestions[suggestionIndex][charIndex];
            placeholderElement.innerHTML = currentText + '<span class="cursor"></span>';
            charIndex++;
        } else {
            typing = false;
            setTimeout(() => {
                if (isPlaceholderActive) {
                    typingInterval = setInterval(erasePlaceholder, 50);
                }
            }, 1000);
            clearInterval(typingInterval);
        }
    }

    function erasePlaceholder() {
        if (!isPlaceholderActive) return;
        
        if (charIndex > 0) {
            currentText = currentText.slice(0, -1);
            placeholderElement.innerHTML = currentText + '<span class="cursor"></span>';
            charIndex--;
        } else {
            suggestionIndex = (suggestionIndex + 1) % suggestions.length;
            typing = true;
            clearInterval(typingInterval);
            if (isPlaceholderActive) {
                typingInterval = setInterval(typePlaceholder, 100);
            }
        }
    }

    function startTypingCycle() {
        if (!isPlaceholderActive) return;
        
        clearInterval(typingInterval);
        currentText = "";
        charIndex = 0;
        typing = true;
        suggestionIndex = (suggestionIndex + 1) % suggestions.length;
        placeholderElement.innerHTML = '<span class="cursor"></span>';
        typingInterval = setInterval(typePlaceholder, 100);
    }

    function resetAndStartPlaceholder() {
        isPlaceholderActive = true;
        placeholderElement.style.display = 'block';
        clearInterval(typingInterval);
        currentText = "";
        charIndex = 0;
        typing = true;
        suggestionIndex = (suggestionIndex + 1) % suggestions.length;
        placeholderElement.innerHTML = '<span class="cursor"></span>';
        typingInterval = setInterval(typePlaceholder, 100);
    }

    // Handle Tab key press
    topicInput.addEventListener('keydown', (e) => {
        if (e.key === 'Tab') {
            e.preventDefault();
            topicInput.value = suggestions[suggestionIndex];
            isPlaceholderActive = false;
            placeholderElement.style.display = 'none';
            clearInterval(typingInterval);
            typingInterval = null;
            suggestionIndex = (suggestionIndex + 1) % suggestions.length;
        }
    });

    // Handle when user types or clears the input
    topicInput.addEventListener("input", () => {
        if (topicInput.value.length > 0) {
            isPlaceholderActive = false;
            clearInterval(typingInterval);
            typingInterval = null;
            placeholderElement.style.display = 'none';
        } else {
            resetAndStartPlaceholder();
        }
    });

    // Input hint visibility handling
    const inputHint = document.querySelector('.input-hint');
    
    topicInput.addEventListener('focus', () => {
        inputHint.style.display = 'block';
        // Entferne zuerst alle Animation-Klassen
        inputHint.classList.remove('fade-out');
        // Trigger reflow
        void inputHint.offsetWidth;
        // Füge die fade-in Animation hinzu
        inputHint.classList.add('fade-in');
        
        if (topicInput.value.length > 0) {
            isPlaceholderActive = false;
            placeholderElement.style.display = 'none';
        }
    });

    topicInput.addEventListener('blur', () => {
        // Entferne fade-in und füge fade-out hinzu
        inputHint.classList.remove('fade-in');
        inputHint.classList.add('fade-out');
        
        // Warte auf das Ende der Animation bevor wir das Element ausblenden
        setTimeout(() => {
            if (!topicInput.matches(':focus')) {  // Prüfe ob das Input noch fokussiert ist
                inputHint.style.display = 'none';
            }
        }, 300); // 300ms entspricht der Animationsdauer
    });

    // Start the initial typing effect
    suggestionIndex = 0;
    resetAndStartPlaceholder();

    // Modal Funktionen
    function openAuthModal(tab = 'login') {
        document.getElementById('authModal').style.display = 'flex';
        switchTab(tab);
    }

    function closeAuthModal() {
        document.getElementById('authModal').style.display = 'none';
        // Reset forms
        document.getElementById('modalLoginForm').reset();
        document.getElementById('modalRegisterForm').reset();
        document.getElementById('modalLoginError').style.display = 'none';
        document.getElementById('modalRegisterError').style.display = 'none';
    }

    function switchTab(tab) {
        // Update tabs
        document.querySelectorAll('.modal-tab').forEach(t => t.classList.remove('active'));
        document.querySelector(`.modal-tab[onclick="switchTab('${tab}')"]`).classList.add('active');
        
        // Update forms
        document.querySelectorAll('.modal-form').forEach(f => f.classList.remove('active'));
        document.getElementById(`modal${tab.charAt(0).toUpperCase() + tab.slice(1)}Form`).classList.add('active');
    }

    async function handleModalLogin(event) {
        event.preventDefault();
        const email = document.getElementById('modalEmail').value;
        const password = document.getElementById('modalPassword').value;
        const errorDiv = document.getElementById('modalLoginError');

        try {
            const response = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            });

            if (response.ok) {
                window.location.reload();
            } else {
                const error = await response.json();
                errorDiv.textContent = error.message || 'Anmeldung fehlgeschlagen';
                errorDiv.style.display = 'block';
            }
        } catch (error) {
            console.error('Login-Fehler:', error);
            errorDiv.textContent = 'Ein Fehler ist aufgetreten';
            errorDiv.style.display = 'block';
        }
    }

    async function handleModalRegister(event) {
        event.preventDefault();
        const email = document.getElementById('modalRegisterEmail').value;
        const password = document.getElementById('modalRegisterPassword').value;
        const confirmPassword = document.getElementById('modalConfirmPassword').value;
        const errorDiv = document.getElementById('modalRegisterError');

        if (password !== confirmPassword) {
            errorDiv.textContent = 'Die Passwörter stimmen nicht überein';
            errorDiv.style.display = 'block';
            return;
        }

        try {
            const response = await fetch('/api/auth/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            });

            if (response.ok) {
                // Nach erfolgreicher Registrierung zum Login-Tab wechseln
                switchTab('login');
                document.getElementById('modalEmail').value = email;
                errorDiv.style.display = 'none';
                document.getElementById('modalRegisterError').style.display = 'none';
                // Zeige Erfolgsmeldung
                const successDiv = document.getElementById('modalLoginSuccess');
                successDiv.textContent = 'Wenn Sie noch nicht registriert sind, haben Sie jetzt eine Bestätigungs-E-Mail erhalten.';
                successDiv.style.display = 'block';
            } else {
                const error = await response.json();
                errorDiv.textContent = error.message || 'Registrierung fehlgeschlagen';
                errorDiv.style.display = 'block';
            }
        } catch (error) {
            console.error('Registrierungs-Fehler:', error);
            errorDiv.textContent = 'Ein Fehler ist aufgetreten';
            errorDiv.style.display = 'block';
        }
    }

    // Event Listener für Login/Register Links
    document.addEventListener('DOMContentLoaded', function() {
        // Login Links
        document.querySelectorAll('a[href="/login"]').forEach(link => {
            link.href = '#';
            link.onclick = (e) => {
                e.preventDefault();
                openAuthModal('login');
            };
        });

        // Register Links
        document.querySelectorAll('a[href="/register"]').forEach(link => {
            link.href = '#';
            link.onclick = (e) => {
                e.preventDefault();
                openAuthModal('register');
            };
        });

        // Schließen des Modals bei Klick außerhalb
        document.getElementById('authModal').addEventListener('click', (e) => {
            if (e.target === document.getElementById('authModal')) {
                closeAuthModal();
            }
        });

        // Schließen des Modals mit Escape-Taste
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && document.getElementById('authModal').style.display === 'flex') {
                closeAuthModal();
            }
        });
    });

    // Form Submit Handler
    document.getElementById('quickModeForm').addEventListener('submit', function(e) {
        const containerWrapper = document.querySelector('.container-wrapper');
        const loadingAnimation = document.getElementById('loadingAnimation');
        const topicInput = document.getElementById('topic');
        const topicError = document.getElementById('topicError');
        const value = topicInput.value.trim();
        if (value.length < 3 || value.length > 50) {
            e.preventDefault();
            topicError.textContent = 'Topic must be between 3 and 50 characters.';
            topicError.style.display = 'block';
            topicInput.classList.add('error');
            return;
        } else {
            topicError.style.display = 'none';
            topicInput.classList.remove('error');
        }
        containerWrapper.classList.add('loading');
        loadingAnimation.style.display = 'block';
    });

    // Reset Button and Loading Animation when navigating back
    window.addEventListener('pageshow', function(event) {
        if (event.persisted) {
            const containerWrapper = document.querySelector('.container-wrapper');
            const loadingAnimation = document.getElementById('loadingAnimation');
            
            containerWrapper.classList.remove('loading');
            loadingAnimation.style.display = 'none';
        }
    });

    // Formular-Validierung für Login
    document.getElementById('modalLoginForm').addEventListener('input', function() {
        const email = document.getElementById('modalEmail').value;
        const password = document.getElementById('modalPassword').value;
        const submitButton = this.querySelector('.submit-button');
        
        if (email && password) {
            submitButton.classList.add('active');
            submitButton.disabled = false;
        } else {
            submitButton.classList.remove('active');
            submitButton.disabled = true;
        }
    });

    // Formular-Validierung für Register
    document.getElementById('modalRegisterForm').addEventListener('input', function() {
        const email = document.getElementById('modalRegisterEmail').value;
        const password = document.getElementById('modalRegisterPassword').value;
        const confirmPassword = document.getElementById('modalConfirmPassword').value;
        const submitButton = this.querySelector('.submit-button');
        
        if (email && password && confirmPassword) {
            submitButton.classList.add('active');
            submitButton.disabled = false;
        } else {
            submitButton.classList.remove('active');
            submitButton.disabled = true;
        }
    });

    // Enter-Taste Handler für Login
    document.getElementById('modalLoginForm').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            const email = document.getElementById('modalEmail').value;
            const password = document.getElementById('modalPassword').value;
            if (!email || !password) {
                e.preventDefault();
            }
        }
    });

    // Enter-Taste Handler für Register
    document.getElementById('modalRegisterForm').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            const email = document.getElementById('modalRegisterEmail').value;
            const password = document.getElementById('modalRegisterPassword').value;
            const confirmPassword = document.getElementById('modalConfirmPassword').value;
            if (!email || !password || !confirmPassword) {
                e.preventDefault();
            }
        }
    });

    // Initiale Validierung beim Laden
    document.addEventListener('DOMContentLoaded', function() {
        const loginForm = document.getElementById('modalLoginForm');
        const registerForm = document.getElementById('modalRegisterForm');
        
        if (loginForm) {
            const email = document.getElementById('modalEmail').value;
            const password = document.getElementById('modalPassword').value;
            const submitButton = loginForm.querySelector('.submit-button');
            
            if (email && password) {
                submitButton.classList.add('active');
                submitButton.disabled = false;
            } else {
                submitButton.disabled = true;
            }
        }
        
        if (registerForm) {
            const email = document.getElementById('modalRegisterEmail').value;
            const password = document.getElementById('modalRegisterPassword').value;
            const confirmPassword = document.getElementById('modalConfirmPassword').value;
            const submitButton = registerForm.querySelector('.submit-button');
            
            if (email && password && confirmPassword) {
                submitButton.classList.add('active');
                submitButton.disabled = false;
            } else {
                submitButton.disabled = true;
            }
        }
    });

    // Fehler verschwindet, sobald die Eingabe wieder gültig ist
    document.getElementById('topic').addEventListener('input', function() {
        const topicError = document.getElementById('topicError');
        if (this.value.trim().length >= 3 && this.value.trim().length <= 50) {
            topicError.style.display = 'none';
            this.classList.remove('error');
        }
    });
</script>
</body>
</html>