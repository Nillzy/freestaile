<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreestAIle - AI-Powered Presentation Karaoke</title>
    <!-- Dark mode initialization script - must be at the top to prevent flicker -->
    <script src="darkmode-init.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Ubuntu:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles/landing-page.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="styles/dashboardNew.css">
</head>

<header class="main-header">
    <div class="header-content">
        <a href="/" style="text-decoration: none; color: inherit;">
            <span class="header-logo">Freest<b>AI</b>le</span>
        </a>
        <div class="flex items-center space-x-4">
            <% if (it.user) { %>
                <!-- Eingeloggter Benutzer -->
                <div class="profile-container">
                    <a href="/user" style="text-decoration: none;">
                        <div class="profile-circle">
                            <%= it.user.email.charAt(0).toUpperCase() %>
                        </div>
                    </a>
                    <div class="profile-email"><%= it.user.email %></div>
                    <a href="#" class="auth-button auth-button-logout" onclick="(async function(e) { e.preventDefault(); try { const response = await fetch('/api/auth/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' } }); if (response.ok) window.location.reload(); } catch (error) { console.error('Logout-Fehler:', error); } })(event)">
                        <span>Abmelden</span>
                        <svg width="15px" height="10px" viewBox="0 0 13 10">
                            <path d="M1,5 L11,5"></path>
                            <polyline points="8 1 12 5 8 9"></polyline>
                        </svg>
                    </a>
                </div>
            <% } else { %>
                <!-- Nicht eingeloggter Benutzer -->
                <div class="auth-buttons">
                    <a href="#" class="auth-button auth-button-login" onclick="openAuthModal('login'); return false;">
                        <span>Anmelden</span>
                        <svg width="15px" height="10px" viewBox="0 0 13 10">
                            <path d="M1,5 L11,5"></path>
                            <polyline points="8 1 12 5 8 9"></polyline>
                        </svg>
                    </a>
                    <a href="#" class="auth-button auth-button-register" onclick="openAuthModal('register'); return false;">
                        <span>Registrieren</span>
                        <svg width="15px" height="10px" viewBox="0 0 13 10">
                            <path d="M1,5 L11,5"></path>
                            <polyline points="8 1 12 5 8 9"></polyline>
                        </svg>
                    </a>
                </div>
            <% } %>
            <label class="switch">
                <input id="darkmode-toggle" type="checkbox" />
                <span class="slider">
                    <span class="star star_1"></span>
                    <span class="star star_2"></span>
                    <span class="star star_3"></span>
                    <svg viewBox="0 0 16 16" class="cloud_1 cloud">
                        <path
                            transform="matrix(.77976 0 0 .78395-299.99-418.63)"
                            fill="#fff"
                            d="m391.84 540.91c-.421-.329-.949-.524-1.523-.524-1.351 0-2.451 1.084-2.485 2.435-1.395.526-2.388 1.88-2.388 3.466 0 1.874 1.385 3.423 3.182 3.667v.034h12.73v-.006c1.775-.104 3.182-1.584 3.182-3.395 0-1.747-1.309-3.186-2.994-3.379.007-.106.011-.214.011-.322 0-2.707-2.271-4.901-5.072-4.901-2.073 0-3.856 1.202-4.643 2.925"
                        ></path>
                    </svg>
                </span>
            </label>
        </div>
    </div>
</header>

<body>
<div class="container-wrapper">
    <div class="container">
        <div class="header">
            <h1 class="logo"><b>QUICK</b>mode</h1>
            <p class="tagline">Transform any topic into an AI-powered presentation adventure</p>
        </div>

        <form class="main-form" action="/present" method="get" id="quickModeForm">
            <div class="input-group">
                <label for="topic">Zu welchem Thema möchtest Du präsentieren?</label>
                <div class="input-wrapper">
                    <input type="text" name="topic" id="topic" autocomplete="off">
                    <div class="typing-placeholder"></div>
                </div>
                <div class="input-hint" style="display: none;">
                    <div class="input-hint-content">
                        <div class="input-hint-icon">
                            <i class="fas fa-lightbulb"></i>
                        </div>
                        <span>Drücke "Tab", um den Vorschlag anzunehmen</span>
                    </div>
                </div>
                <label for="presentationLanguage">Wähle die Sprache der Präsentation</label>
                <div class="input-wrapper">
                    <select name="presentationLanguage" id="presentationLanguage">
                        <option value="en">🇬🇧 English</option>
                        <option value="de">🇩🇪 Deutsch</option>
                        <option value="fr">🇫🇷 Français</option>
                        <option value="es">🇪🇸 Español</option>
                        <option value="it">🇮🇹 Italiano</option>
                        <option value="pt">🇵🇹 Português</option>
                        <option value="ru">🇷🇺 Русский</option>
                        <option value="zh">🇨🇳 中文</option>
                    </select>
                </div>
                <button type="submit" id="generateButton">
                    <i class="fas fa-magic"></i>
                    Generate Presentation
                </button>
                <div class="wheel-and-hamster" id="loadingAnimation" role="img" aria-label="Orange and tan hamster running in a metal wheel">
                    <div class="wheel"></div>
                    <div class="hamster">
                        <div class="hamster__body">
                            <div class="hamster__head">
                                <div class="hamster__ear"></div>
                                <div class="hamster__eye"></div>
                                <div class="hamster__nose"></div>
                            </div>
                            <div class="hamster__limb hamster__limb--fr"></div>
                            <div class="hamster__limb hamster__limb--fl"></div>
                            <div class="hamster__limb hamster__limb--br"></div>
                            <div class="hamster__limb hamster__limb--bl"></div>
                            <div class="hamster__tail"></div>
                        </div>
                    </div>
                    <div class="spoke"></div>
                </div>
            </div>
        </form>
    </div>

    <div class="container">
        <div class="header">
            <div class="multiplayer-section" style="position: relative; <%= !it.user ? 'opacity: 0.5; filter: grayscale(100%);' : '' %>">
                <h1 class="logo"><b>MULTI</b>player-Modus</h1>
                <p class="tagline">Mach' was mit Deiner Freizeit und spiele <b>zusammen</b> mit Deinen Freunden!</p>
                <% if (it.user) { %>
                    <form class="main-form" action="/multi" method="get">
                        <div class="input-group">
                            <button type="submit">Zusammen spielen!</button>
                        </div>
                    </form>
                <% } else { %>
                    <form class="main-form" style="pointer-events: none;">
                        <div class="input-group">
                            <button type="button" disabled style="cursor: not-allowed;">Zusammen spielen!</button>
                        </div>
                    </form>
                <% } %>
            </div>
            <% if (!it.user) { %>
                <div class="restricted-container">
                    <p style="color: #666; font-size: 1.1rem; margin-bottom: 1.5rem;">Der MULTIplayer-Modus ist nur für registrierte Nutzer verfügbar</p>
                    <div style="display: flex; gap: 1rem; justify-content: center;">
                        <a href="#" class="auth-button auth-button-login" onclick="openAuthModal('login'); return false;">
                            <span>Anmelden</span>
                            <svg width="15px" height="10px" viewBox="0 0 13 10">
                                <path d="M1,5 L11,5"></path>
                                <polyline points="8 1 12 5 8 9"></polyline>
                            </svg>
                        </a>
                        <a href="#" class="auth-button auth-button-register" onclick="openAuthModal('register'); return false;">
                            <span>Registrieren</span>
                            <svg width="15px" height="10px" viewBox="0 0 13 10">
                                <path d="M1,5 L11,5"></path>
                                <polyline points="8 1 12 5 8 9"></polyline>
                            </svg>
                        </a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<div class="container features-container">
    <div class="header">
        <h1 class="logo">Features</h1>
        <p class="tagline">Entdecken Sie, was FreestAIle so besonders macht</p>
    </div>
    <div class="features">
        <div class="feature">
            <i class="fas fa-bolt"></i>
            <h3>Sofortige Erstellung</h3>
            <p>Thema wählen, kurz warten und los geht's! Bekomme PowerPoint-Karaoke Präsentationen in Sekunden</p>
        </div>
        <div class="feature">
            <i class="fa-solid fa-face-laugh-squint"></i>
            <h3>Spaß vorprogrammiert!</h3>
            <p>Stelle Dich selbst neuen Herausforderungen mit zufällig generierten Slides für maximalen Spaß!</p>
        </div>
        <div class="feature">
            <i class="fas fa-users"></i>
            <h3>Bring' Deine Freunde mit!</h3>
            <p>Werdet ein Team oder spielt gegeneinander für gemeinsame Zeit auf höchstem Level!</p>
        </div>
    </div>
    <footer>
        © 2025 FreestAIle | Das ultimative Tool für PowerPoint-Karaoke
    </footer>
</div>

<!-- Modal für Login/Register -->
<div id="authModal" class="modal-overlay">
    <div class="modal-content">
        <button class="modal-close" onclick="closeAuthModal()">&times;</button>
        <div class="modal-tabs">
            <div class="modal-tab active" onclick="switchTab('login')">Anmelden</div>
            <div class="modal-tab" onclick="switchTab('register')">Registrieren</div>
        </div>
        
        <!-- Login Form -->
        <form id="modalLoginForm" class="modal-form active" onsubmit="handleModalLogin(event)">
            <div class="form-group">
                <label for="modalEmail">E-Mail</label>
                <input type="email" id="modalEmail" name="email" required>
            </div>
            <div class="form-group">
                <label for="modalPassword">Passwort</label>
                <input type="password" id="modalPassword" name="password" required>
            </div>
            <div class="error-message" id="modalLoginError" style="display: none;"></div>
            <div class="success-message" id="modalLoginSuccess" style="display: none; color: #4CAF50; margin-bottom: 1rem;"></div>
            <button type="submit" class="submit-button" style="background: #b1dae7;" disabled>Anmelden</button>
        </form>

        <!-- Register Form -->
        <form id="modalRegisterForm" class="modal-form" onsubmit="handleModalRegister(event)">
            <div class="form-group">
                <label for="modalRegisterEmail">E-Mail</label>
                <input type="email" id="modalRegisterEmail" name="email" required>
            </div>
            <div class="form-group">
                <label for="modalRegisterPassword">Passwort</label>
                <input type="password" id="modalRegisterPassword" name="password" required>
            </div>
            <div class="form-group">
                <label for="modalConfirmPassword">Passwort bestätigen</label>
                <input type="password" id="modalConfirmPassword" name="confirmPassword" required>
            </div>
            <div class="error-message" id="modalRegisterError" style="display: none;"></div>
            <button type="submit" class="submit-button" style="background: #b1e7c8;" disabled>Registrieren</button>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.getElementById('darkmode-toggle');
    
    // Get current dark mode status (already set by darkmode-init.js)
    const isDark = document.documentElement.classList.contains('darkmode');
    
    // Set toggle position based on current dark mode status
    toggle.checked = !isDark;
    
    // Ensure body also has the class for backward compatibility
    document.body.classList.toggle('darkmode', isDark);

    toggle.addEventListener('change', function() {
      const dark = !toggle.checked;
      document.documentElement.classList.toggle('darkmode', dark);
      document.body.classList.toggle('darkmode', dark);
      localStorage.setItem('darkmode', dark.toString());
    });
  });

    // Dynamic typing placeholder effect
    const topicInput = document.getElementById('topic');
    const placeholderElement = document.querySelector('.typing-placeholder');

    // List of placeholder suggestions
    const suggestions = [
        "The Socioeconomic Impact of Coco-Cola Zero",
        "Why Giraffes Don't Exist: A Conspiracy Theory",
        "Quantum Physics for Toddlers",
        "The Secret Life of Office Plants",
        "Time Travel and Its Effect on Retirement Planning"
    ];

    let currentText = "";
    let charIndex = 0;
    let suggestionIndex = 0;
    let typingInterval;
    let typing = true;
    let isPlaceholderActive = true;

    function typePlaceholder() {
        if (!isPlaceholderActive) return;
        
        if (charIndex < suggestions[suggestionIndex].length) {
            currentText += suggestions[suggestionIndex][charIndex];
            placeholderElement.innerHTML = currentText + '<span class="cursor"></span>';
            charIndex++;
        } else {
            typing = false;
            setTimeout(() => {
                if (isPlaceholderActive) {
                    typingInterval = setInterval(erasePlaceholder, 50);
                }
            }, 1000);
            clearInterval(typingInterval);
        }
    }

    function erasePlaceholder() {
        if (!isPlaceholderActive) return;
        
        if (charIndex > 0) {
            currentText = currentText.slice(0, -1);
            placeholderElement.innerHTML = currentText + '<span class="cursor"></span>';
            charIndex--;
        } else {
            suggestionIndex = (suggestionIndex + 1) % suggestions.length;
            typing = true;
            clearInterval(typingInterval);
            if (isPlaceholderActive) {
                typingInterval = setInterval(typePlaceholder, 100);
            }
        }
    }

    function startTypingCycle() {
        if (!isPlaceholderActive) return;
        
        clearInterval(typingInterval);
        currentText = "";
        charIndex = 0;
        typing = true;
        suggestionIndex = (suggestionIndex + 1) % suggestions.length;
        placeholderElement.innerHTML = '<span class="cursor"></span>';
        typingInterval = setInterval(typePlaceholder, 100);
    }

    function resetAndStartPlaceholder() {
        isPlaceholderActive = true;
        placeholderElement.style.display = 'block';
        clearInterval(typingInterval);
        currentText = "";
        charIndex = 0;
        typing = true;
        suggestionIndex = (suggestionIndex + 1) % suggestions.length;
        placeholderElement.innerHTML = '<span class="cursor"></span>';
        typingInterval = setInterval(typePlaceholder, 100);
    }

    // Handle Tab key press
    topicInput.addEventListener('keydown', (e) => {
        if (e.key === 'Tab') {
            e.preventDefault();
            topicInput.value = suggestions[suggestionIndex];
            isPlaceholderActive = false;
            placeholderElement.style.display = 'none';
            clearInterval(typingInterval);
            typingInterval = null;
            suggestionIndex = (suggestionIndex + 1) % suggestions.length;
        }
    });

    // Handle when user types or clears the input
    topicInput.addEventListener("input", () => {
        if (topicInput.value.length > 0) {
            isPlaceholderActive = false;
            clearInterval(typingInterval);
            typingInterval = null;
            placeholderElement.style.display = 'none';
        } else {
            resetAndStartPlaceholder();
        }
    });

    // Input hint visibility handling
    const inputHint = document.querySelector('.input-hint');
    
    topicInput.addEventListener('focus', () => {
        inputHint.style.display = 'block';
        // Entferne zuerst alle Animation-Klassen
        inputHint.classList.remove('fade-out');
        // Trigger reflow
        void inputHint.offsetWidth;
        // Füge die fade-in Animation hinzu
        inputHint.classList.add('fade-in');
        
        if (topicInput.value.length > 0) {
            isPlaceholderActive = false;
            placeholderElement.style.display = 'none';
        }
    });

    topicInput.addEventListener('blur', () => {
        // Entferne fade-in und füge fade-out hinzu
        inputHint.classList.remove('fade-in');
        inputHint.classList.add('fade-out');
        
        // Warte auf das Ende der Animation bevor wir das Element ausblenden
        setTimeout(() => {
            if (!topicInput.matches(':focus')) {  // Prüfe ob das Input noch fokussiert ist
                inputHint.style.display = 'none';
            }
        }, 300); // 300ms entspricht der Animationsdauer
    });

    // Start the initial typing effect
    suggestionIndex = 0;
    resetAndStartPlaceholder();

    // Modal Funktionen
    function openAuthModal(tab = 'login') {
        document.getElementById('authModal').style.display = 'flex';
        switchTab(tab);
    }

    function closeAuthModal() {
        document.getElementById('authModal').style.display = 'none';
        // Reset forms
        document.getElementById('modalLoginForm').reset();
        document.getElementById('modalRegisterForm').reset();
        document.getElementById('modalLoginError').style.display = 'none';
        document.getElementById('modalRegisterError').style.display = 'none';
    }

    function switchTab(tab) {
        // Update tabs
        document.querySelectorAll('.modal-tab').forEach(t => t.classList.remove('active'));
        document.querySelector(`.modal-tab[onclick="switchTab('${tab}')"]`).classList.add('active');
        
        // Update forms
        document.querySelectorAll('.modal-form').forEach(f => f.classList.remove('active'));
        document.getElementById(`modal${tab.charAt(0).toUpperCase() + tab.slice(1)}Form`).classList.add('active');
    }

    async function handleModalLogin(event) {
        event.preventDefault();
        const email = document.getElementById('modalEmail').value;
        const password = document.getElementById('modalPassword').value;
        const errorDiv = document.getElementById('modalLoginError');

        try {
            const response = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            });

            if (response.ok) {
                window.location.reload();
            } else {
                const error = await response.json();
                errorDiv.textContent = error.message || 'Anmeldung fehlgeschlagen';
                errorDiv.style.display = 'block';
            }
        } catch (error) {
            console.error('Login-Fehler:', error);
            errorDiv.textContent = 'Ein Fehler ist aufgetreten';
            errorDiv.style.display = 'block';
        }
    }

    async function handleModalRegister(event) {
        event.preventDefault();
        const email = document.getElementById('modalRegisterEmail').value;
        const password = document.getElementById('modalRegisterPassword').value;
        const confirmPassword = document.getElementById('modalConfirmPassword').value;
        const errorDiv = document.getElementById('modalRegisterError');

        if (password !== confirmPassword) {
            errorDiv.textContent = 'Die Passwörter stimmen nicht überein';
            errorDiv.style.display = 'block';
            return;
        }

        try {
            const response = await fetch('/api/auth/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            });

            if (response.ok) {
                // Nach erfolgreicher Registrierung zum Login-Tab wechseln
                switchTab('login');
                document.getElementById('modalEmail').value = email;
                errorDiv.style.display = 'none';
                document.getElementById('modalRegisterError').style.display = 'none';
                // Zeige Erfolgsmeldung
                const successDiv = document.getElementById('modalLoginSuccess');
                successDiv.textContent = 'Wenn Sie noch nicht registriert sind, haben Sie jetzt eine Bestätigungs-E-Mail erhalten.';
                successDiv.style.display = 'block';
            } else {
                const error = await response.json();
                errorDiv.textContent = error.message || 'Registrierung fehlgeschlagen';
                errorDiv.style.display = 'block';
            }
        } catch (error) {
            console.error('Registrierungs-Fehler:', error);
            errorDiv.textContent = 'Ein Fehler ist aufgetreten';
            errorDiv.style.display = 'block';
        }
    }

    // Event Listener für Login/Register Links
    document.addEventListener('DOMContentLoaded', function() {
        // Login Links
        document.querySelectorAll('a[href="/login"]').forEach(link => {
            link.href = '#';
            link.onclick = (e) => {
                e.preventDefault();
                openAuthModal('login');
            };
        });

        // Register Links
        document.querySelectorAll('a[href="/register"]').forEach(link => {
            link.href = '#';
            link.onclick = (e) => {
                e.preventDefault();
                openAuthModal('register');
            };
        });

        // Schließen des Modals bei Klick außerhalb
        document.getElementById('authModal').addEventListener('click', (e) => {
            if (e.target === document.getElementById('authModal')) {
                closeAuthModal();
            }
        });

        // Schließen des Modals mit Escape-Taste
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && document.getElementById('authModal').style.display === 'flex') {
                closeAuthModal();
            }
        });
    });

    // Form Submit Handler
    document.getElementById('quickModeForm').addEventListener('submit', function(e) {
        const containerWrapper = document.querySelector('.container-wrapper');
        const loadingAnimation = document.getElementById('loadingAnimation');
        
        containerWrapper.classList.add('loading');
        loadingAnimation.style.display = 'block';
    });

    // Reset Button and Loading Animation when navigating back
    window.addEventListener('pageshow', function(event) {
        if (event.persisted) {
            const containerWrapper = document.querySelector('.container-wrapper');
            const loadingAnimation = document.getElementById('loadingAnimation');
            
            containerWrapper.classList.remove('loading');
            loadingAnimation.style.display = 'none';
        }
    });

    // Formular-Validierung für Login
    document.getElementById('modalLoginForm').addEventListener('input', function() {
        const email = document.getElementById('modalEmail').value;
        const password = document.getElementById('modalPassword').value;
        const submitButton = this.querySelector('.submit-button');
        
        if (email && password) {
            submitButton.classList.add('active');
            submitButton.disabled = false;
        } else {
            submitButton.classList.remove('active');
            submitButton.disabled = true;
        }
    });

    // Formular-Validierung für Register
    document.getElementById('modalRegisterForm').addEventListener('input', function() {
        const email = document.getElementById('modalRegisterEmail').value;
        const password = document.getElementById('modalRegisterPassword').value;
        const confirmPassword = document.getElementById('modalConfirmPassword').value;
        const submitButton = this.querySelector('.submit-button');
        
        if (email && password && confirmPassword) {
            submitButton.classList.add('active');
            submitButton.disabled = false;
        } else {
            submitButton.classList.remove('active');
            submitButton.disabled = true;
        }
    });

    // Enter-Taste Handler für Login
    document.getElementById('modalLoginForm').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            const email = document.getElementById('modalEmail').value;
            const password = document.getElementById('modalPassword').value;
            if (!email || !password) {
                e.preventDefault();
            }
        }
    });

    // Enter-Taste Handler für Register
    document.getElementById('modalRegisterForm').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            const email = document.getElementById('modalRegisterEmail').value;
            const password = document.getElementById('modalRegisterPassword').value;
            const confirmPassword = document.getElementById('modalConfirmPassword').value;
            if (!email || !password || !confirmPassword) {
                e.preventDefault();
            }
        }
    });

    // Initiale Validierung beim Laden
    document.addEventListener('DOMContentLoaded', function() {
        const loginForm = document.getElementById('modalLoginForm');
        const registerForm = document.getElementById('modalRegisterForm');
        
        if (loginForm) {
            const email = document.getElementById('modalEmail').value;
            const password = document.getElementById('modalPassword').value;
            const submitButton = loginForm.querySelector('.submit-button');
            
            if (email && password) {
                submitButton.classList.add('active');
                submitButton.disabled = false;
            } else {
                submitButton.disabled = true;
            }
        }
        
        if (registerForm) {
            const email = document.getElementById('modalRegisterEmail').value;
            const password = document.getElementById('modalRegisterPassword').value;
            const confirmPassword = document.getElementById('modalConfirmPassword').value;
            const submitButton = registerForm.querySelector('.submit-button');
            
            if (email && password && confirmPassword) {
                submitButton.classList.add('active');
                submitButton.disabled = false;
            } else {
                submitButton.disabled = true;
            }
        }
    });
</script>
</body>
</html>