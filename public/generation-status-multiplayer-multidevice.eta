<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Multiplayer – FreestAIle</title>

    <!-- Google Fonts & Font Awesome Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* --- CSS Variables --- */
        :root, [data-theme="light"] {
            --bg-color: #F4F7FC;
            --text-color: #1a1a2e;
            --text-color-light: #6c757d;
            --card-bg: #FFFFFF;
            --header-bg: rgba(255, 255, 255, 0.7);
            --input-bg: #e9ecef;
            --primary-color: #5E60E7;
            --secondary-color: #43E69E;
            --accent-glow: rgba(67, 230, 158, 0.3);
            --shadow-color: rgba(0, 0, 0, 0.1);
        }

        [data-theme="dark"] {
            --bg-color: #2A2D3A;
            --text-color: #f0f0f0;
            --text-color-light: #a0aec0;
            --card-bg: #353849;
            --header-bg: rgba(42, 45, 58, 0.7);
            --input-bg: #2A2D3A;
            --primary-color: #5E60E7;
            --secondary-color: #43E69E;
            --accent-glow: rgba(67, 230, 158, 0.3);
            --shadow-color: rgba(0, 0, 0, 0.5);
        }

        /* --- Global Reset & Body --- */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Poppins', 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
            transition: background-color 0.3s ease, color 0.3s ease;
            overflow: hidden; /* Verhindert Scrollen auf Body-Ebene */
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        /* --- Animated Background --- */
        #particles-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; overflow: hidden; }
        .particle { position: absolute; background: linear-gradient(45deg, var(--primary-color), var(--secondary-color)); border-radius: 50%; opacity: 0; animation: rise 15s infinite linear; }
        @keyframes rise { 0% { transform: translateY(100vh) scale(0.5); opacity: 0.3; } 50% { opacity: 0.8; } 100% { transform: translateY(-10vh) scale(1); opacity: 0; } }

        /* --- Header --- */
        .main-header { position: fixed; top: 0; left: 0; width: 100%; padding: 0.5rem 2rem; z-index: 1000; background: var(--header-bg); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid rgba(255, 255, 255, 0.1); transition: background 0.3s ease; }
        .header-content { max-width: 1400px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
        .header-logo { font-size: 1.5rem; font-weight: 700; color: var(--text-color); text-decoration: none; }
        .header-logo b { background: linear-gradient(90deg, var(--primary-color), var(--secondary-color)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
        .header-nav { display: flex; align-items: center; gap: 1rem; }
        .dark-mode-toggle { cursor: pointer; font-size: 1.5rem; color: var(--text-color); opacity: 0.8; transition: all 0.3s ease; }
        .dark-mode-toggle:hover { opacity: 1; transform: scale(1.1) rotate(15deg); }
        .user-profile-link { text-decoration: none; color: inherit; border-radius: 50px; padding: 4px; transition: background-color 0.3s ease; margin-right: 0.5rem; }
        .user-profile-link:hover { background-color: rgba(255, 255, 255, 0.08); }
        .user-profile { display: flex; align-items: center; gap: 0.75rem; }
        .profile-avatar { width: 34px; height: 34px; border-radius: 50%; background-color: #F5A623; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 1rem; flex-shrink: 0; }

        /* --- Page-Specific Layout --- */
        .page-container {
            padding-top: 6rem; /* Platz für Header */
            display: flex;
            flex-grow: 1;
            gap: 1.5rem;
            max-width: 1400px;
            width: 100%;
            margin: 0 auto;
            padding-left: 1.5rem;
            padding-right: 1.5rem;
            padding-bottom: 1.5rem; /* KORRIGIERT: Abstand nach unten */
            overflow: hidden;
        }

        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            padding-right: 1rem; /* Platz für Scrollbar */
        }

        .page-header { text-align: center; margin-bottom: 1.5rem; flex-shrink: 0; }
        .page-header h1 { font-size: 2.5rem; font-weight: 700; margin-bottom: 0.25rem; }
        .page-header h1 b { background: linear-gradient(90deg, var(--primary-color), var(--secondary-color)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
        .page-header p { font-size: 1.1rem; opacity: 0.8; }

        .status-bar { padding: 0.75rem; border-radius: 8px; text-align: center; margin-bottom: 1.5rem; font-weight: 500; flex-shrink: 0; }
        .status-bar.connected { background-color: #d4edda; color: #155724; }
        [data-theme="dark"] .status-bar.connected { background-color: #1c3c24; color: #c3e6cb; }
        .status-bar.error { background-color: #f8d7da; color: #721c24; }
        [data-theme="dark"] .status-bar.error { background: #4a2124; color: #f5c6cb; }

        .generation-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
        .generation-card { background: var(--card-bg); border-radius: 15px; padding: 2rem 1.5rem; box-shadow: 0 4px 6px var(--shadow-color); text-align: center; display: flex; flex-direction: column; justify-content: space-between; }
        .generation-card h3 { font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem; }
        .status-icon { width: 12em; height: 12em; margin: 0.5rem auto 1.5rem; position: relative; font-size: 10px; }
        .view-button { display: inline-block; padding: 0.8rem 1.5rem; margin-top: 1rem; background: linear-gradient(90deg, var(--primary-color), var(--secondary-color)); color: #fff; border: none; border-radius: 50px; font-size: 1rem; font-weight: 600; cursor: pointer; text-decoration: none; transition: all 0.3s ease; opacity: 0; transform: translateY(10px) scale(0.9); pointer-events: none; }
        .view-button.show { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
        .view-button:hover { transform: translateY(-3px) scale(1.05); box-shadow: 0 8px 20px var(--accent-glow); }
        .checkmark-container { width: 100%; height: 100%; position: absolute; top: 0; left: 0; opacity: 0; transform: scale(0.5); transition: all 0.4s cubic-bezier(0.68, -0.55, 0.27, 1.55); display: flex; align-items: center; justify-content: center; }
        .checkmark-container.show { opacity: 1; transform: scale(1); }
        .checkmark-icon { font-size: 5rem; color: var(--secondary-color); }

        /* --- Chat Sidebar --- */
        .chat-sidebar { flex-basis: 380px; flex-shrink: 0; display: flex; flex-direction: column; background: var(--card-bg); border-radius: 15px; box-shadow: 0 4px 6px var(--shadow-color); overflow: hidden; }
        .chat-header { padding: 1rem 1.5rem; border-bottom: 1px solid var(--input-bg); font-weight: 600; font-size: 1.1rem; }
        .chat-messages { flex-grow: 1; overflow-y: auto; padding: 1rem 1.5rem; display: flex; flex-direction: column; gap: 1rem; }
        .chat-message { display: flex; flex-direction: column; max-width: 85%; }
        .chat-message .sender { font-weight: 600; font-size: 0.85rem; margin-bottom: 0.25rem; }
        .chat-message .content { padding: 0.6rem 1rem; border-radius: 12px; line-height: 1.5; word-wrap: break-word; }
        .chat-message.other { align-self: flex-start; }
        .chat-message.other .content { background: var(--input-bg); }
        .chat-message.other .sender { color: var(--primary-color); }
        .chat-message.own { align-self: flex-end; }
        .chat-message.own .content { background: var(--secondary-color); color: #1a1a2e; }
        .chat-message.own .sender { display: none; }
        .chat-message.system { align-self: center; font-size: 0.8rem; color: var(--text-color-light); font-style: italic; }
        .chat-input-area { padding: 1rem 1.5rem; border-top: 1px solid var(--input-bg); }
        .chat-form { display: flex; gap: 0.5rem; }
        .chat-input { flex-grow: 1; padding: 0.75rem 1rem; border-radius: 8px; border: none; background: var(--input-bg); color: var(--text-color); }
        .chat-input:focus { outline: none; box-shadow: 0 0 0 2px var(--primary-color); }
        .chat-send-button { background: var(--primary-color); color: #fff; border: none; border-radius: 8px; padding: 0 1rem; font-size: 1.1rem; cursor: pointer; transition: background-color 0.2s; }
        .chat-send-button:hover { background: #4a4aff; }

        /* --- Hamster Animation --- */
        .wheel-and-hamster { --dur: 1s; position: relative; width: 100%; height: 100%; }
        .wheel, .hamster, .hamster div, .spoke { position: absolute; }
        .wheel, .spoke { border-radius: 50%; top: 0; left: 0; width: 100%; height: 100%; }
        .wheel { background: radial-gradient(100% 100% at center,hsla(0,0%,60%,0) 47.8%,hsl(0,0%,60%) 48%); z-index: 2; }
        .hamster { animation: hamster var(--dur) ease-in-out infinite; top: 50%; left: calc(50% - 3.5em); width: 7em; height: 3.75em; transform: rotate(4deg) translate(-0.8em,1.85em); transform-origin: 50% 0; z-index: 1; }
        .hamster__head { animation: hamsterHead var(--dur) ease-in-out infinite; background: hsl(30,90%,55%); border-radius: 70% 30% 0 100% / 40% 25% 25% 60%; box-shadow: 0 -0.25em 0 hsl(30,90%,80%) inset, 0.75em -1.55em 0 hsl(30,90%,90%) inset; top: 0; left: -2em; width: 2.75em; height: 2.5em; transform-origin: 100% 50%; }
        .hamster__ear { animation: hamsterEar var(--dur) ease-in-out infinite; background: hsl(0,90%,85%); border-radius: 50%; box-shadow: -0.25em 0 hsl(30,90%,55%) inset; top: -0.25em; right: -0.25em; width: 0.75em; height: 0.75em; transform-origin: 50% 75%; }
        .hamster__eye { animation: hamsterEye var(--dur) linear infinite; background-color: hsl(0,0%,0%); border-radius: 50%; top: 0.375em; left: 1.25em; width: 0.5em; height: 0.5em; }
        .hamster__nose { background: hsl(0,90%,75%); border-radius: 35% 65% 85% 15% / 70% 50% 50% 30%; top: 0.75em; left: 0; width: 0.2em; height: 0.25em; }
        .hamster__body { animation: hamsterBody var(--dur) ease-in-out infinite; background: hsl(30,90%,90%); border-radius: 50% 30% 50% 30% / 15% 60% 40% 40%; box-shadow: 0.1em 0.75em 0 hsl(30,90%,55%) inset, 0.15em -0.5em 0 hsl(30,90%,80%) inset; top: 0.25em; left: 2em; width: 4.5em; height: 3em; transform-origin: 17% 50%; transform-style: preserve-3d; }
        .hamster__limb--fr, .hamster__limb--fl { clip-path: polygon(0 0,100% 0,70% 80%,60% 100%,0% 100%,40% 80%); top: 2em; left: 0.5em; width: 1em; height: 1.5em; transform-origin: 50% 0; }
        .hamster__limb--fr { animation: hamsterFRLimb var(--dur) linear infinite; background: linear-gradient(hsl(30,90%,80%) 80%,hsl(0,90%,75%) 80%); transform: rotate(15deg) translateZ(-1px); }
        .hamster__limb--fl { animation: hamsterFLLimb var(--dur) linear infinite; background: linear-gradient(hsl(30,90%,90%) 80%,hsl(0,90%,85%) 80%); transform: rotate(15deg); }
        .hamster__limb--br, .hamster__limb--bl { border-radius: 0.75em 0.75em 0 0; clip-path: polygon(0 0,100% 0,100% 30%,70% 90%,70% 100%,30% 100%,40% 90%,0% 30%); top: 1em; left: 2.8em; width: 1.5em; height: 2.5em; transform-origin: 50% 30%; }
        .hamster__limb--br { animation: hamsterBRLimb var(--dur) linear infinite; background: linear-gradient(hsl(30,90%,80%) 90%,hsl(0,90%,75%) 90%); transform: rotate(-25deg) translateZ(-1px); }
        .hamster__limb--bl { animation: hamsterBLLimb var(--dur) linear infinite; background: linear-gradient(hsl(30,90%,90%) 90%,hsl(0,90%,85%) 90%); transform: rotate(-25deg); }
        .hamster__tail { animation: hamsterTail var(--dur) linear infinite; background: hsl(0,90%,85%); border-radius: 0.25em 50% 50% 0.25em; box-shadow: 0 -0.2em 0 hsl(0,90%,75%) inset; top: 1.5em; right: -0.5em; width: 1em; height: 0.5em; transform: rotate(30deg) translateZ(-1px); transform-origin: 0.25em 0.25em; }
        .spoke { animation: spoke var(--dur) linear infinite; background: radial-gradient(100% 100% at center,hsl(0,0%,60%) 4.8%,hsla(0,0%,60%,0) 5%), linear-gradient(hsla(0,0%,55%,0) 46.9%,hsl(0,0%,65%) 47% 52.9%,hsla(0,0%,65%,0) 53%) 50% 50% / 99% 99% no-repeat; }
        @keyframes hamster { from, to { transform: rotate(4deg) translate(-0.8em,1.85em); } 50% { transform: rotate(0) translate(-0.8em,1.85em); } } @keyframes hamsterHead { from, 25%, 50%, 75%, to { transform: rotate(0); } 12.5%, 37.5%, 62.5%, 87.5% { transform: rotate(8deg); } } @keyframes hamsterEye { from, 90%, to { transform: scaleY(1); } 95% { transform: scaleY(0); } } @keyframes hamsterEar { from, 25%, 50%, 75%, to { transform: rotate(0); } 12.5%, 37.5%, 62.5%, 87.5% { transform: rotate(12deg); } } @keyframes hamsterBody { from, 25%, 50%, 75%, to { transform: rotate(0); } 12.5%, 37.5%, 62.5%, 87.5% { transform: rotate(-2deg); } } @keyframes hamsterFRLimb { from, 25%, 50%, 75%, to { transform: rotate(50deg) translateZ(-1px); } 12.5%, 37.5%, 62.5%, 87.5% { transform: rotate(-30deg) translateZ(-1px); } } @keyframes hamsterFLLimb { from, 25%, 50%, 75%, to { transform: rotate(-30deg); } 12.5%, 37.5%, 62.5%, 87.5% { transform: rotate(50deg); } } @keyframes hamsterBRLimb { from, 25%, 50%, 75%, to { transform: rotate(-60deg) translateZ(-1px); } 12.5%, 37.5%, 62.5%, 87.5% { transform: rotate(20deg) translateZ(-1px); } } @keyframes hamsterBLLimb { from, 25%, 50%, 75%, to { transform: rotate(20deg); } 12.5%, 37.5%, 62.5%, 87.5% { transform: rotate(-60deg); } } @keyframes hamsterTail { from, 25%, 50%, 75%, to { transform: rotate(30deg) translateZ(-1px); } 12.5%, 37.5%, 62.5%, 87.5% { transform: rotate(10deg) translateZ(-1px); } } @keyframes spoke { from { transform: rotate(0); } to { transform: rotate(-1turn); } }

        /* --- Responsive Design --- */
        @media (max-width: 1024px) {
            body { overflow: auto; height: auto; }
            .page-container { flex-direction: column; gap: 0; padding: 6rem 0 0 0; }
            .main-content { padding: 1rem; overflow: visible; }
            .chat-sidebar { flex-basis: auto; width: 100%; max-height: 40vh; border-radius: 0; border-top: 1px solid var(--input-bg); }
        }
        @media (max-width: 768px) { .header-content { padding: 1rem; } .main-header { padding: 0.5rem 0; } .profile-email { display: none; } }
    </style>
</head>

<body data-user-id="<%= it.userId %>">

<div id="particles-bg"></div>

<header class="main-header">
    <div class="header-content">
        <a href="/" style="text-decoration: none;"><span class="header-logo">Freest<b>AI</b>le</span></a>
        <div class="header-nav">
            <% if (it.user) { %>
            <a href="/user" class="user-profile-link"><div class="user-profile"><div class="profile-avatar"><%= it.user.email.charAt(0).toUpperCase() %></div></div></a>
            <% } %>
            <div class="dark-mode-toggle" id="theme-toggle" title="Toggle Theme"><i class="fa-solid fa-moon"></i></div>
        </div>
    </div>
</header>

<div class="page-container">
    <div class="main-content">
        <div class="page-header">
            <h1><b>Multiplayer</b> Mode</h1>
        </div>

        <div class="status-bar connected" id="status-bar">Connecting...</div>

        <div class="generation-grid">
            <% it.presentationIDs.forEach(function(presentationID, index) { %>
            <div class="generation-card" data-presentation-id="<%= presentationID %>">
                <h3><%= it.players[index].player %>'s Presentation</h3>
                <div class="status-icon">
                    <div class="wheel-and-hamster loading-animation" role="img" aria-label="Hamster running in a wheel">
                        <div class="wheel"></div>
                        <div class="hamster"><div class="hamster__body"><div class="hamster__head"><div class="hamster__ear"></div><div class="hamster__eye"></div><div class="hamster__nose"></div></div><div class="hamster__limb hamster__limb--fr"></div><div class="hamster__limb hamster__limb--fl"></div><div class="hamster__limb hamster__limb--br"></div><div class="hamster__limb hamster__limb--bl"></div><div class="hamster__tail"></div></div></div>
                        <div class="spoke"></div>
                    </div>
                    <div class="checkmark-container">
                        <i class="fas fa-circle-check checkmark-icon"></i>
                    </div>
                </div>
                <a href="/present3?presentationID=<%= presentationID %>&lobbyId=<%= it.lobbyId %>&userId=<%= it.userId %>&userName=<%= encodeURIComponent(it.userName) %>&isHost=<%= it.isHost %>"
                   class="view-button" target="_blank" rel="noopener noreferrer">
                    View Presentation
                </a>
            </div>
            <% }); %>
        </div>
    </div>

    <aside class="chat-sidebar">
        <div class="chat-header">💬 Live Chat</div>
        <div class="chat-messages" id="chat-messages">
            <!-- Chat messages will be dynamically inserted here -->
        </div>
        <div class="chat-input-area">
            <form class="chat-form" id="chat-form">
                <input type="text" class="chat-input" id="chat-input" placeholder="Enter message..." maxlength="500">
                <button type="submit" class="chat-send-button" id="chat-send-btn"><i class="fas fa-paper-plane"></i></button>
            </form>
        </div>
    </aside>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="/js/sse-client.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Dark Mode Logic
        const themeToggle = document.getElementById('theme-toggle');
        if (themeToggle) {
            const themeToggleIcon = themeToggle.querySelector('i');
            const htmlEl = document.documentElement;
            const setTheme = (theme) => { htmlEl.setAttribute('data-theme', theme); localStorage.setItem('theme', theme); if (themeToggleIcon) themeToggleIcon.className = theme === 'dark' ? 'fa-solid fa-moon' : 'fa-solid fa-sun'; };
            const savedTheme = localStorage.getItem('theme') || 'dark';
            setTheme(savedTheme);
            themeToggle.addEventListener('click', () => { const newTheme = htmlEl.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'; setTheme(newTheme); });
        }

        // Generation Status Check Logic
        const presentationIDsRaw = '<%= it.presentationIDs %>';
        const presentationIDs = presentationIDsRaw.split(',');
        const completedPresentations = new Set();
        let checkInterval;

        async function checkGenerationStatus() {
            if (completedPresentations.size === presentationIDs.length) { if (checkInterval) clearInterval(checkInterval); return; }
            for (const presentationID of presentationIDs) {
                if (completedPresentations.has(presentationID)) continue;
                try {
                    const response = await fetch(`/checkGenerationStatus`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ presentationID: presentationID }) });
                    if (!response.ok) { console.error(`Status check for ${presentationID} failed with status: ${response.status}`); continue; }
                    const data = await response.json();
                    const presentationItem = document.querySelector(`[data-presentation-id="${presentationID}"]`);
                    if (!presentationItem) continue;
                    const loadingAnimation = presentationItem.querySelector('.loading-animation');
                    const checkmark = presentationItem.querySelector('.checkmark-container');
                    const viewButton = presentationItem.querySelector('.view-button');
                    if (data.status === 'completed') {
                        completedPresentations.add(presentationID);
                        if (loadingAnimation) loadingAnimation.style.display = 'none';
                        if (checkmark) checkmark.classList.add('show');
                        if (viewButton) viewButton.classList.add('show');
                    } else if (data.status === 'error') { if (checkInterval) clearInterval(checkInterval); window.location.href = '/error-page?message=' + encodeURIComponent(data.message); return; }
                } catch (error) { console.error('Error checking status:', error); if (checkInterval) clearInterval(checkInterval); }
            }
        }

        checkGenerationStatus();
        checkInterval = setInterval(checkGenerationStatus, 2500);

        // Chat Logic
        const chatMessages = document.getElementById('chat-messages');
        const chatForm = document.getElementById('chat-form');
        const chatInput = document.getElementById('chat-input');
        const statusBar = document.getElementById('status-bar');

        function updateStatus(message, isError = false) {
            statusBar.textContent = message;
            statusBar.className = isError ? 'status-bar error' : 'status-bar connected';
        }

        function addChatMessage(sender, message, isOwn, isHost, isSystem = false) {
            const messageDiv = document.createElement('div');
            messageDiv.className = 'chat-message';
            if (isSystem) messageDiv.classList.add('system');
            else if (isOwn) messageDiv.classList.add('own');
            else { messageDiv.classList.add('other'); if (isHost) messageDiv.classList.add('host'); }

            messageDiv.innerHTML = `<span class="sender">${sender}</span><div class="content">${message}</div>`;
            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const message = chatInput.value.trim();
            if (!message || !realtimeClient || !realtimeClient.isConnected()) return;
            const result = await realtimeClient.sendChatMessage(message);
            if (result.success) chatInput.value = '';
            else updateStatus('Failed to send message.', true);
        });

        const matchData = { lobbyId: '<%= it.lobbyId %>', userId: '<%= it.userId %>', userName: '<%= it.userName %>', isHost: <%= it.isHost %> };
        let realtimeClient = null;

        async function initializeRealtime() {
            try {
                realtimeClient = new SupabaseRealtimeClient();
                realtimeClient.on('connect', () => updateStatus('Connected to live session.', false));
                realtimeClient.on('connect_error', (error) => updateStatus(`Connection error: ${error.message}`, true));
                realtimeClient.on('chatMessage', (data) => addChatMessage(data.userName, data.message, data.userId === matchData.userId, data.isHost));
                realtimeClient.on('playerJoined', (player) => addChatMessage('System', `${player.name} joined the session.`, false, false, true));
                realtimeClient.on('playerLeft', (player) => addChatMessage('System', `${player.name} left the session.`, false, false, true));
                await realtimeClient.connect(matchData.lobbyId, matchData.userId, matchData.userName, matchData.isHost);
            } catch (error) {
                console.error('Failed to initialize Realtime:', error);
                updateStatus('Failed to connect to live session.', true);
            }
        }
        initializeRealtime();
    });
</script>
</body>
</html>