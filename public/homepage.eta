<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreestAIle - PowerPoint Karaoke</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Ubuntu:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles/pages/Home-Page.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .cta {
            position: relative;
            margin: auto;
            padding: 12px 18px;
            transition: all 0.2s ease;
            border: none;
            background: none;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            min-width: 140px;
            justify-content: center;
        }

        .cta:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            display: block;
            border-radius: 50px;
            width: 45px;
            height: 45px;
            transition: all 0.3s ease;
            background: transparent;
        }

        /* Login Button (Standard blau) */
        .cta-login:before {
            background: #b1dae7;
        }
        .cta-login:hover:before {
            background: #b1dae7;
        }
        .cta-login span {
            color: #234567;
        }
        .cta-login svg {
            stroke: #234567;
        }

        /* Register Button (Grün) */
        .cta-register:before {
            background: #b1e7c8;
        }
        .cta-register:hover:before {
            background: #b1e7c8;
        }
        .cta-register span {
            color: #234567;
        }
        .cta-register svg {
            stroke: #234567;
        }

        /* Logout Button (Rot) */
        .cta-logout:before {
            background: #e7b1b1;
        }
        .cta-logout:hover:before {
            background: #e7b1b1;
        }
        .cta-logout span {
            color: #234567;
        }
        .cta-logout svg {
            stroke: #234567;
        }

        .cta span {
            position: relative;
            font-family: "Ubuntu", sans-serif;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.05em;
            white-space: nowrap;
        }

        .cta svg {
            position: relative;
            top: 0;
            margin-left: 10px;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke-width: 2;
            transform: translateX(-5px);
            transition: all 0.3s ease;
            flex-shrink: 0;
        }

        .cta:hover:before {
            width: 100%;
        }

        .cta:hover svg {
            transform: translateX(0);
        }

        .cta:active {
            transform: scale(0.95);
        }

        .cta, .cta-login, .cta-register, .cta-logout {
            background: none !important;
            border: none !important;
            box-shadow: none !important;
            text-decoration: none !important;
            outline: none !important;
        }

        .profile-circle {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: #b1dae7;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Ubuntu", sans-serif;
            font-size: 20px;
            font-weight: 700;
            color: #234567;
            transition: all 0.3s ease;
            flex-shrink: 0;
        }

        .profile-circle:hover {
            background: #9bc8d7;
            transform: scale(1.05);
        }

        .auth-buttons {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .profile-container {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-right: 1rem;
        }

        .profile-email {
            font-family: "Ubuntu", sans-serif;
            font-size: 16px;
            color: #234567;
            white-space: nowrap;
        }

        /* Basis-Styles für alle Buttons */
        .auth-button {
            position: relative;
            margin: auto;
            padding: 12px 18px;
            transition: all 0.2s ease;
            border: none;
            background: none;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

        .auth-button:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            display: block;
            border-radius: 50px;
            width: 45px;
            height: 45px;
            transition: all 0.3s ease;
        }

        .auth-button span {
            position: relative;
            font-family: "Ubuntu", sans-serif;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: #234567;
        }

        .auth-button svg {
            position: relative;
            top: 0;
            margin-left: 10px;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke: #234567;
            stroke-width: 2;
            transform: translateX(-5px);
            transition: all 0.3s ease;
        }

        .auth-button:hover:before {
            width: 100%;
        }

        .auth-button:hover svg {
            transform: translateX(0);
        }

        .auth-button:active {
            transform: scale(0.95);
        }

        /* Spezifische Styles für Login (blau) */
        .auth-button-login:before {
            background: #b1dae7;
        }
        .auth-button-login:hover:before {
            background: #b1dae7;
        }

        /* Spezifische Styles für Register (grün) */
        .auth-button-register:before {
            background: #b1e7c8;
        }
        .auth-button-register:hover:before {
            background: #b1e7c8;
        }

        /* Spezifische Styles für Logout (rot) */
        .auth-button-logout {
            position: relative;
            margin: auto;
            padding: 12px 18px;
            transition: all 0.2s ease;
            border: none;
            background: none;
            cursor: pointer;
        }

        .auth-button-logout:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            display: block;
            border-radius: 50px;
            background: #e7b1b1;
            width: 45px;
            height: 45px;
            transition: all 0.3s ease;
        }

        .auth-button-logout span {
            position: relative;
            font-family: "Ubuntu", sans-serif;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: #234567;
        }

        .auth-button-logout svg {
            position: relative;
            top: 0;
            margin-left: 10px;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke: #234567;
            stroke-width: 2;
            transform: translateX(-5px);
            transition: all 0.3s ease;
        }

        .auth-button-logout:hover:before {
            width: 100%;
            background: #e7b1b1;
        }

        .auth-button-logout:hover svg {
            transform: translateX(0);
        }

        .auth-button-logout:active {
            transform: scale(0.95);
        }

        /* Modal Styles */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(5px);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: #ffffff;
            padding: 2rem;
            border-radius: 10px;
            width: 90%;
            max-width: 400px;
            position: relative;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .modal-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: #666;
            padding: 0.5rem;
            line-height: 1;
        }

        .modal-close:hover {
            color: #333;
        }

        body.darkmode .modal-content {
            background: #2d2d2d;
            color: #ffffff;
        }

        body.darkmode .modal-close {
            color: #a0aec0;
        }

        body.darkmode .modal-close:hover {
            color: #ffffff;
        }

        .modal-tabs {
            display: flex;
            margin-bottom: 1.5rem;
            border-bottom: 2px solid #e2e8f0;
        }

        .modal-tab {
            padding: 0.5rem 1rem;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            margin-bottom: -2px;
            color: #666;
        }

        .modal-tab.active {
            color: #234567;
            border-bottom-color: #234567;
        }

        body.darkmode .modal-tab {
            color: #a0aec0;
        }

        body.darkmode .modal-tab.active {
            color: #ffffff;
            border-bottom-color: #ffffff;
        }

        .modal-form {
            display: none;
        }

        .modal-form.active {
            display: block;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: #234567;
        }

        .form-group input {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #e2e8f0;
            border-radius: 5px;
            font-size: 1rem;
        }

        body.darkmode .form-group label {
            color: #ffffff;
        }

        body.darkmode .form-group input {
            background: #1a1a1a;
            border-color: #4a5568;
            color: #ffffff;
        }

        .error-message {
            color: #e53e3e;
            margin-bottom: 1rem;
            font-size: 0.875rem;
        }

        .submit-button {
            width: 100%;
            padding: 0.75rem;
            border: none;
            border-radius: 5px;
            color: #234567;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .submit-button:hover {
            opacity: 0.9;
        }
    </style>
</head>

<header class="main-header">
  <div class="header-content">
    <a href="/" style="text-decoration: none;">
      <span class="header-logo">Freest<b>AI</b>le</span>
    </a>
    <div class="flex items-center space-x-4">
        <% if (it.user) { %>
            <!-- Eingeloggter Benutzer -->
            <div class="profile-container">
                <div class="profile-circle">
                    <%= it.user.email.charAt(0).toUpperCase() %>
                </div>
                <span class="profile-email"><%= it.user.email %></span>
                <a href="#" class="auth-button auth-button-logout" onclick="(async function(e) { e.preventDefault(); try { const response = await fetch('/api/auth/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' } }); if (response.ok) window.location.reload(); } catch (error) { console.error('Logout-Fehler:', error); } })(event)">
                    <span>Abmelden</span>
                    <svg width="15px" height="10px" viewBox="0 0 13 10">
                        <path d="M1,5 L11,5"></path>
                        <polyline points="8 1 12 5 8 9"></polyline>
                    </svg>
                </a>
            </div>
        <% } else { %>
            <!-- Nicht eingeloggter Benutzer -->
            <div class="auth-buttons">
                <a href="#" class="auth-button auth-button-login" onclick="openAuthModal('login'); return false;">
                    <span>Anmelden</span>
                    <svg width="15px" height="10px" viewBox="0 0 13 10">
                        <path d="M1,5 L11,5"></path>
                        <polyline points="8 1 12 5 8 9"></polyline>
                    </svg>
                </a>
                <a href="#" class="auth-button auth-button-register" onclick="openAuthModal('register'); return false;">
                    <span>Registrieren</span>
                    <svg width="15px" height="10px" viewBox="0 0 13 10">
                        <path d="M1,5 L11,5"></path>
                        <polyline points="8 1 12 5 8 9"></polyline>
                    </svg>
                </a>
            </div>
        <% } %>
        <label class="switch">
            <input id="darkmode-toggle" type="checkbox" />
            <span class="slider">
                <div class="star star_1"></div>
                <div class="star star_2"></div>
                <div class="star star_3"></div>
                <svg viewBox="0 0 16 16" class="cloud_1 cloud">
                    <path
                        transform="matrix(.77976 0 0 .78395-299.99-418.63)"
                        fill="#fff"
                        d="m391.84 540.91c-.421-.329-.949-.524-1.523-.524-1.351 0-2.451 1.084-2.485 2.435-1.395.526-2.388 1.88-2.388 3.466 0 1.874 1.385 3.423 3.182 3.667v.034h12.73v-.006c1.775-.104 3.182-1.584 3.182-3.395 0-1.747-1.309-3.186-2.994-3.379.007-.106.011-.214.011-.322 0-2.707-2.271-4.901-5.072-4.901-2.073 0-3.856 1.202-4.643 2.925"
                    ></path>
                </svg>
            </span>
        </label>
    </div>
  </div>
</header>

<body>
<div class="container-row">
    <div class="container">
        <div class="header">
            <h1 class="logo">Freest<b>AI</b>le</h1>
            <p class="tagline">PowerPoint Karaoke neu definiert – übe spontan, beeindrucke dein Publikum!</p>
        </div>
    </div>
    <div class="container">
        <form class="main-form" action="/main" method="get">
            <i class="fa-solid fa-rocket"></i>
            <div class="input-group" style="text-align:center;">
                <button type="submit">Freest<b>AI</b>le!</button>
            </div>
        </form>
    </div>
</div>
<div type="container">
    <div class="features">
        <div class="feature">
            <i class="fas fa-bolt"></i>
            <h3>Zufällige Slides</h3>
            <p>Erlebe die Spannung mit unvorhersehbaren Präsentationen</p>
        </div>
        <!-- <div class="feature">
            <i class="fas fa-clock"></i>
            <h3>Live-Timer</h3>
            <p>Perfektes Timing für deine Präsentation</p>
        </div> -->
        <!-- <div class="feature">
            <i class="fas fa-microphone"></i>
            <h3>Spracherkennung</h3>
            <p>Verbessere deine Rhetorik in Echtzeit</p>
        </div> -->
        <div class="feature">
            <i class="fas fa-question-circle"></i>
            <h3>Was ist PowerPoint Karaoke?</h3>
            <p>PowerPoint-Karaoke (auch bekannt als Battledecks) ist ein Improvisationsspiel, bei dem Teilnehmende eine zufällige PowerPoint-Präsentation vorführen müssen, ohne den Inhalt vorher zu kennen. Die Aufgabe besteht darin, die Folien spontan und möglichst überzeugend zu präsentieren, als hätten sie sie selbst vorbereitet.</p>
        </div>
        <div class="feature">
            <i class="fas fa-users"></i>
            <h3>Für wen ist FreestAIle?</h3>
            <p>Hier kannst du eine Zielgruppenbeschreibung einfügen.</p>
        </div>
        <div class="feature">
            <i class="fa-solid fa-gears"></i>
            <h2>So funktioniert FreestAIle</h2>
            <p>Hier deine Beschreibung...</p>
        </div>
    </div>
</div>
<div class="container">
    <footer style="margin-top:2rem;">
        © 2025 FreestAIle. Alle Rechte vorbehalten.
    </footer>
</div>

<!-- Modal für Login/Register -->
<div id="authModal" class="modal-overlay">
    <div class="modal-content">
        <button class="modal-close" onclick="closeAuthModal()">&times;</button>
        <div class="modal-tabs">
            <div class="modal-tab active" onclick="switchTab('login')">Anmelden</div>
            <div class="modal-tab" onclick="switchTab('register')">Registrieren</div>
        </div>
        
        <!-- Login Form -->
        <form id="modalLoginForm" class="modal-form active" onsubmit="handleModalLogin(event)">
            <div class="form-group">
                <label for="modalEmail">E-Mail</label>
                <input type="email" id="modalEmail" name="email" required>
            </div>
            <div class="form-group">
                <label for="modalPassword">Passwort</label>
                <input type="password" id="modalPassword" name="password" required>
            </div>
            <div class="error-message" id="modalLoginError" style="display: none;"></div>
            <button type="submit" class="submit-button" style="background: #b1dae7;">Anmelden</button>
        </form>

        <!-- Register Form -->
        <form id="modalRegisterForm" class="modal-form" onsubmit="handleModalRegister(event)">
            <div class="form-group">
                <label for="modalRegisterEmail">E-Mail</label>
                <input type="email" id="modalRegisterEmail" name="email" required>
            </div>
            <div class="form-group">
                <label for="modalRegisterPassword">Passwort</label>
                <input type="password" id="modalRegisterPassword" name="password" required>
            </div>
            <div class="form-group">
                <label for="modalConfirmPassword">Passwort bestätigen</label>
                <input type="password" id="modalConfirmPassword" name="confirmPassword" required>
            </div>
            <div class="error-message" id="modalRegisterError" style="display: none;"></div>
            <button type="submit" class="submit-button" style="background: #b1e7c8;">Registrieren</button>
        </form>
    </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.getElementById('darkmode-toggle');
    
    // Lade gespeicherten Darkmode-Status oder nutze System-Präferenz
    const savedDarkMode = localStorage.getItem('darkmode');
    const systemPrefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    const isDark = savedDarkMode !== null ? savedDarkMode === 'true' : systemPrefersDark;
    
    // Setze initialen Status
    document.body.classList.toggle('darkmode', isDark);
    toggle.checked = !isDark;

    toggle.addEventListener('change', function() {
      const dark = !toggle.checked;
      document.body.classList.toggle('darkmode', dark);
      localStorage.setItem('darkmode', dark.toString());
    });
  });

  // Modal Funktionen
  function openAuthModal(tab = 'login') {
    document.getElementById('authModal').style.display = 'flex';
    switchTab(tab);
  }

  function closeAuthModal() {
    document.getElementById('authModal').style.display = 'none';
    // Reset forms
    document.getElementById('modalLoginForm').reset();
    document.getElementById('modalRegisterForm').reset();
    document.getElementById('modalLoginError').style.display = 'none';
    document.getElementById('modalRegisterError').style.display = 'none';
  }

  function switchTab(tab) {
    // Update tabs
    document.querySelectorAll('.modal-tab').forEach(t => t.classList.remove('active'));
    document.querySelector(`.modal-tab[onclick="switchTab('${tab}')"]`).classList.add('active');
    
    // Update forms
    document.querySelectorAll('.modal-form').forEach(f => f.classList.remove('active'));
    document.getElementById(`modal${tab.charAt(0).toUpperCase() + tab.slice(1)}Form`).classList.add('active');
  }

  async function handleModalLogin(event) {
    event.preventDefault();
    const email = document.getElementById('modalEmail').value;
    const password = document.getElementById('modalPassword').value;
    const errorDiv = document.getElementById('modalLoginError');

    try {
        const response = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
        });

        if (response.ok) {
            window.location.reload(); // Seite neu laden statt Weiterleitung
        } else {
            const error = await response.json();
            errorDiv.textContent = error.message || 'Anmeldung fehlgeschlagen';
            errorDiv.style.display = 'block';
        }
    } catch (error) {
        console.error('Login-Fehler:', error);
        errorDiv.textContent = 'Ein Fehler ist aufgetreten';
        errorDiv.style.display = 'block';
    }
  }

  async function handleModalRegister(event) {
    event.preventDefault();
    const email = document.getElementById('modalRegisterEmail').value;
    const password = document.getElementById('modalRegisterPassword').value;
    const confirmPassword = document.getElementById('modalConfirmPassword').value;
    const errorDiv = document.getElementById('modalRegisterError');

    if (password !== confirmPassword) {
      errorDiv.textContent = 'Die Passwörter stimmen nicht überein';
      errorDiv.style.display = 'block';
      return;
    }

    try {
      const response = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password })
      });

      const data = await response.json();

      if (response.ok) {
        // Nach erfolgreicher Registrierung zum Login-Tab wechseln
        switchTab('login');
        document.getElementById('modalEmail').value = email;
        errorDiv.style.display = 'none';
        document.getElementById('modalRegisterError').style.display = 'none';
      } else {
        errorDiv.textContent = data.message || 'Registrierung fehlgeschlagen';
        errorDiv.style.display = 'block';
      }
    } catch (error) {
      console.error('Registrierungs-Fehler:', error);
      errorDiv.textContent = 'Ein Fehler ist aufgetreten';
      errorDiv.style.display = 'block';
    }
  }

  // Event Listener für Login/Register Links
  document.addEventListener('DOMContentLoaded', function() {
    // Login Links
    document.querySelectorAll('a[href="/login"]').forEach(link => {
      link.href = '#';
      link.onclick = (e) => {
        e.preventDefault();
        openAuthModal('login');
      };
    });

    // Register Links
    document.querySelectorAll('a[href="/register"]').forEach(link => {
      link.href = '#';
      link.onclick = (e) => {
        e.preventDefault();
        openAuthModal('register');
      };
    });

    // Schließen des Modals bei Klick außerhalb
    document.getElementById('authModal').addEventListener('click', (e) => {
      if (e.target === document.getElementById('authModal')) {
        closeAuthModal();
      }
    });

    // Schließen des Modals mit Escape-Taste
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && document.getElementById('authModal').style.display === 'flex') {
        closeAuthModal();
      }
    });
  });
</script>
</body>
</html> 