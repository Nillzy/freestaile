<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreestAIle - AI-Powered Presentation Karaoke</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #4338ca;
            --secondary: #10b981; /* Grün für "lucky" Button */
            --secondary-dark: #0f9d72; /* Dunkleres Grün für Hover */
            --dark: #1e293b;
            --light: #f8fafc;
            --gray: #64748b;
            --accent: #3b82f6; /* Wird für den Glow-Effekt verwendet */
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #f6f8ff 0%, #f0f4ff 100%);
            color: var(--dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .container {
            max-width: 900px;
            width: 100%;
            background-color: white;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            padding: 3rem;
            text-align: center;
            position: relative;
            animation: fadeInUp 0.8s ease-out forwards;
        }

        .header {
            margin-bottom: 2rem;
        }

        .logo {
            font-size: 3rem;
            font-weight: 700;
            background: linear-gradient(90deg, var(--primary) 0%, var(--secondary) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            display: inline-block;
            margin-bottom: 0.5rem;
        }

        .logo b {
            color: var(--secondary);
        }

        .tagline {
            font-size: 1.25rem;
            color: var(--gray);
            margin-bottom: 2rem;
        }

        .main-form {
            max-width: 600px;
            margin: 0 auto;
        }

        .input-group {
            margin-bottom: 1rem;
            text-align: left;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            font-size: 1.1rem;
        }

        .input-wrapper {
            position: relative;
            margin-bottom: 0.75rem;
        }

        input[type="text"] {
            width: 100%;
            padding: 1rem 1.25rem;
            font-size: 1.1rem;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

        input[type="text"]:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.2);
        }

        .typing-placeholder {
             display: none;
        }

        /* --- Button Container --- */
        .button-container {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 1rem;
            margin-top: 1.5rem;
            flex-wrap: wrap;
        }

        /* --- Allgemeiner Button Style (angepasst) --- */
        .btn {
            border: none;
            width: auto;
            min-width: 13em;
            padding: 0 1.5em;
            height: 3.8em;
            border-radius: 3em;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            cursor: pointer;
            transition: all 450ms ease-in-out;
            font-size: 0.95rem;
        }

        .btn .sparkle { /* Gilt für beide SVGs mit dieser Klasse */
            transition: all 800ms ease;
            width: 24px; /* Sicherstellen, dass beide Icons dieselbe Größe haben */
            height: 24px;
        }

        .btn .text {
            font-weight: 600;
            font-size: inherit;
            transition: color 450ms ease-in-out;
        }

        .btn:hover {
            transform: translateY(-2px);
        }

        .btn:hover .text {
            color: white;
        }

        .btn:hover .sparkle {
            fill: white;
            transform: scale(1.2);
        }

        /* --- Spezifischer Style für Generate Button (Primärfarben) --- */
        .btn.btn-generate {
            background: linear-gradient(0deg, var(--primary), var(--primary));
        }
        .btn.btn-generate .sparkle {
            fill: var(--light);
        }
        .btn.btn-generate .text {
            color: var(--light);
        }
        .btn.btn-generate:hover {
            background: linear-gradient(0deg, var(--primary-dark), var(--primary));
            box-shadow: inset 0px 1px 0px 0px rgba(255, 255, 255, 0.4),
                        inset 0px -4px 0px 0px rgba(0, 0, 0, 0.2),
                        0px 0px 0px 4px rgba(255, 255, 255, 0.2),
                        0px 0px 180px 0px var(--accent);
        }

        /* --- Spezifischer Style für Lucky Button (Sekundärfarben) --- */
        .btn.btn-lucky {
            background: linear-gradient(0deg, var(--secondary), var(--secondary));
        }
        .btn.btn-lucky .sparkle {
            fill: var(--light);
        }
        .btn.btn-lucky .text {
            color: var(--light);
        }
        .btn.btn-lucky:hover {
            background: linear-gradient(0deg, var(--secondary-dark), var(--secondary));
            box-shadow: inset 0px 1px 0px 0px rgba(255, 255, 255, 0.4),
                        inset 0px -4px 0px 0px rgba(0, 0, 0, 0.2),
                        0px 0px 0px 4px rgba(255, 255, 255, 0.2),
                        0px 0px 180px 0px var(--secondary-dark);
        }


        .features {
            display: flex;
            justify-content: space-around;
            margin-top: 3rem;
            flex-wrap: wrap;
            gap: 1.5rem;
        }

        .feature {
            flex: 1;
            min-width: 200px;
            padding: 1.5rem;
            text-align: center;
        }

        .feature i {
            font-size: 2rem;
            color: var(--primary);
            margin-bottom: 1rem;
        }

        .feature h3 {
            margin-bottom: 0.5rem;
            font-size: 1.2rem;
        }

        .feature p {
            color: var(--gray);
            font-size: 0.95rem;
        }

        footer {
            margin-top: 2rem;
            color: var(--gray);
            font-size: 0.9rem;
        }

        .decoration {
            position: absolute;
            border-radius: 50%;
            opacity: 0.1;
        }

        .d1 {
            width: 300px;
            height: 300px;
            background: var(--secondary);
            top: -100px;
            right: -100px;
        }

        .d2 {
            width: 200px;
            height: 200px;
            background: var(--primary);
            bottom: -50px;
            left: -80px;
        }

        @media (max-width: 768px) {
            .container {
                padding: 2rem 1.5rem;
            }
            .logo {
                font-size: 2.5rem;
            }
            .feature {
                min-width: 100%;
            }
            .btn {
                min-width: 100%;
                margin-bottom: 0.5rem;
            }
            .button-container {
                gap: 0.5rem;
            }
        }

        /* --- Inline Suggestions --- */
        .inline-suggestions-container {
            width: 100%;
            height: 40px;
            margin-top: 0.25rem;
            background: rgba(240, 244, 255, 0.7);
            border-radius: 8px;
            overflow: hidden;
            display: flex;
            align-items: center;
            position: relative;
        }

        .suggestions-track {
            display: flex;
            white-space: nowrap;
            animation: scrollSuggestions 120s linear infinite;
        }

        .suggestions-track:hover {
            animation-play-state: paused;
        }

        .suggestion-item {
            display: inline-block;
            padding: 6px 15px;
            margin: 0 8px;
            background-color: var(--primary);
            color: white;
            border-radius: 15px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.2s ease;
            white-space: nowrap;
        }

        .suggestion-item:hover {
            background-color: var(--primary-dark);
            transform: translateY(-1px);
        }

        @keyframes scrollSuggestions {
            0% {
                transform: translateX(0%);
            }
            100% {
                transform: translateX(-50%);
            }
        }
        /* --- ENDE: Inline Suggestions --- */

    </style>
</head>

<body>
<div class="container">
    <div class="decoration d1"></div>
    <div class="decoration d2"></div>

    <div class="header">
        <h1 class="logo">Freest<b>AI</b>le</h1>
        <p class="tagline">Transform any topic into an AI-powered presentation adventure</p>
    </div>

    <form class="main-form" action="/present" method="get" id="presentationForm">
        <div class="input-group">
            <label for="topic">What should your presentation be about?</label>
            <div class="input-wrapper">
                <input type="text" name="topic" id="topic" autocomplete="off" placeholder="Type a topic or click a suggestion...">
                <div class="typing-placeholder"></div>
            </div>
            <div class="inline-suggestions-container" id="inlineSuggestionsContainer">
                <div class="suggestions-track" id="suggestionsTrack">
                    <!-- Vorschläge werden hier per JavaScript eingefügt -->
                </div>
            </div>

            <div class="button-container">
                <button class="btn btn-generate" type="submit">
                    <svg height="24" width="24" viewBox="0 0 24 24" data-name="Layer 1" id="Layer_1" class="sparkle">
                        <path d="M10,21.236,6.755,14.745.264,11.5,6.755,8.255,10,1.764l3.245,6.491L19.736,11.5l-6.491,3.245ZM18,21l1.5,3L21,21l3-1.5L21,18l-1.5-3L18,18l-3,1.5ZM19.333,4.667,20.5,7l1.167-2.333L24,3.5,21.667,2.333,20.5,0,19.333,2.333,17,3.5Z"></path>
                    </svg>
                    <span class="text">Generate Presentation</span>
                </button>

                <a href="/present?topic=RANDOM" class="btn btn-lucky">
                    <svg class="sparkle" width="24" height="24" viewBox="0 0 24 24">
                      <path d="M12 3C7.03 3 3 7.03 3 12S7.03 21 12 21 21 16.97 21 12 16.97 3 12 3M12 19C8.13 19 5 15.87 5 12S8.13 5 12 5 19 8.13 19 12 15.87 19 12 19M12 6.5C9.24 6.5 6.89 8.07 5.83 10.25L12 12.75L18.17 10.25C17.11 8.07 14.76 6.5 12 6.5M17.5 12C17.5 14.76 15.93 17.11 13.75 18.17L11.25 12L13.75 5.83C15.93 6.89 17.5 9.24 17.5 12M6.5 12C6.5 9.24 8.07 6.89 10.25 5.83L12.75 12L10.25 18.17C8.07 17.11 6.5 14.76 6.5 12Z"/>
                    </svg>
                    <span class="text">I'm feeling lucky</span>
                </a>
            </div>
        </div>
    </form>

    <div class="features">
        <div class="feature">
            <i class="fas fa-bolt"></i>
            <h3>Instant Creation</h3>
            <p>Get a full presentation in seconds, no preparation needed</p>
        </div>
        <div class="feature">
            <i class="fas fa-random"></i>
            <h3>Unpredictable Fun</h3>
            <p>Challenge yourself with surprising slides and content</p>
        </div>
        <div class="feature">
            <i class="fas fa-users"></i>
            <h3>Perfect for Groups</h3>
            <p>Ideal for team building and improv exercises</p>
        </div>
    </div>

    <footer>
        © 2025 FreestAIle | The ultimate AI-powered presentation karaoke
    </footer>
</div>

<script>
    const topicInput = document.getElementById('topic');
    const suggestionsContainer = document.getElementById('inlineSuggestionsContainer');
    const suggestionsTrack = document.getElementById('suggestionsTrack');

    const suggestions = [
        "The Secret Life of Garden Gnomes", "Why Cats Secretly Rule the Internet", "The History of Spoons",
        "If Animals Could Talk, What Would They Complain About?", "The Art of Competitive Napping",
        "My Plan for World Domination (Through Kindness)", "Unicorns: Myth or Just Very Shy Horses?",
        "The Philosophy of Pizza Toppings", "Time Travel for Dummies", "How to Explain Memes to Your Grandparents",
        "The Socioeconomic Impact of Avocado Toast", "Surviving a Zombie Apocalypse with Office Supplies",
        "The Future of Invisibility Cloaks", "Why Socks Disappear in the Laundry: A Scientific Study",
        "Alien Abduction Etiquette", "The Importance of a Good Villain Monologue", "If Vegetables Had Social Media",
        "The Dangers of Talking Squirrels", "How to Train Your Dragon (Politely)", "The Hidden Talents of Sloths",
        "A Brief History of Bad Hair Days", "Quantum Physics and Rubber Ducks", "The Conspiracy of Left-Handed Scissors",
        "Interpreting a Dog's Dreams", "Why Pigeons Make Great Spies", "The Benefits of Talking to Plants",
        "If Clouds Had Feelings", "The Official Rules of Pillow Fighting", "My Adventures as a Part-Time Cloud Watcher"
    ];

    function populateSuggestions() {
        suggestionsTrack.innerHTML = '';
        const allSuggestions = [...suggestions, ...suggestions];
        allSuggestions.forEach(text => {
            const item = document.createElement('div');
            item.classList.add('suggestion-item');
            item.textContent = text;
            item.addEventListener('click', () => {
                topicInput.value = text;
                topicInput.focus();
            });
            suggestionsTrack.appendChild(item);
        });
    }

    populateSuggestions();

</script>
</body>
</html>