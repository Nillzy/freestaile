<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreestAIle - Multiplayer Lobby</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Ubuntu:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f8f9fa;
            color: #333;
        }
        
        .main-header {
            background-color: #fff;
            padding: 1rem 2rem;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .header-logo {
            font-family: 'Ubuntu', sans-serif;
            font-size: 1.5rem;
            color: #234567;
        }
        
        .lobby-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }
        
        .lobby-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }
        
        .qr-section {
            display: flex;
            gap: 2rem;
            margin-bottom: 2rem;
        }
        
        .qr-code {
            width: 200px;
            height: 200px;
            background: #fff;
            padding: 1rem;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        .qr-code img {
            width: 100%;
            height: 100%;
        }
        
        .join-info {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        
        .join-url {
            font-family: 'Ubuntu', sans-serif;
            font-size: 1.2rem;
            background: #f5f5f5;
            padding: 0.5rem 1rem;
            border-radius: 5px;
            margin-bottom: 1rem;
            word-break: break-all;
        }
        
        .copy-url-btn {
            background: #b1dae7;
            border: none;
            border-radius: 5px;
            padding: 0.5rem 1rem;
            font-family: 'Ubuntu', sans-serif;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            max-width: fit-content;
        }
        
        .copy-url-btn:hover {
            background: #9bc8d7;
        }
        
        .player-list {
            margin-top: 2rem;
        }
        
        .player-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 1rem;
        }
        
        .player-card {
            background: #fff;
            border-radius: 10px;
            padding: 1rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .player-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #b1dae7;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Ubuntu', sans-serif;
            font-size: 1.2rem;
            font-weight: 700;
            color: #234567;
        }
        
        .player-info {
            flex-grow: 1;
        }
        
        .player-name {
            font-family: 'Ubuntu', sans-serif;
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 0.25rem;
        }
        
        .player-status {
            font-size: 0.9rem;
            color: #666;
        }
        
        .start-button {
            background: #b1e7c8;
            border: none;
            border-radius: 50px;
            padding: 0.75rem 2rem;
            font-family: 'Ubuntu', sans-serif;
            font-weight: 700;
            font-size: 1.2rem;
            color: #234567;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 2rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        .start-button:hover {
            background: #9fd6b6;
            transform: translateY(-2px);
        }
        
        .start-button:disabled {
            background: #e0e0e0;
            color: #999;
            cursor: not-allowed;
            transform: none;
        }
        
        .waiting-message {
            text-align: center;
            margin-top: 2rem;
            font-family: 'Ubuntu', sans-serif;
            font-size: 1.2rem;
            color: #666;
        }

        @media (max-width: 768px) {
            .qr-section {
                flex-direction: column;
                align-items: center;
            }
            
            .join-info {
                align-items: center;
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <header class="main-header">
        <a href="/" style="text-decoration: none;">
            <span class="header-logo">Freest<b>AI</b>le</span>
        </a>
    </header>
    
    <main class="lobby-container">
        <div class="lobby-header">
            <h1>Multiplayer Lobby</h1>
            <div class="lobby-id">Lobby-ID: <strong><%= it.lobbyId %></strong></div>
        </div>
        
        <div class="qr-section">
            <div class="qr-code">
                <img src="<%= it.qrCode %>" alt="QR-Code zum Beitreten">
            </div>
            
            <div class="join-info">
                <h2>Lade Spieler ein!</h2>
                <p>Teile diesen QR-Code oder den Link unten, damit andere Spieler beitreten können:</p>
                
                <div class="join-url"><%= it.joinUrl %></div>
                
                <button class="copy-url-btn" id="copyUrlBtn">
                    <i class="fas fa-copy"></i> Link kopieren
                </button>
            </div>
        </div>
        
        <div class="player-list">
            <h2>Teilnehmer (<span id="playerCount">0</span>)</h2>
            
            <div class="player-grid" id="playerGrid">
                <!-- Spieler werden hier dynamisch eingefügt -->
            </div>
        </div>
        
        <% if (it.isHost) { %>
            <button class="start-button" id="startButton" disabled>
                <i class="fas fa-play"></i> Präsentation starten
            </button>
        <% } else { %>
            <div class="waiting-message">
                Warte auf den Host, um die Präsentation zu starten...
            </div>
        <% } %>
    </main>
    
    <script src="https://cdn.socket.io/4.6.0/socket.io.min.js"></script>
    <script src="/multiplayer/client/socket-client.js"></script>
    <script>
        // Lobby-Daten
        const lobbyId = '<%= it.lobbyId %>';
        const isHost = <%= it.isHost %>;
        
        // UI-Elemente
        const playerGrid = document.getElementById('playerGrid');
        const playerCount = document.getElementById('playerCount');
        const startButton = document.getElementById('startButton');
        const copyUrlBtn = document.getElementById('copyUrlBtn');
        
        // Spieler anzeigen
        function renderPlayers(players) {
            playerGrid.innerHTML = '';
            playerCount.textContent = players.length;
            
            players.forEach(player => {
                const initials = player.name.split(' ')
                    .map(n => n[0])
                    .join('')
                    .toUpperCase()
                    .substring(0, 2);
                
                const playerCard = document.createElement('div');
                playerCard.className = 'player-card';
                playerCard.dataset.playerId = player.id;
                
                playerCard.innerHTML = `
                    <div class="player-avatar">${initials}</div>
                    <div class="player-info">
                        <div class="player-name">${player.name}</div>
                        <div class="player-status">Bereit</div>
                    </div>
                `;
                
                playerGrid.appendChild(playerCard);
            });
            
            // Start-Button aktivieren, wenn mindestens ein Spieler verbunden ist
            if (startButton) {
                startButton.disabled = players.length === 0;
            }
        }
        
        // URL kopieren
        copyUrlBtn.addEventListener('click', () => {
            navigator.clipboard.writeText('<%= it.joinUrl %>');
            copyUrlBtn.innerHTML = '<i class="fas fa-check"></i> Kopiert!';
            
            setTimeout(() => {
                copyUrlBtn.innerHTML = '<i class="fas fa-copy"></i> Link kopieren';
            }, 2000);
        });
        
        // Multiplayer-Client initialisieren
        document.addEventListener('DOMContentLoaded', async () => {
            try {
                await window.multiplayerClient.connect();
                
                // Event-Handler registrieren
                window.multiplayerClient.on('playerJoined', (playerInfo) => {
                    renderPlayers(window.multiplayerClient.players);
                });
                
                window.multiplayerClient.on('playerLeft', (playerInfo) => {
                    renderPlayers(window.multiplayerClient.players);
                });
                
                window.multiplayerClient.on('presentationStarted', () => {
                    window.location.href = `/presentation/${lobbyId}`;
                });
                
                window.multiplayerClient.on('lobbyEnded', (reason) => {
                    alert(`Die Lobby wurde geschlossen: ${reason.reason}`);
                    window.location.href = '/';
                });
                
                // Als Host automatisch der Lobby beitreten
                if (isHost) {
                    const response = await window.multiplayerClient.createLobby();
                    console.log('Lobby erstellt:', response);
                    
                    // Start-Button-Funktionalität
                    startButton.addEventListener('click', () => {
                        window.multiplayerClient.startPresentation();
                    });
                }
                
                // Initiale Spielerliste rendern
                renderPlayers(window.multiplayerClient.players);
                
            } catch (error) {
                console.error('Fehler beim Initialisieren des Multiplayer-Clients:', error);
                alert(`Fehler: ${error.message}`);
            }
        });
        
        // Beim Verlassen der Seite Verbindung trennen
        window.addEventListener('beforeunload', () => {
            window.multiplayerClient.disconnect();
        });
    </script>
</body>
</html> 