<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreestAIle - Anmelden</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Ubuntu:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles/pages/Home-Page.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Basis-Styles für alle Buttons */
        .auth-button {
            position: relative;
            margin: auto;
            padding: 12px 18px;
            transition: all 0.2s ease;
            border: none;
            background: none;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

        .auth-button:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            display: block;
            border-radius: 50px;
            width: 45px;
            height: 45px;
            transition: all 0.3s ease;
        }

        .auth-button span {
            position: relative;
            font-family: "Ubuntu", sans-serif;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: #234567;
        }

        .auth-button svg {
            position: relative;
            top: 0;
            margin-left: 10px;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke: #234567;
            stroke-width: 2;
            transform: translateX(-5px);
            transition: all 0.3s ease;
        }

        .auth-button:hover:before {
            width: 100%;
        }

        .auth-button:hover svg {
            transform: translateX(0);
        }

        .auth-button:active {
            transform: scale(0.95);
        }

        /* Spezifische Styles für Login (blau) */
        .auth-button-login:before {
            background: #b1dae7;
        }
        .auth-button-login:hover:before {
            background: #b1dae7;
        }

        /* Spezifische Styles für Register (grün) */
        .auth-button-register:before {
            background: #b1e7c8;
        }
        .auth-button-register:hover:before {
            background: #b1e7c8;
        }

        .auth-buttons {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .login-container {
            max-width: 400px;
            margin: 2rem auto;
            padding: 2rem;
            background: #ffffff;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .login-container h2 {
            font-family: "Ubuntu", sans-serif;
            font-size: 24px;
            color: #234567;
            margin-bottom: 1.5rem;
            text-align: center;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            font-family: "Ubuntu", sans-serif;
            font-size: 16px;
            color: #234567;
            margin-bottom: 0.5rem;
        }

        .form-group input {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #e2e8f0;
            border-radius: 5px;
            font-family: "Inter", sans-serif;
            font-size: 16px;
            transition: border-color 0.3s ease;
        }

        .form-group input:focus {
            outline: none;
            border-color: #b1dae7;
        }

        .error-message {
            color: #e53e3e;
            font-size: 14px;
            margin-top: 0.5rem;
            display: none;
        }

        .success-message {
            color: #38a169;
            font-size: 14px;
            margin-top: 0.5rem;
            display: none;
        }

        .submit-button {
            width: 100%;
            padding: 12px;
            background: #b1dae7;
            color: #234567;
            border: none;
            border-radius: 5px;
            font-family: "Ubuntu", sans-serif;
            font-size: 18px;
            font-weight: 700;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .submit-button:hover {
            background: #9bc8d7;
        }

        .register-link {
            text-align: center;
            margin-top: 1rem;
            font-family: "Inter", sans-serif;
            color: #234567;
        }

        .register-link a {
            color: #38a169;
            text-decoration: none;
            font-weight: 600;
        }

        .register-link a:hover {
            text-decoration: underline;
        }

        /* Darkmode Styles */
        body.darkmode {
            background: #1a1a1a;
            color: #ffffff;
        }

        body.darkmode .login-container {
            background: #2d2d2d;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
        }

        body.darkmode .login-container h2,
        body.darkmode .form-group label,
        body.darkmode .register-link {
            color: #ffffff;
        }

        body.darkmode .form-group input {
            background: #3d3d3d;
            border-color: #4d4d4d;
            color: #ffffff;
        }

        body.darkmode .form-group input:focus {
            border-color: #b1dae7;
        }

        body.darkmode .submit-button {
            background: #234567;
            color: #ffffff;
        }

        body.darkmode .submit-button:hover {
            background: #2c5282;
        }

        body.darkmode .register-link a {
            color: #48bb78;
        }
    </style>
</head>

<header class="main-header">
    <div class="header-content">
        <a href="/public" style="text-decoration: none;">
          <span class="header-logo">Freest<b>AI</b>le</span>
        </a>
        <div class="flex items-center space-x-4">
            <% if (it.user) { %>
                <!-- Eingeloggter Benutzer -->
                <div class="profile-container">
                    <div class="profile-circle">
                        <%= it.user.email.charAt(0).toUpperCase() %>
                    </div>
                    <span class="profile-email"><%= it.user.email %></span>
                    <a href="#" class="auth-button auth-button-logout" onclick="(async function(e) { e.preventDefault(); try { const response = await fetch('/api/auth/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' } }); if (response.ok) window.location.reload(); } catch (error) { console.error('Logout-Fehler:', error); } })(event)">
                        <span>Abmelden</span>
                        <svg width="15px" height="10px" viewBox="0 0 13 10">
                            <path d="M1,5 L11,5"></path>
                            <polyline points="8 1 12 5 8 9"></polyline>
                        </svg>
                    </a>
                </div>
            <% } else { %>
                <!-- Nicht eingeloggter Benutzer -->
                <div class="auth-buttons">
                    <a href="/login" class="auth-button auth-button-login">
                        <span>Anmelden</span>
                        <svg width="15px" height="10px" viewBox="0 0 13 10">
                            <path d="M1,5 L11,5"></path>
                            <polyline points="8 1 12 5 8 9"></polyline>
                        </svg>
                    </a>
                    <a href="/register" class="auth-button auth-button-register">
                        <span>Registrieren</span>
                        <svg width="15px" height="10px" viewBox="0 0 13 10">
                            <path d="M1,5 L11,5"></path>
                            <polyline points="8 1 12 5 8 9"></polyline>
                        </svg>
                    </a>
                </div>
            <% } %>
            <label class="switch">
                <input id="darkmode-toggle" type="checkbox" />
                <span class="slider">
                    <div class="star star_1"></div>
                    <div class="star star_2"></div>
                    <div class="star star_3"></div>
                    <svg viewBox="0 0 16 16" class="cloud_1 cloud">
                        <path
                            transform="matrix(.77976 0 0 .78395-299.99-418.63)"
                            fill="#fff"
                            d="m391.84 540.91c-.421-.329-.949-.524-1.523-.524-1.351 0-2.451 1.084-2.485 2.435-1.395.526-2.388 1.88-2.388 3.466 0 1.874 1.385 3.423 3.182 3.667v.034h12.73v-.006c1.775-.104 3.182-1.584 3.182-3.395 0-1.747-1.309-3.186-2.994-3.379.007-.106.011-.214.011-.322 0-2.707-2.271-4.901-5.072-4.901-2.073 0-3.856 1.202-4.643 2.925"
                        ></path>
                    </svg>
                </span>
            </label>
        </div>
    </div>
</header>

<body>
    <div class="login-container">
        <h2>Anmelden</h2>
        <% if (it.error) { %>
            <div class="error-message" style="display: block;">
                <%= it.error %>
            </div>
        <% } %>
        <% if (it.success) { %>
            <div class="success-message" style="display: block;">
                <%= it.success %>
            </div>
        <% } %>
        <form id="loginForm" method="POST" action="/api/auth/login">
            <div class="form-group">
                <label for="email">E-Mail</label>
                <input type="email" id="email" name="email" required>
            </div>
            <div class="form-group">
                <label for="password">Passwort</label>
                <input type="password" id="password" name="password" required>
            </div>
            <button type="submit" class="submit-button">Anmelden</button>
        </form>
        <div class="register-link">
            Noch kein Konto? <a href="/register">Jetzt registrieren</a>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Wenn die Seite direkt aufgerufen wird, öffne das Login-Modal
            openAuthModal('login');
        });

        // Modal Funktionen
        function openAuthModal(tab = 'login') {
            document.getElementById('authModal').style.display = 'flex';
            switchTab(tab);
        }

        function closeAuthModal() {
            // Wenn das Modal geschlossen wird, leite zur Startseite weiter
            window.location.reload(); // Seite neu laden statt zur Startseite weiterleiten
        }

        function switchTab(tab) {
            // Update tabs
            document.querySelectorAll('.modal-tab').forEach(t => t.classList.remove('active'));
            document.querySelector(`.modal-tab[onclick="switchTab('${tab}')"]`).classList.add('active');
            
            // Update forms
            document.querySelectorAll('.modal-form').forEach(f => f.classList.remove('active'));
            document.getElementById(`modal${tab.charAt(0).toUpperCase() + tab.slice(1)}Form`).classList.add('active');
        }

        async function handleModalLogin(event) {
            event.preventDefault();
            const email = document.getElementById('modalEmail').value;
            const password = document.getElementById('modalPassword').value;
            const errorDiv = document.getElementById('modalLoginError');

            try {
                const response = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password })
                });

                if (response.ok) {
                    window.location.reload(); // Seite neu laden statt Weiterleitung
                } else {
                    const error = await response.json();
                    errorDiv.textContent = error.message || 'Anmeldung fehlgeschlagen';
                    errorDiv.style.display = 'block';
                }
            } catch (error) {
                console.error('Login-Fehler:', error);
                errorDiv.textContent = 'Ein Fehler ist aufgetreten';
                errorDiv.style.display = 'block';
            }
        }

        async function handleModalRegister(event) {
            event.preventDefault();
            const email = document.getElementById('modalRegisterEmail').value;
            const password = document.getElementById('modalRegisterPassword').value;
            const confirmPassword = document.getElementById('modalConfirmPassword').value;
            const errorDiv = document.getElementById('modalRegisterError');

            if (password !== confirmPassword) {
                errorDiv.textContent = 'Die Passwörter stimmen nicht überein';
                errorDiv.style.display = 'block';
                return;
            }

            try {
                const response = await fetch('/api/auth/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password })
                });

                if (response.ok) {
                    // Nach erfolgreicher Registrierung zum Login-Tab wechseln
                    switchTab('login');
                    document.getElementById('modalEmail').value = email;
                    errorDiv.style.display = 'none';
                    document.getElementById('modalRegisterError').style.display = 'none';
                } else {
                    const error = await response.json();
                    errorDiv.textContent = error.message || 'Registrierung fehlgeschlagen';
                    errorDiv.style.display = 'block';
                }
            } catch (error) {
                console.error('Registrierungs-Fehler:', error);
                errorDiv.textContent = 'Ein Fehler ist aufgetreten';
                errorDiv.style.display = 'block';
            }
        }

        // Event Listener für das Modal
        document.addEventListener('DOMContentLoaded', function() {
            // Schließen des Modals bei Klick außerhalb
            document.getElementById('authModal').addEventListener('click', (e) => {
                if (e.target === document.getElementById('authModal')) {
                    closeAuthModal();
                }
            });

            // Schließen des Modals mit Escape-Taste
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && document.getElementById('authModal').style.display === 'flex') {
                    closeAuthModal();
                }
            });
        });
    </script>
</body>
</html>
