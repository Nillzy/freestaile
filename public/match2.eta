<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Multiplayer Präsentation - FreestAIle</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/4.3.1/reveal.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/4.3.1/theme/white.min.css">

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f5f5f5;
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        .center-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .container {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .presentation-container {
            height: 100%;
        }

        .reveal {
            height: 100% !important;
        }

        .emoji-fly {
            position: fixed;
            font-size: 80px; /* GRÖSSERES EMOJI */
            animation: flyUp 1.2s ease-in-out forwards;
            z-index: 9999;
            top: 50%;
            transform: translateY(-50%);
            pointer-events: none;
        }

        @keyframes flyUp {
            0% {
                opacity: 0;
                transform: translateY(0) scale(1);
            }
            25% {
                opacity: 1;
                transform: translateY(-80px) scale(1.3);
            }
            75% {
                transform: translateY(50px) scale(0.8);
            }
            100% {
                opacity: 0;
                transform: translateY(150px) scale(0.6);
            }
        }
    </style>
</head>
<body>

<div class="center-container">
    <%~ it.content %>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/4.3.1/reveal.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="/js/sse-client.js"></script>

<script>
    const matchData = {
        lobbyId: '<%= it.lobbyId %>',
        userId: '<%= it.userId %>',
        userName: '<%= it.userName %>',
        isHost: <%= it.isHost ? 'true' : 'false' %>
    };

    try {
        const playersData = `<%- JSON.stringify(it.players || []) %>`;
        if (playersData && playersData !== 'null' && playersData !== 'undefined') {
            matchData.players = JSON.parse(playersData);
        }
    } catch (e) {
        console.warn('Fehler beim Parsen der Spielerdaten:', e);
        matchData.players = [];
    }

    Reveal.initialize({
        width: 1792,
        height: 1008,
        margin: 0,
        controls: false,
        progress: false,
        center: true,
        hash: true,
        transition: 'slide',
        viewDistance: 3,
        autoPlayMedia: true,
        preloadIframes: true,
        plugins: []
    });

    function extractEmojis(text) {
        const regex = /(\p{Emoji_Presentation}|\p{Extended_Pictographic})/gu;
        return [...text.matchAll(regex)].map(match => match[0]);
    }

    function animateEmoji(emoji, delay = 0) {
        const span = document.createElement('span');
        span.className = 'emoji-fly';
        span.textContent = emoji;

        // ZUFÄLLIGE POSITION ZWISCHEN 20% UND 80% BREITE
        const randomLeft = Math.floor(Math.random() * 60) + 20;
        span.style.left = `${randomLeft}%`;
        span.style.animationDelay = `${delay}s`;

        document.body.appendChild(span);

        setTimeout(() => {
            span.remove();
        }, 1600 + delay * 1000);
    }

    function animateEmojiSequence(message) {
        const emojis = extractEmojis(message);
        emojis.forEach((emoji) => {
            animateEmoji(emoji);
        });
    }


    let realtimeClient = null;

    document.addEventListener('DOMContentLoaded', async () => {
        try {
            realtimeClient = new SupabaseRealtimeClient();

            realtimeClient.on('connect', () => {
                console.log('Verbunden mit Multiplayer-Session (Realtime)');
            });

            realtimeClient.on('connect_error', (error) => {
                console.error('Verbindungsfehler: ' + error.message);
            });

            realtimeClient.on('chatMessage', (data) => {
                if (data.userId !== matchData.userId) {
                    animateEmojiSequence(data.message);
                }
            });

            realtimeClient.on('slideChanged', (data) => {
                if (!matchData.isHost) {
                    Reveal.slide(data.slideIndex);
                }
            });

            realtimeClient.on('playerJoined', (player) => {
                animateEmojiSequence('👋');
            });

            realtimeClient.on('playerLeft', (player) => {
                animateEmojiSequence('😢');
            });

            await realtimeClient.connect(
                matchData.lobbyId,
                matchData.userId,
                matchData.userName,
                matchData.isHost
            );

        } catch (err) {
            console.error('Fehler bei Init:', err);
        }

        // Willkommensanimation
        setTimeout(() => {
            animateEmojiSequence('👋');
        }, 1000);
    });
</script>
</body>
</html>
