<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreestAIle - Multiplayer Mode</title>
    <!-- Dark mode initialization script - must be at the top to prevent flicker -->
    <script src="darkmode-init.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Ubuntu:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles/landing-page.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Basis-Styles für alle Buttons */
        .auth-button {
            position: relative;
            margin: auto;
            padding: 12px 18px;
            transition: all 0.2s ease;
            border: none;
            background: none;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

        .auth-button:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            display: block;
            border-radius: 50px;
            width: 45px;
            height: 45px;
            transition: all 0.3s ease;
        }

        .auth-button span {
            position: relative;
            font-family: "Ubuntu", sans-serif;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: #234567;
        }

        .auth-button svg {
            position: relative;
            top: 0;
            margin-left: 10px;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke: #234567;
            stroke-width: 2;
            transform: translateX(-5px);
            transition: all 0.3s ease;
        }

        .auth-button:hover:before {
            width: 100%;
        }

        .auth-button:hover svg {
            transform: translateX(0);
        }

        .auth-button:active {
            transform: scale(0.95);
        }

        /* Spezifische Styles für Login (blau) */
        .auth-button-login:before {
            background: #b1dae7;
        }
        .auth-button-login:hover:before {
            background: #b1dae7;
        }

        /* Spezifische Styles für Register (grün) */
        .auth-button-register:before {
            background: #b1e7c8;
        }
        .auth-button-register:hover:before {
            background: #b1e7c8;
        }

        /* Spezifische Styles für Logout (rot) */
        .auth-button-logout {
            position: relative;
            margin: auto;
            padding: 12px 18px;
            transition: all 0.2s ease;
            border: none;
            background: none;
            cursor: pointer;
        }

        .auth-button-logout:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            display: block;
            border-radius: 50px;
            background: #e7b1b1;
            width: 45px;
            height: 45px;
            transition: all 0.3s ease;
        }

        .auth-button-logout span {
            position: relative;
            font-family: "Ubuntu", sans-serif;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: #234567;
        }

        .auth-button-logout svg {
            position: relative;
            top: 0;
            margin-left: 10px;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke: #234567;
            stroke-width: 2;
            transform: translateX(-5px);
            transition: all 0.3s ease;
        }

        .auth-button-logout:hover:before {
            width: 100%;
            background: #e7b1b1;
        }

        .auth-button-logout:hover svg {
            transform: translateX(0);
        }

        .auth-button-logout:active {
            transform: scale(0.95);
        }

        .profile-container {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-right: 1rem;
        }

        .profile-circle {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: #b1dae7;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Ubuntu", sans-serif;
            font-size: 20px;
            font-weight: 700;
            color: #234567;
            transition: all 0.3s ease;
            flex-shrink: 0;
        }
        
        /* Apply dark mode styles to profile circle immediately with class on html element */
        html.darkmode .profile-circle {
            background: #3d3d3d;
            color: #ffffff;
        }

        .profile-email {
            font-family: "Ubuntu", sans-serif;
            font-size: 16px;
            color: #234567;
            white-space: nowrap;
        }
        
        html.darkmode .profile-email {
            color: #ffffff;
        }

        .profile-circle:hover {
            background: #9bc8d7;
            transform: scale(1.05);
        }

        body.darkmode .profile-circle {
            background: #3d3d3d;
            color: #ffffff;
        }

        body.darkmode .profile-email {
            color: #ffffff;
        }

        .auth-buttons {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        /* Multiplayer-spezifische Styles */
        .player-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .player-card {
            background: #ffffff;
            border-radius: 10px;
            padding: 1.5rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
        }

        .player-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }

        .player-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .player-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #b1dae7;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Ubuntu", sans-serif;
            font-size: 24px;
            font-weight: 700;
            color: #234567;
        }

        .player-info {
            flex: 1;
        }

        .player-name {
            font-family: "Ubuntu", sans-serif;
            font-size: 18px;
            font-weight: 700;
            color: #234567;
            margin: 0;
        }

        .player-topic {
            font-family: "Inter", sans-serif;
            font-size: 14px;
            color: #666;
            margin-top: 0.25rem;
        }

        .player-status {
            font-family: "Inter", sans-serif;
            font-size: 14px;
            padding: 0.25rem 0.75rem;
            border-radius: 15px;
            display: inline-block;
            margin-top: 0.5rem;
        }

        .status-ready {
            background: #b1e7c8;
            color: #234567;
        }

        .status-waiting {
            background: #f0f0f0;
            color: #666;
        }

        .player-input {
            margin-top: 1rem;
        }

        .player-input input {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #e2e8f0;
            border-radius: 5px;
            font-family: "Inter", sans-serif;
            font-size: 16px;
            transition: border-color 0.3s ease;
        }

        .player-input input:focus {
            outline: none;
            border-color: #b1dae7;
        }

        .player-actions {
            display: flex;
            gap: 0.5rem;
            margin-top: 1rem;
        }

        .player-actions button {
            flex: 1;
            padding: 0.5rem;
            border: none;
            border-radius: 5px;
            font-family: "Ubuntu", sans-serif;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .ready-button {
            background: #b1e7c8;
            color: #234567;
        }

        .ready-button:hover {
            background: #9bd7b1;
        }

        .remove-button {
            background: #e7b1b1;
            color: #234567;
        }

        .remove-button:hover {
            background: #d7a1a1;
        }

        .start-game-button {
            width: 100%;
            padding: 1rem;
            margin-top: 2rem;
            background: #b1dae7;
            color: #234567;
            border: none;
            border-radius: 5px;
            font-family: "Ubuntu", sans-serif;
            font-size: 18px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .start-game-button:hover {
            background: #9bc8d7;
        }

        .start-game-button:disabled {
            background: #f0f0f0;
            color: #999;
            cursor: not-allowed;
        }

        /* Darkmode Styles */
        body.darkmode .player-card {
            background: #2d2d2d;
        }

        body.darkmode .player-name {
            color: #ffffff;
        }

        body.darkmode .player-topic {
            color: #a0aec0;
        }

        body.darkmode .player-input input {
            background: #3d3d3d;
            border-color: #4d4d4d;
            color: #ffffff;
        }

        body.darkmode .player-input input:focus {
            border-color: #b1dae7;
        }

        body.darkmode .status-waiting {
            background: #3d3d3d;
            color: #a0aec0;
        }

        body.darkmode .start-game-button:disabled {
            background: #3d3d3d;
            color: #666;
        }

        /* Modal Styles */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(5px);
            z-index: 1000;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .modal-overlay.active {
            display: flex;
            opacity: 1;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background: #ffffff;
            border-radius: 15px;
            padding: 2rem;
            width: 90%;
            max-width: 400px;
            position: relative;
            transform: translateY(-20px);
            transition: transform 0.3s ease;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        }

        .modal-overlay.active .modal-content {
            transform: translateY(0);
        }

        .modal-close {
            position: absolute;
            top: 0;
            right: 0.5rem;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: #666;
            cursor: pointer;
            padding: 0.5rem;
            line-height: 1;
            transition: color 0.2s ease;
        }

        .modal-close:hover {
            color: #234567;
        }

        .modal-tabs {
            display: flex;
            gap: 1rem;
            margin-bottom: 1.5rem;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 0.5rem;
        }

        .modal-tab {
            padding: 0.5rem 1rem;
            font-family: "Ubuntu", sans-serif;
            font-size: 16px;
            font-weight: 600;
            color: #666;
            cursor: pointer;
            transition: all 0.2s ease;
            border: none;
            background: none;
            position: relative;
        }

        .modal-tab.active {
            color: #234567;
        }

        .modal-tab.active::after {
            content: '';
            position: absolute;
            bottom: -0.5rem;
            left: 0;
            width: 100%;
            height: 2px;
            background: #234567;
        }

        .modal-form {
            display: none;
        }

        .modal-form.active {
            display: block;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            font-family: "Inter", sans-serif;
            font-size: 14px;
            font-weight: 500;
            color: #234567;
            margin-bottom: 0.5rem;
        }

        .form-group input {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-family: "Inter", sans-serif;
            font-size: 16px;
            transition: all 0.2s ease;
            background: #f8fafc;
        }

        .form-group input:focus {
            outline: none;
            border-color: #b1dae7;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(177, 218, 231, 0.2);
        }

        .modal-submit {
            width: 100%;
            padding: 0.75rem;
            background: #b1dae7;
            color: #234567;
            border: none;
            border-radius: 8px;
            font-family: "Ubuntu", sans-serif;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-top: 1rem;
        }

        .modal-submit:hover {
            background: #9bc8d7;
            transform: translateY(-1px);
        }

        .modal-submit:active {
            transform: translateY(0);
        }

        .error-message {
            color: #e53e3e;
            font-family: "Inter", sans-serif;
            font-size: 14px;
            margin-top: 0.5rem;
            display: none;
        }

        .error-message.active {
            display: block;
        }

        /* Dark Mode Styles für Modal */
        body.darkmode .modal-content {
            background: #2d2d2d;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
        }

        body.darkmode .modal-close {
            color: #a0aec0;
        }

        body.darkmode .modal-close:hover {
            color: #ffffff;
        }

        body.darkmode .modal-tab {
            color: #a0aec0;
        }

        body.darkmode .modal-tab.active {
            color: #ffffff;
        }

        body.darkmode .modal-tab.active::after {
            background: #b1dae7;
        }

        body.darkmode .modal-tabs {
            border-bottom-color: #4d4d4d;
        }

        body.darkmode .form-group label {
            color: #ffffff;
        }

        body.darkmode .form-group input {
            background: #3d3d3d;
            border-color: #4d4d4d;
            color: #ffffff;
        }

        body.darkmode .form-group input:focus {
            border-color: #b1dae7;
            background: #2d2d2d;
        }

        body.darkmode .modal-submit {
            background: #b1dae7;
            color: #234567;
        }

        body.darkmode .modal-submit:hover {
            background: #9bc8d7;
        }

        body.darkmode .error-message {
            color: #fc8181;
        }
    </style>
</head>

<header class="main-header">
    <div class="header-content">
        <a href="/" style="text-decoration: none; color: inherit;">
            <span class="header-logo">Freest<b>AI</b>le</span>
        </a>
        <div class="flex items-center space-x-4">
            <% if (it.user) { %>
            <!-- Eingeloggter Benutzer -->
            <div class="profile-container">
                <a href="/user" style="text-decoration: none;">
                    <div class="profile-circle">
                        <%= it.user.email.charAt(0).toUpperCase() %>
                    </div>
                </a>
                <div class="profile-email"><%= it.user.email %></div>
                <a href="#" class="auth-button auth-button-logout" onclick="(async function(e) { e.preventDefault(); try { const response = await fetch('/api/auth/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' } }); if (response.ok) window.location.reload(); } catch (error) { console.error('Logout-Fehler:', error); } })(event)">
                    <span>Abmelden</span>
                    <svg width="15px" height="10px" viewBox="0 0 13 10">
                        <path d="M1,5 L11,5"></path>
                        <polyline points="8 1 12 5 8 9"></polyline>
                    </svg>
                </a>
            </div>
            <% } else { %>
            <!-- Nicht eingeloggter Benutzer -->
            <div class="auth-buttons">
                <a href="#" class="auth-button auth-button-login" onclick="openAuthModal('login'); return false;">
                    <span>Anmelden</span>
                    <svg width="15px" height="10px" viewBox="0 0 13 10">
                        <path d="M1,5 L11,5"></path>
                        <polyline points="8 1 12 5 8 9"></polyline>
                    </svg>
                </a>
                <a href="#" class="auth-button auth-button-register" onclick="openAuthModal('register'); return false;">
                    <span>Registrieren</span>
                    <svg width="15px" height="10px" viewBox="0 0 13 10">
                        <path d="M1,5 L11,5"></path>
                        <polyline points="8 1 12 5 8 9"></polyline>
                    </svg>
                </a>
            </div>
            <% } %>
            <label class="switch">
                <input id="darkmode-toggle" type="checkbox" />
                <span class="slider">
                    <div class="star star_1"></div>
                    <div class="star star_2"></div>
                    <div class="star star_3"></div>
                    <svg viewBox="0 0 16 16" class="cloud_1 cloud">
                        <path
                                transform="matrix(.77976 0 0 .78395-299.99-418.63)"
                                fill="#fff"
                                d="m391.84 540.91c-.421-.329-.949-.524-1.523-.524-1.351 0-2.451 1.084-2.485 2.435-1.395.526-2.388 1.88-2.388 3.466 0 1.874 1.385 3.423 3.182 3.667v.034h12.73v-.006c1.775-.104 3.182-1.584 3.182-3.395 0-1.747-1.309-3.186-2.994-3.379.007-.106.011-.214.011-.322 0-2.707-2.271-4.901-5.072-4.901-2.073 0-3.856 1.202-4.643 2.925"
                        ></path>
                    </svg>
                </span>
            </label>
        </div>
    </div>
</header>

<body>
<div class="container-wrapper">
    <div class="container">
        <div class="header">
            <h1 class="logo"><b>MULTI</b>player-Mode</h1>
        </div>

        <div class="mode-container" style="display: flex; gap: 2rem; margin-top: 2rem;">
            <div style="flex: 1; text-align: center; background: #ffffff; padding: 2rem; border-radius: 10px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
                <h2 style="font-family: 'Ubuntu', sans-serif; color: #234567;">1 Device Mode</h2>
                <p style="margin: 1rem 0; font-family: 'Inter', sans-serif; color: #666;">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                <form class="main-form" action="/1-device-mode" method="get">
                    <div class="input-group">
                        <button type="submit" style="background: #b1dae7; color: #234567; border: none; padding: 12px 24px; border-radius: 5px; font-family: 'Ubuntu', sans-serif; font-weight: 600; cursor: pointer; transition: all 0.2s ease;">1 Device Mode starten</button>
                    </div>
                </form>
            </div>

            <div style="flex: 1; text-align: center; background: #ffffff; padding: 2rem; border-radius: 10px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
                <h2 style="font-family: 'Ubuntu', sans-serif; color: #234567;">Multi Device Mode</h2>
                <p style="margin: 1rem 0; font-family: 'Inter', sans-serif; color: #666;">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                <form class="main-form" action="/multi-device-mode" method="get">
                    <div class="input-group">
                        <button type="submit" style="background: #b1dae7; color: #234567; border: none; padding: 12px 24px; border-radius: 5px; font-family: 'Ubuntu', sans-serif; font-weight: 600; cursor: pointer; transition: all 0.2s ease;">Multi Device Mode starten</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const toggle = document.getElementById('darkmode-toggle');
        
        // Get current dark mode status (already set by darkmode-init.js)
        const isDark = document.documentElement.classList.contains('darkmode');
        
        // Set toggle position based on current dark mode status
        toggle.checked = !isDark;
        
        // Ensure body also has the class for backward compatibility
        document.body.classList.toggle('darkmode', isDark);

        toggle.addEventListener('change', function() {
            const dark = !toggle.checked;
            document.documentElement.classList.toggle('darkmode', dark);
            document.body.classList.toggle('darkmode', dark);
            localStorage.setItem('darkmode', dark.toString());
        });
    });
</script>
</body>
</html>
