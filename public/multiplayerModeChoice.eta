<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreestAIle - Multiplayer Mode</title>
    <!-- Dark mode initialization script - must be at the top to prevent flicker -->
    <script src="darkmode-init.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Ubuntu:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles/landing-page.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="styles/multiplayerModeChoice.css">
    <style>
        .mode-container {
            display: flex;
            flex-wrap: wrap;
            gap: 2rem;
            margin-top: 2rem;
        }

        .mode-box {
            flex: 1;
            min-width: 300px;
            text-align: center;
            background: #ffffff;
            padding: 2rem;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: background-color 0.3s, box-shadow 0.3s;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .mode-box h2 {
            font-family: 'Ubuntu', sans-serif;
            color: #234567;
            margin-bottom: 1rem;
            transition: color 0.3s;
        }

        .mode-box p {
            margin: 1rem 0 1.5rem;
            font-family: 'Inter', sans-serif;
            color: #666;
            line-height: 1.6;
            transition: color 0.3s;
        }

        /* KORREKTUR: Button-Stil auf rechteckig mit abgerundeten Ecken geändert */
        .mode-button {
            width: 100%;
            padding: 14px 24px;
            border: none;
            border-radius: 8px; /* Abgerundete Ecken statt Pille */
            background: #b1dae7; /* Solider Blauton */
            color: #ffffff; /* Weißer Text */
            font-size: 1rem;
            font-weight: 600;
            font-family: 'Ubuntu', sans-serif;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            /* text-transform und letter-spacing entfernt für Standard-Look */
        }

        .mode-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }

        .mode-button:active {
            transform: translateY(0);
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }

        /* Dark Mode Styles */
        body.darkmode .mode-box {
            background: #2d2d2d;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        }

        body.darkmode .mode-box h2 {
            color: #ffffff;
        }

        body.darkmode .mode-box p {
            color: #a0aec0;
        }
    </style>
</head>

<header class="main-header">
    <div class="header-content">
        <a href="/" style="text-decoration: none; color: inherit;">
            <span class="header-logo">Freest<b>AI</b>le</span>
        </a>
        <div class="flex items-center space-x-4">
            <% if (it.user) { %>
            <!-- Eingeloggter Benutzer -->
            <div class="profile-container">
                <a href="/user" style="text-decoration: none;">
                    <div class="profile-circle">
                        <%= it.user.email.charAt(0).toUpperCase() %>
                    </div>
                </a>
                <div class="profile-email"><%= it.user.email %></div>
                <a href="#" class="auth-button auth-button-logout" onclick="(async function(e) { e.preventDefault(); try { const response = await fetch('/api/auth/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' } }); if (response.ok) window.location.reload(); } catch (error) { console.error('Logout-Fehler:', error); } })(event)">
                    <span>Abmelden</span>
                    <svg width="15px" height="10px" viewBox="0 0 13 10">
                        <path d="M1,5 L11,5"></path>
                        <polyline points="8 1 12 5 8 9"></polyline>
                    </svg>
                </a>
            </div>
            <% } else { %>
            <!-- Nicht eingeloggter Benutzer -->
            <div class="auth-buttons">
                <a href="#" class="auth-button auth-button-login" onclick="openAuthModal('login'); return false;">
                    <span>Anmelden</span>
                    <svg width="15px" height="10px" viewBox="0 0 13 10">
                        <path d="M1,5 L11,5"></path>
                        <polyline points="8 1 12 5 8 9"></polyline>
                    </svg>
                </a>
                <a href="#" class="auth-button auth-button-register" onclick="openAuthModal('register'); return false;">
                    <span>Registrieren</span>
                    <svg width="15px" height="10px" viewBox="0 0 13 10">
                        <path d="M1,5 L11,5"></path>
                        <polyline points="8 1 12 5 8 9"></polyline>
                    </svg>
                </a>
            </div>
            <% } %>
            <label class="switch">
                <input id="darkmode-toggle" type="checkbox" />
                <span class="slider">
                    <span class="star star_1"></span>
                    <span class="star star_2"></span>
                    <span class="star star_3"></span>
                    <svg viewBox="0 0 16 16" class="cloud_1 cloud">
                        <path
                                transform="matrix(.77976 0 0 .78395-299.99-418.63)"
                                fill="#fff"
                                d="m391.84 540.91c-.421-.329-.949-.524-1.523-.524-1.351 0-2.451 1.084-2.485 2.435-1.395.526-2.388 1.88-2.388 3.466 0 1.874 1.385 3.423 3.182 3.667v.034h12.73v-.006c1.775-.104 3.182-1.584 3.182-3.395 0-1.747-1.309-3.186-2.994-3.379.007-.106.011-.214.011-.322 0-2.707-2.271-4.901-5.072-4.901-2.073 0-3.856 1.202-4.643 2.925"
                        ></path>
                    </svg>
                </span>
            </label>
        </div>
    </div>
</header>

<body>
<div class="container-wrapper">
    <div class="container">
        <div class="header">
            <h1 class="logo"><b>MULTI</b>player-Mode</h1>
        </div>

        <div class="mode-container">
            <div class="mode-box">
                <div>
                    <h2>1 Device Mode</h2>
                    <p>Spielt gemeinsam an einem einzigen Bildschirm. Alle sehen die Präsentation auf dem Hauptgerät – perfekt für spontane Runden auf dem Sofa oder am Beamer.</p>
                </div>
                <form class="main-form" action="/1-device-mode" method="get">
                    <div class="input-group">
                        <button type="submit" class="mode-button">1 Device Mode starten</button>
                    </div>
                </form>
            </div>

            <div class="mode-box">
                <div>
                    <h2>Multi Device Mode</h2>
                    <p>Jeder Spieler nutzt sein eigenes Smartphone oder Laptop. Zusätzlich zum Hauptbildschirm könnt ihr chatten und live Reaktionen auf die Folien senden.</p>
                </div>
                <form class="main-form" action="/multi-device-mode" method="get">
                    <div class="input-group">
                        <button type="submit" class="mode-button">Multi Device Mode starten</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const toggle = document.getElementById('darkmode-toggle');

        const isDark = document.documentElement.classList.contains('darkmode');

        toggle.checked = !isDark;

        document.body.classList.toggle('darkmode', isDark);

        toggle.addEventListener('change', function() {
            const dark = !toggle.checked;
            document.documentElement.classList.toggle('darkmode', dark);
            document.body.classList.toggle('darkmode', dark);
            localStorage.setItem('darkmode', dark.toString());
        });
    });
</script>
</body>
</html>