<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreestAIle - Multiplayer Mode</title>

    <!-- Google Fonts & Font Awesome Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* --- CSS Variables --- */
        :root, [data-theme="light"] {
            --bg-color: #F4F7FC;
            --text-color: #1a1a2e;
            --text-color-light: #6c757d;
            --card-bg: #FFFFFF;
            --header-bg: rgba(255, 255, 255, 0.7);
            --primary-color: #5E60E7;
            --secondary-color: #43E69E;
            --accent-glow: rgba(67, 230, 158, 0.3);
            --shadow-color: rgba(0, 0, 0, 0.1);
        }

        [data-theme="dark"] {
            --bg-color: #2A2D3A;
            --text-color: #f0f0f0;
            --text-color-light: #a0aec0;
            --card-bg: #353849;
            --header-bg: rgba(42, 45, 58, 0.7);
            --primary-color: #5E60E7;
            --secondary-color: #43E69E;
            --accent-glow: rgba(67, 230, 158, 0.3);
            --shadow-color: rgba(0, 0, 0, 0.5);
        }

        /* --- Global Reset & Body --- */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Poppins', 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
            transition: background-color 0.3s ease, color 0.3s ease;
            overflow-x: hidden;
        }

        /* --- Animated Background --- */
        #particles-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; overflow: hidden; }
        .particle { position: absolute; background: linear-gradient(45deg, var(--primary-color), var(--secondary-color)); border-radius: 50%; opacity: 0; animation: rise 15s infinite linear; }
        @keyframes rise {
            0% { transform: translateY(100vh) scale(0.5); opacity: 0.3; }
            50% { opacity: 0.8; }
            100% { transform: translateY(-10vh) scale(1); opacity: 0; }
        }

        /* --- Main-Layout --- */
        .page-wrapper { max-width: 1200px; margin: 0 auto; padding: 8rem 2rem 2rem; min-height: 100vh; display: flex; flex-direction: column; }
        .content-wrap { flex: 1; }

        /* --- Header --- */
        .main-header { position: fixed; top: 0; left: 0; width: 100%; padding: 0.5rem 2rem; z-index: 1000; background: var(--header-bg); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid rgba(255, 255, 255, 0.1); transition: background 0.3s ease; }
        .header-content { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
        .header-logo { font-size: 1.5rem; font-weight: 700; color: var(--text-color); text-decoration: none; }
        .header-logo b {
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .header-nav { display: flex; align-items: center; gap: 1rem; }
        .dark-mode-toggle { cursor: pointer; font-size: 1.5rem; color: var(--text-color); opacity: 0.8; transition: all 0.3s ease; }
        .dark-mode-toggle:hover { opacity: 1; transform: scale(1.1) rotate(15deg); }
        .user-profile-link { text-decoration: none; color: inherit; border-radius: 50px; padding: 4px; transition: background-color 0.3s ease; margin-right: 0.5rem; }
        .user-profile-link:hover { background-color: rgba(255, 255, 255, 0.08); }
        .user-profile { display: flex; align-items: center; gap: 0.75rem; }
        .profile-avatar { width: 34px; height: 34px; border-radius: 50%; background-color: #F5A623; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 1rem; flex-shrink: 0; }
        .profile-email { opacity: 0.8; font-weight: 500; max-width: 150px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .cta { position: relative; margin: auto; padding: 12px 18px; transition: all 0.2s ease; border: none; background: none; cursor: pointer; }
        .cta:before { content: ""; position: absolute; top: 0; left: 0; display: block; border-radius: 50px; width: 45px; height: 45px; transition: all 0.3s ease; }
        .cta span { position: relative; font-family: "Poppins", sans-serif; font-size: 16px; font-weight: 600; letter-spacing: 0.05em; }
        .cta svg { position: relative; top: 0; margin-left: 10px; fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2; transform: translateX(-5px); transition: all 0.3s ease; }
        .cta:hover:before { width: 100%; }
        .cta:hover svg { transform: translateX(0); }
        .cta:active { transform: scale(0.95); }
        .cta--login:before { background: rgba(34, 197, 94, 0.3); } .cta--login span { color: #22c55e; } .cta--login svg { stroke: #22c55e; } .cta--login:hover:before { background: #22c55e; } .cta--login:hover span, .cta--login:hover svg { color: #fff; stroke: #fff; }
        .cta--logout:before { background: rgba(239, 68, 68, 0.3); } .cta--logout span { color: #ef4444; } .cta--logout svg { stroke: #ef4444; } .cta--logout:hover:before { background: #ef4444; } .cta--logout:hover span, .cta--logout:hover svg { color: #fff; stroke: #fff; }

        /* --- Multiplayer Page Styles --- */
        .page-header {
            text-align: center;
            margin-bottom: 3rem;
        }
        .page-header h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            font-weight: 700;
        }
        .page-header h1 b {
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .mode-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }

        .mode-box {
            background: var(--card-bg);
            padding: 2.5rem;
            border-radius: 15px;
            box-shadow: 0 10px 30px var(--shadow-color);
            text-align: center;
            display: flex;
            flex-direction: column;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .mode-box:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px var(--shadow-color);
        }

        .mode-icon {
            font-size: 5rem;
            margin-bottom: 1.5rem;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .mode-box h2 {
            font-size: 1.75rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .mode-box p {
            font-size: 1rem;
            opacity: 0.8;
            flex-grow: 1; /* Pushes button to the bottom */
            margin-bottom: 2rem;
        }

        .mode-button {
            font-size: 1.1rem;
            font-weight: 600;
            color: #fff;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            padding: 0.8rem 2rem;
            border-radius: 50px;
            text-decoration: none;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px var(--accent-glow);
            width: 100%;
        }
        .mode-button:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 20px var(--accent-glow);
        }

        /* --- Footer --- */
        .main-footer { text-align: center; padding: 3rem 2rem 2rem; border-top: 1px solid rgba(255, 255, 255, 0.1); font-size: 0.9rem; opacity: 0.7; }
        .main-footer a { color: var(--secondary-color); text-decoration: none; font-weight: 600; }
        .main-footer a:hover { text-decoration: underline; }

        /* --- Responsive Design --- */
        @media (max-width: 768px) {
            .mode-container { grid-template-columns: 1fr; }
            .page-wrapper, .main-header { padding: 0 1rem; }
            .header-content { padding: 1rem 0; }
            .main-header { padding: 0.5rem 1rem; }
            .page-wrapper { padding-top: 6rem; }
            .profile-email { display: none; }
        }
    </style>
</head>

<body>

<div id="particles-bg"></div>

<header class="main-header">
    <div class="header-content">
        <a href="/" style="text-decoration: none;"><span class="header-logo">Freest<b>AI</b>le</span></a>
        <div class="header-nav">
            <% if (it.user) { %>
            <a href="/user" class="user-profile-link"><div class="user-profile"><div class="profile-avatar"><%= it.user.email.charAt(0).toUpperCase() %></div><span class="profile-email"><%= it.user.email %></span></div></a>
            <button class="cta cta--logout" onclick="(async function(e) { e.preventDefault(); try { await fetch('/api/auth/logout', { method: 'POST' }); window.location.reload(); } catch (error) { console.error('Logout error:', error); } })(event)"><span>Logout</span><svg width="15px" height="10px" viewBox="0 0 13 10"><polyline points="8 1 12 5 8 9"></polyline></svg></button>
            <% } else { %>
            <button class="cta cta--login" onclick="openAuthModal('login'); return false;"><span>Login</span><svg width="15px" height="10px" viewBox="0 0 13 10"><polyline points="8 1 12 5 8 9"></polyline></svg></button>
            <% } %>
            <div class="dark-mode-toggle" id="theme-toggle" title="Toggle Theme"><i class="fa-solid fa-moon"></i></div>
        </div>
    </div>
</header>

<div class="page-wrapper">
    <div class="content-wrap">
        <div class="page-header">
            <h1><b>MULTI</b>player Mode</h1>
        </div>

        <div class="mode-container">
            <div class="mode-box">
                <div>
                    <i class="fa-solid fa-display mode-icon"></i>
                    <h2>1 Device Mode</h2>
                    <p>Play together on a single screen. Everyone sees the presentation on the main device – perfect for spontaneous rounds on the couch or with a projector.</p>
                </div>
                <form action="/1-device-mode" method="get">
                    <button type="submit" class="mode-button">Start 1 Device Mode</button>
                </form>
            </div>

            <div class="mode-box">
                <div>
                    <i class="fa-solid fa-mobile-screen-button mode-icon"></i>
                    <h2>Multi Device Mode</h2>
                    <p>Each player uses their own smartphone or laptop. In addition to the main screen, you can chat and send live reactions to the slides.</p>
                </div>
                <form action="/multi-device-mode" method="get">
                    <button type="submit" class="mode-button">Start Multi Device Mode</button>
                </form>
            </div>
        </div>
    </div>

    <footer class="main-footer">
        © 2025 FreestAIle | The ultimate tool for PowerPoint Karaoke | <a href="/imprint">Imprint</a> | Images by <a href="https://www.pixabay.com" target="_blank" rel="noopener">Pixabay</a>
    </footer>
</div>

<!-- Modal würde hier bei Bedarf eingefügt werden -->

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Dark Mode Logic
        const themeToggle = document.getElementById('theme-toggle');
        if (themeToggle) {
            const themeToggleIcon = themeToggle.querySelector('i');
            const htmlEl = document.documentElement;
            const setTheme = (theme) => {
                htmlEl.setAttribute('data-theme', theme);
                localStorage.setItem('theme', theme);
                if (themeToggleIcon) themeToggleIcon.className = theme === 'dark' ? 'fa-solid fa-moon' : 'fa-solid fa-sun';
            };
            const savedTheme = localStorage.getItem('theme') || 'dark';
            setTheme(savedTheme);
            themeToggle.addEventListener('click', () => {
                const newTheme = htmlEl.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                setTheme(newTheme);
            });
        }
    });
</script>
</body>
</html>