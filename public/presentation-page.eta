<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Presentation about <%= it.topic %> – FreestAIle</title>

    <link rel="stylesheet" href="styles/presentation.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/5.1.0/reveal.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/5.1.0/theme/white.min.css" id="theme-light">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/5.1.0/theme/black.min.css" id="theme-dark" disabled>

    <style>
        /* Basis-Styles für die Präsentation */
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            position: fixed; /* Verhindert Scrollbalken */
        }

        .container {
            width: 100%;
            height: 100%;
            position: fixed; /* Änderung von relative zu fixed */
            top: 0;
            left: 0;
            overflow: hidden;
        }

        .presentation-container {
            width: 100%;
            height: 100%;
            position: absolute; /* Änderung von relative zu absolute */
            top: 0;
            left: 0;
            overflow: hidden;
        }

        .reveal {
            width: 100%;
            height: 100%;
            position: absolute; /* Änderung von relative zu absolute */
            top: 0;
            left: 0;
            overflow: hidden;
        }

        .reveal .slides {
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
            margin: 0;
            padding: 0;
            overflow: hidden;
            box-sizing: border-box;
        }

        .reveal .slides section {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 20px;
            box-sizing: border-box;
            position: absolute; /* Wichtig für RevealJS */
            top: 0;
            left: 0;
        }

        /* CSS für das neue RevealJS-Menü */
        .revealjs-menu-container {
            position: fixed;
            top: 0;
            right: 0;
            z-index: 1000;
            width: 80px;
            height: 80px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .revealjs-hamburger-button {
            width: 40px;
            height: 40px;
            background-color: rgba(0, 0, 0, 0.1);
            border-radius: 50%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            transition: all 0.3s ease;
            opacity: 0;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
            position: relative;
            top: 20px;
            right: 20px;
        }

        /* Hover-Effekt auf dem Container */
        .revealjs-menu-container:hover .revealjs-hamburger-button {
            opacity: 1;
            background-color: rgba(0, 0, 0, 0.2);
            transform: scale(1.05);
        }

        .revealjs-hamburger-button span {
            display: block;
            width: 20px;
            height: 2px;
            background-color: #333;
            margin: 2px 0;
            transition: all 0.3s ease-in-out;
        }

        /* Dark Theme Anpassung für Hamburger Icon */
        body.theme-dark .revealjs-hamburger-button {
            background-color: rgba(255, 255, 255, 0.1);
        }

        body.theme-dark .revealjs-hamburger-button span {
            background-color: #fff;
        }

        /* "X" Icon, wenn Menü aktiv ist */
        .revealjs-hamburger-button.active span:nth-child(1) {
            transform: translateY(6px) rotate(45deg);
        }
        .revealjs-hamburger-button.active span:nth-child(2) {
            opacity: 0;
        }
        .revealjs-hamburger-button.active span:nth-child(3) {
            transform: translateY(-6px) rotate(-45deg);
        }

        .revealjs-menu-dropdown {
            position: absolute;
            top: 50px;
            right: 0;
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
            display: none;
            min-width: 200px;
            padding: 8px 0;
            pointer-events: auto;
            transform-origin: top right;
            transform: scale(0.95);
            opacity: 0;
            transition: all 0.2s ease;
        }

        .revealjs-menu-dropdown.active {
            display: block;
            transform: scale(1);
            opacity: 1;
        }

        body.theme-dark .revealjs-menu-dropdown {
            background-color: #222;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }

        .revealjs-menu-dropdown .menu-item {
            padding: 12px 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            font-size: 0.95em;
            color: #333;
            transition: background-color 0.2s ease;
        }

        body.theme-dark .revealjs-menu-dropdown .menu-item {
            color: #eee;
        }

        .revealjs-menu-dropdown .menu-item:hover {
            background-color: #f5f5f5;
        }

        body.theme-dark .revealjs-menu-dropdown .menu-item:hover {
            background-color: #333;
        }

        .revealjs-menu-dropdown .menu-item i {
            margin-right: 12px;
            font-size: 1.1em;
        }

        /* Entferne alle Header-Elemente */
        header,
        .reveal .header,
        .reveal .controls,
        .reveal .progress {
            display: none !important;
        }
    </style>
</head>

<body class="theme-light">

<!-- Neues RevealJS Menü -->
<div class="revealjs-menu-container" id="revealjs-menu">
    <div class="revealjs-hamburger-button" onclick="toggleMenu()">
        <span></span>
        <span></span>
        <span></span>
    </div>
    <div class="revealjs-menu-dropdown" id="menu-dropdown">
        <div class="menu-item" onclick="toggleTheme()">
            <i>🌓</i>
            <span id="theme-text">Darkmode aktivieren</span>
        </div>
    </div>
</div>

<%~ it.content %>

<!-- RevealJS Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/4.3.1/reveal.min.js"></script>

<script>
    // RevealJS initialisieren
    document.addEventListener('DOMContentLoaded', function() {
        Reveal.initialize({
            controls: false,
            progress: false,
            center: true,
            hash: true,
            transition: 'slide',
            width: "100%",
            height: "100%",
            margin: 0,
            viewDistance: 3,
            autoPlayMedia: true,
            preloadIframes: true,
            plugins: [],
            // Zusätzliche Optionen für bessere Darstellung
            display: 'block',
            overflow: 'hidden',
            minScale: 1,
            maxScale: 1
        });

        // Force layout update und verhindere Scrollbalken
        setTimeout(() => {
            Reveal.layout();
            Reveal.slide(0);
            document.body.style.overflow = 'hidden';
            window.scrollTo(0, 0);
        }, 100);

        // Verhindere Scrollbalken bei Größenänderung
        window.addEventListener('resize', function() {
            Reveal.layout();
            document.body.style.overflow = 'hidden';
            window.scrollTo(0, 0);
        });
    });

    // Hamburger-Menü umschalten
    function toggleMenu() {
        const dropdown = document.getElementById('menu-dropdown');
        const hamburgerButton = document.querySelector('.revealjs-hamburger-button'); // Angepasst

        dropdown.classList.toggle('active');
        hamburgerButton.classList.toggle('active'); // Für "X" Icon Styling
    }

    // Klick außerhalb des Menüs schließt das Menü
    document.addEventListener('click', function(event) {
        const menuContainer = document.getElementById('revealjs-menu'); // Angepasst
        const dropdown = document.getElementById('menu-dropdown');
        const hamburgerButton = document.querySelector('.revealjs-hamburger-button'); // Angepasst

        // Überprüfen, ob der Klick außerhalb des Menü-Containers war
        if (!menuContainer.contains(event.target) && dropdown.classList.contains('active')) {
            dropdown.classList.remove('active');
            hamburgerButton.classList.remove('active'); // Auch "X" Icon zurücksetzen
        }
    });

    // Light/Darkmode Toggle Funktion
    function toggleTheme() {
        const body = document.body;
        const themeLight = document.getElementById('theme-light');
        const themeDark = document.getElementById('theme-dark');
        const themeText = document.getElementById('theme-text');
        const dropdown = document.getElementById('menu-dropdown');
        const hamburgerButton = document.querySelector('.revealjs-hamburger-button'); // Angepasst

        if (body.classList.contains('theme-light')) {
            body.classList.remove('theme-light');
            body.classList.add('theme-dark');
            themeLight.disabled = true;
            themeDark.disabled = false;
            themeText.textContent = 'Lightmode aktivieren';
        } else {
            body.classList.remove('theme-dark');
            body.classList.add('theme-light');
            themeLight.disabled = false;
            themeDark.disabled = true;
            themeText.textContent = 'Darkmode aktivieren';
        }

        // Menü nach Themenwechsel schließen
        dropdown.classList.remove('active');
        hamburgerButton.classList.remove('active'); // Auch "X" Icon zurücksetzen
    }

    // Vollbildmodus umschalten (unverändert, da nicht Teil der Anfrage)
    function toggleFullscreen() {
        const presentationContainer = document.getElementById('presentation-container');

        if (presentationContainer.classList.contains('fullscreen-mode')) {
            presentationContainer.classList.remove('fullscreen-mode');
            if (document.exitFullscreen) document.exitFullscreen();
            else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
            else if (document.mozCancelFullScreen) document.mozCancelFullScreen();
            else if (document.msExitFullscreen) document.msExitFullscreen();
        } else {
            presentationContainer.classList.add('fullscreen-mode');
            if (presentationContainer.requestFullscreen) presentationContainer.requestFullscreen();
            else if (presentationContainer.webkitRequestFullscreen) presentationContainer.webkitRequestFullscreen();
            else if (presentationContainer.mozRequestFullScreen) presentationContainer.mozRequestFullScreen();
            else if (presentationContainer.msRequestFullscreen) presentationContainer.msRequestFullscreen();
        }
        setTimeout(() => Reveal.layout(), 300);
    }

    document.addEventListener('fullscreenchange', updateFullscreenUI);
    document.addEventListener('webkitfullscreenchange', updateFullscreenUI);
    document.addEventListener('mozfullscreenchange', updateFullscreenUI);
    document.addEventListener('MSFullscreenChange', updateFullscreenUI);

    function updateFullscreenUI() {
        const presentationContainer = document.getElementById('presentation-container');
        const isFullscreen = document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement;
        if (!isFullscreen && presentationContainer.classList.contains('fullscreen-mode')) {
            presentationContainer.classList.remove('fullscreen-mode');
        }
        setTimeout(() => Reveal.layout(), 300);
    }
</script>
</body>
</html>