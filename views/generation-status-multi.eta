<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreestAIle - Generierungsstatus</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Ubuntu:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles/landing-page.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .status-container {
            max-width: 800px;
            margin: 2rem auto;
            padding: 2rem;
            background: #ffffff;
            border-radius: 15px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .status-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .status-header h1 {
            font-family: "Ubuntu", sans-serif;
            font-size: 2rem;
            color: #234567;
            margin-bottom: 0.5rem;
        }

        .status-header p {
            font-family: "Inter", sans-serif;
            color: #666;
            font-size: 1.1rem;
        }

        .presentation-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .presentation-card {
            background: #f8fafc;
            border-radius: 10px;
            padding: 1.5rem;
            transition: all 0.3s ease;
        }

        .presentation-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
        }

        .presentation-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .presentation-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #b1dae7;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Ubuntu", sans-serif;
            font-size: 24px;
            font-weight: 700;
            color: #234567;
        }

        .presentation-info {
            flex: 1;
        }

        .presentation-name {
            font-family: "Ubuntu", sans-serif;
            font-size: 18px;
            font-weight: 700;
            color: #234567;
            margin: 0;
        }

        .presentation-topic {
            font-family: "Inter", sans-serif;
            font-size: 14px;
            color: #666;
            margin-top: 0.25rem;
        }

        .status-indicator {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-top: 1rem;
            padding: 0.75rem;
            border-radius: 5px;
            font-family: "Inter", sans-serif;
            font-size: 14px;
            font-weight: 500;
        }

        .status-indicator.pending {
            background: #fff7ed;
            color: #c2410c;
        }

        .status-indicator.processing {
            background: #eff6ff;
            color: #1d4ed8;
        }

        .status-indicator.completed {
            background: #f0fdf4;
            color: #166534;
        }

        .status-indicator.error {
            background: #fef2f2;
            color: #b91c1c;
        }

        .loading-spinner {
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .progress-bar {
            width: 100%;
            height: 6px;
            background: #e2e8f0;
            border-radius: 3px;
            margin-top: 1rem;
            overflow: hidden;
        }

        .progress-bar-fill {
            height: 100%;
            background: #b1dae7;
            border-radius: 3px;
            transition: width 0.3s ease;
        }

        /* Darkmode Styles */
        body.darkmode .status-container {
            background: #2d2d2d;
        }

        body.darkmode .status-header h1 {
            color: #ffffff;
        }

        body.darkmode .status-header p {
            color: #a0aec0;
        }

        body.darkmode .presentation-card {
            background: #3d3d3d;
        }

        body.darkmode .presentation-name {
            color: #ffffff;
        }

        body.darkmode .presentation-topic {
            color: #a0aec0;
        }

        body.darkmode .status-indicator.pending {
            background: #431407;
            color: #fdba74;
        }

        body.darkmode .status-indicator.processing {
            background: #1e3a8a;
            color: #93c5fd;
        }

        body.darkmode .status-indicator.completed {
            background: #14532d;
            color: #86efac;
        }

        body.darkmode .status-indicator.error {
            background: #7f1d1d;
            color: #fca5a5;
        }

        body.darkmode .progress-bar {
            background: #4d4d4d;
        }

        body.darkmode .progress-bar-fill {
            background: #2d5a3f;
        }
    </style>
</head>
<body>
    <div class="status-container">
        <div class="status-header">
            <h1>Generierungsstatus</h1>
            <p>Wir erstellen deine Präsentationen...</p>
        </div>

        <div class="presentation-grid" id="presentationGrid">
            <!-- Präsentationskarten werden hier dynamisch eingefügt -->
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            const ids = urlParams.get('ids').split(',');
            
            // Initiale Präsentationskarten erstellen
            ids.forEach(id => {
                createPresentationCard(id);
            });

            // Status regelmäßig aktualisieren
            const checkInterval = setInterval(checkStatus, 2000);

            async function checkStatus() {
                try {
                    const response = await fetch(`/checkGenerationStatusMulti?ids=${ids.join(',')}`);
                    const statuses = await response.json();

                    let allCompleted = true;
                    let hasError = false;

                    statuses.forEach(({ id, status }) => {
                        updatePresentationCard(id, status);
                        
                        if (status.status === 'error') {
                            hasError = true;
                        }
                        if (status.status !== 'completed') {
                            allCompleted = false;
                        }
                    });

                    if (allCompleted || hasError) {
                        clearInterval(checkInterval);
                        if (allCompleted) {
                            // Weiterleitung zur Spielseite
                            window.location.href = '/game';
                        }
                    }
                } catch (error) {
                    console.error('Fehler beim Abrufen des Status:', error);
                }
            }

            function createPresentationCard(id) {
                const grid = document.getElementById('presentationGrid');
                const card = document.createElement('div');
                card.className = 'presentation-card';
                card.id = `card-${id}`;
                card.innerHTML = `
                    <div class="presentation-header">
                        <div class="presentation-avatar">?</div>
                        <div class="presentation-info">
                            <h3 class="presentation-name">Wird geladen...</h3>
                            <p class="presentation-topic">Wird geladen...</p>
                        </div>
                    </div>
                    <div class="status-indicator pending">
                        <div class="loading-spinner"></div>
                        <span>Wird initialisiert...</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-bar-fill" style="width: 0%"></div>
                    </div>
                `;
                grid.appendChild(card);
            }

            function updatePresentationCard(id, status) {
                const card = document.getElementById(`card-${id}`);
                if (!card) return;

                const statusIndicator = card.querySelector('.status-indicator');
                const progressBar = card.querySelector('.progress-bar-fill');
                const nameElement = card.querySelector('.presentation-name');
                const topicElement = card.querySelector('.presentation-topic');
                const avatarElement = card.querySelector('.presentation-avatar');

                // Status-Indikator aktualisieren
                statusIndicator.className = `status-indicator ${status.status}`;
                
                switch (status.status) {
                    case 'pending':
                        statusIndicator.innerHTML = `
                            <div class="loading-spinner"></div>
                            <span>Wird initialisiert...</span>
                        `;
                        progressBar.style.width = '0%';
                        break;
                    case 'processing':
                        statusIndicator.innerHTML = `
                            <div class="loading-spinner"></div>
                            <span>Wird generiert...</span>
                        `;
                        progressBar.style.width = '50%';
                        break;
                    case 'completed':
                        statusIndicator.innerHTML = `
                            <i class="fas fa-check"></i>
                            <span>Fertig!</span>
                        `;
                        progressBar.style.width = '100%';
                        break;
                    case 'error':
                        statusIndicator.innerHTML = `
                            <i class="fas fa-exclamation-circle"></i>
                            <span>${status.message || 'Fehler bei der Generierung'}</span>
                        `;
                        progressBar.style.width = '0%';
                        break;
                }

                // Präsentationsdetails aktualisieren
                if (status.player) {
                    nameElement.textContent = status.player;
                    avatarElement.textContent = status.player.charAt(0).toUpperCase();
                }
                if (status.topic) {
                    topicElement.textContent = status.topic;
                }
            }
        });
    </script>
</body>
</html> 